---
import Layout from "~/layouts/Layout.astro";
import Logo from "~/components/Logo.astro";

// In dev (DEV=1) we point at the local Loco backend on port 5150.
// In prod the form posts cross-subdomain to app.ollasuper.com/auth/login,
// which sets a cookie scoped to .ollasuper.com and 303s back to /.
const APP_BASE = import.meta.env.PUBLIC_APP_BASE ?? "https://app.ollasuper.com";
---
<Layout current="" chrome={false} title="Sign in to OllaSuper">
  <section class="os-grid-2" style="min-height: 100vh; gap: 0;">

    {/* Left — form */}
    <div style="display: flex; flex-direction: column; padding: var(--spacing-32) var(--spacing-48); min-height: 100vh;">
      <a href="/" style="display: inline-flex; align-items: center;">
        <Logo size={28} wordmark={true} />
      </a>

      <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; max-width: 380px;">
        <div class="os-eyebrow">SIGN IN</div>
        <h1 class="os-h2" style="margin-top: var(--spacing-12);">Welcome back.</h1>
        <p class="os-lead" style="margin-top: var(--spacing-8);">Pick up where you left off.</p>

        <form method="post" action={`${APP_BASE}/auth/login`} style="margin-top: var(--spacing-24);">
          <div style="margin-bottom: var(--spacing-16);">
            <label for="email" class="os-caption" style="display: block; color: var(--ink-secondary); font-weight: 700; margin-bottom: 6px;">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email"
                   style="width: 100%; padding: 12px 14px; border: 1px solid var(--border-medium); border-radius: 8px; background: #ffffff; font-family: inherit; font-size: 14px;">
          </div>
          <div style="margin-bottom: var(--spacing-20);">
            <label for="password" class="os-caption" style="display: block; color: var(--ink-secondary); font-weight: 700; margin-bottom: 6px;">Password</label>
            <input id="password" name="password" type="password" required autocomplete="current-password"
                   style="width: 100%; padding: 12px 14px; border: 1px solid var(--border-medium); border-radius: 8px; background: #ffffff; font-family: inherit; font-size: 14px;">
          </div>
          <button type="submit" class="os-btn os-btn-primary" style="width: 100%; padding: 14px 22px; font-size: 15px; border-radius: 8px;">
            Sign in →
          </button>
        </form>

        <div class="os-small" style="margin-top: var(--spacing-16); color: var(--ink-secondary);">
          New to OllaSuper? <a href="/signup" style="color: var(--ink-black); font-weight: 700; border-bottom: 1px solid var(--ink-secondary);">Create an account</a>
        </div>
      </div>
    </div>

    {/* Right — editorial side */}
    <div style="background: var(--ink-black); color: #ffffff; padding: var(--spacing-48); display: flex; flex-direction: column; justify-content: space-between;">
      <span class="os-caption" style="font-family: var(--font-mono); color: rgba(255,255,255,0.5); letter-spacing: 0.08em; font-weight: 700;">OLLASUPER · 19 EXPERTS · ONE CHAT</span>
      <div>
        <p class="os-h1" style="color: #ffffff; max-width: 460px;">
          HR. Sales. Ops. SEO. AEO.<br/>
          <span style="color: var(--candy-pink);">Plus 14 more experts.</span>
        </p>
        <div style="margin-top: var(--spacing-24); padding: 14px 18px; background: rgba(255,255,255,0.06); border-radius: 8px; max-width: 460px;">
          <span style="color: var(--candy-pink);">✦</span>
          <span class="os-caption" style="font-family: var(--font-mono); color: rgba(255,255,255,0.7); letter-spacing: 0.04em; font-weight: 700;">76 STARTER PROMPTS · US BUSINESS ENGLISH · DPDP-ALIGNED</span>
        </div>
      </div>
      <div></div>
    </div>
  </section>
</Layout>
