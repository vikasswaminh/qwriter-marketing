---
import Layout from "~/layouts/Layout.astro";
---
<Layout current="" title="qwriter — AI copywriter that knows your customer">

  {/* HERO */}
  <section style="padding: 96px 32px 64px;">
    <div class="qw-section">
      <div class="qw-eyebrow qw-eyebrow-accent" style="margin-bottom: 18px;">· COPYWRITING · GROUNDED IN REAL CONTENT</div>
      <h1 class="qw-h-display" style="max-width: 940px;">
        Stop writing copy that <span style="font-style: italic; color: var(--accent);">could be anyone's</span>.
        <br />
        Ground it in your customer's site.
      </h1>
      <p class="qw-body" style="max-width: 640px; margin-top: 24px; font-size: 19px;">
        Paste a URL. <strong>qwriter</strong> crawls the page in under a second, extracts clean markdown + the
        on-page facts, and writes copy that actually references what's there. Same tools you've used.
        Different output.
      </p>
      <div style="display: flex; gap: 12px; margin-top: 32px;">
        <a href="/signup" style="display: inline-flex; align-items: center; gap: 8px; padding: 14px 22px; border-radius: 999px; background: var(--ink); color: var(--paper); font-weight: 500; font-size: 15px;">Start free — 5,000 words/mo →</a>
        <a href="/sources" style="display: inline-flex; align-items: center; gap: 8px; padding: 14px 22px; border-radius: 999px; border: 1px solid var(--ink); color: var(--ink); font-weight: 500; font-size: 15px;">How grounding works</a>
      </div>
      <div class="qw-mono" style="margin-top: 20px; font-size: 12px; color: var(--ink-3); letter-spacing: 0.08em;">
        NO CARD · 200K PAGES/DAY · BACKED BY CRAWLCRAWL.COM
      </div>
    </div>
  </section>

  {/* MARQUEE STRIP */}
  <div class="qw-marquee">
    <span>· EDITORIAL TYPE</span>
    <span>· CRAWLCRAWL.COM SCANS</span>
    <span>· OPENAI GPT-4o</span>
    <span>· TRIX EDITOR</span>
    <span>· TURBO + STIMULUS</span>
    <span>· 100% RUST BACKEND</span>
    <span>· COOKIE AUTH</span>
  </div>

  {/* BIG PRODUCT SHOT — placeholder card */}
  <section style="padding: 80px 32px;">
    <div class="qw-section">
      <div style="background: var(--white); border: 1px solid var(--rule); border-radius: 16px; padding: 12px; box-shadow: 0 32px 80px rgba(20,17,13,0.08);">
        <div style="background: var(--bone); border-radius: 10px; padding: 32px 36px; min-height: 480px;">
          <div class="qw-mono" style="font-size: 11px; color: var(--ink-3); letter-spacing: 0.08em; margin-bottom: 24px;">/ DOCUMENTS / Q4-LAUNCH / HERO ROSE BALM</div>
          <h2 class="qw-h-2" style="margin-bottom: 18px;">The rose balm that took us four years to perfect.</h2>
          <p class="qw-body" style="max-width: 720px;">
            Studio Birch began as a kitchen experiment in Reykjavík. Our cold-pressed
            Anatolian rose hip oil is sourced from a single co-op. 200 jars a batch.
          </p>
          <div style="margin-top: 36px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;">
            <div style="background: var(--white); padding: 16px; border-radius: 8px; border: 1px solid var(--rule);">
              <div class="qw-mono" style="font-size: 10px; color: var(--ink-3); letter-spacing: 0.1em;">VARIANT 01 · 142W</div>
              <div style="margin-top: 8px; font-size: 14px; font-weight: 500;">The rose balm that took us four years…</div>
            </div>
            <div style="background: var(--white); padding: 16px; border-radius: 8px; border: 1px solid var(--rule);">
              <div class="qw-mono" style="font-size: 10px; color: var(--ink-3); letter-spacing: 0.1em;">VARIANT 02 · 96W</div>
              <div style="margin-top: 8px; font-size: 14px; font-weight: 500;">Four years. One jar. Same formula, new face.</div>
            </div>
            <div style="background: var(--ink); color: var(--paper); padding: 16px; border-radius: 8px; position: relative;">
              <div style="position: absolute; top: -8px; left: 12px; background: var(--accent); padding: 2px 8px; border-radius: 4px; font-size: 9px; font-weight: 600; letter-spacing: 0.1em;">PICKED</div>
              <div class="qw-mono" style="font-size: 10px; color: rgba(250,247,242,0.6); letter-spacing: 0.1em;">VARIANT 03 · 108W</div>
              <div style="margin-top: 8px; font-size: 14px; font-weight: 500;">We rebuilt the jar. We left the formula alone.</div>
            </div>
          </div>
          <div style="margin-top: 24px; padding: 12px 14px; background: var(--ink); color: var(--paper); border-radius: 8px; display: flex; align-items: center; gap: 10px; font-size: 12px;">
            <span style="color: var(--accent);">✦</span>
            Grounded in <strong>studiobirch.com</strong> + 2 pages · <span class="qw-mono" style="color: rgba(250,247,242,0.7);">3 SOURCES · 4.2KB MD · 32 FACTS DETECTED · GPT-4o</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* THREE-COLUMN BENEFIT */}
  <section style="padding: 80px 32px;">
    <div class="qw-section">
      <div class="qw-eyebrow qw-eyebrow-accent">· WHAT MAKES IT DIFFERENT</div>
      <h2 class="qw-h-1" style="margin-top: 12px; max-width: 760px;">
        Most AI writers <em>guess</em>. <span style="color: var(--ink-3);">qwriter starts from what's already true on your customer's site.</span>
      </h2>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 56px;">
        <div>
          <div style="font-size: 56px; font-weight: 600; color: var(--accent); letter-spacing: -0.04em;">01.</div>
          <h3 class="qw-h-2" style="margin-top: 8px;">Sub-second scans.</h3>
          <p style="margin-top: 8px; color: var(--ink-3); font-size: 15px; line-height: 1.55;">
            Paste a URL. crawlcrawl.com pulls the page and returns clean markdown + JSON-LD + OG tags in ~600 ms.
            We keep the extracted text per project.
          </p>
        </div>
        <div>
          <div style="font-size: 56px; font-weight: 600; color: var(--accent); letter-spacing: -0.04em;">02.</div>
          <h3 class="qw-h-2" style="margin-top: 8px;">Pick what to ground in.</h3>
          <p style="margin-top: 8px; color: var(--ink-3); font-size: 15px; line-height: 1.55;">
            Check the pages you want this generation to reference. Every variant arrives with a footer telling
            you exactly which sources contributed.
          </p>
        </div>
        <div>
          <div style="font-size: 56px; font-weight: 600; color: var(--accent); letter-spacing: -0.04em;">03.</div>
          <h3 class="qw-h-2" style="margin-top: 8px;">3-6 variants per click.</h3>
          <p style="margin-top: 8px; color: var(--ink-3); font-size: 15px; line-height: 1.55;">
            Compare side-by-side. Pick one. Use it in the editor — Trix-based, autosaves every 700 ms,
            exports to .md / .pdf / .txt.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* CTA FOOTER */}
  <section style="padding: 96px 32px;">
    <div class="qw-section" style="text-align: center;">
      <h2 class="qw-h-display" style="max-width: 800px; margin: 0 auto;">
        Try it on your <em style="color: var(--accent);">own site</em>.
      </h2>
      <p class="qw-body" style="max-width: 540px; margin: 18px auto 0; font-size: 18px;">
        5,000 words/month free. No card. Watch what changes when the model knows where you've been.
      </p>
      <div style="margin-top: 32px;">
        <a href="/signup" style="display: inline-flex; align-items: center; padding: 16px 28px; border-radius: 999px; background: var(--ink); color: var(--paper); font-weight: 500; font-size: 15px;">
          Start writing — free →
        </a>
      </div>
    </div>
  </section>

</Layout>
