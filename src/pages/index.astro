---
import Layout from "~/layouts/Layout.astro";
import HeroLiveInterface from "~/components/hero/HeroLiveInterface.astro";
import EmployeeShowcase from "~/components/ai-employees/EmployeeShowcase.astro";
import InteractiveWorkflowDemo from "~/components/workflows/InteractiveWorkflowDemo.astro";
import PlatformBento from "~/components/platform/PlatformBento.astro";
import TraceVisualizer from "~/components/observability/TraceVisualizer.astro";
import HumanInTheLoopCard from "~/components/governance/HumanInTheLoopCard.astro";
import RoiCalculator from "~/components/outcomes/RoiCalculator.astro";
---

<Layout 
  title="OllaSuper — Your company. Powered by AI employees."
  description="Deploy intelligent AI employees that research, analyze, execute and automate real business workflows with enterprise observability and human governance."
  current="home"
>

  {/* ─── 1. HERO SECTION ─── */}
  <section class="os-section" style="padding: 64px 0 48px; position: relative; overflow: hidden; background: linear-gradient(180deg, var(--warm-cream) 0%, #fffbf2 100%);">
    
    {/* Subtle Glow Backdrop */}
    <div style="position: absolute; top: -10%; left: 50%; transform: translateX(-50%); width: 800px; height: 400px; background: radial-gradient(circle, rgba(255, 131, 218, 0.12) 0%, rgba(255, 252, 246, 0) 70%); pointer-events: none; z-index: 0;"></div>

    <div class="os-container-wide" style="position: relative; z-index: 1;">
      <div style="display: flex; flex-direction: column; align-items: center; text-align: center; max-width: 800px; margin: 0 auto;">
        
        {/* Value Proposition & CTAs */}
        <div class="os-eyebrow" style="margin-bottom: var(--spacing-24);">
          <span class="os-badge" style="background: var(--candy-pink); color: var(--ink-black); font-size: var(--text-caption); padding: 4px 12px; border-radius: var(--radius-pill); font-weight: 700;">
            <span class="os-live-dot"></span> AI Workforce Platform
          </span>
          <span class="os-caption">Production-Ready 2026</span>
        </div>

        <h1 class="os-display" style="margin-bottom: var(--spacing-24);">
          Build Your AI Workforce.
        </h1>

        <p class="os-lead" style="margin-bottom: var(--spacing-48); max-width: 640px;">
          <strong style="font-weight: 700; color: var(--ink-black);">80 Experts</strong> that advise across Sales, HR, SEO, Legal, Finance and 25 more — plus <strong style="font-weight: 700; color: var(--ink-black);">6 Agents</strong> that run on schedules and take real actions with your approval.
        </p>

        {/* Primary Action Buttons */}
        <div style="display: flex; gap: 16px; align-items: center; justify-content: center; flex-wrap: wrap; margin-bottom: 32px;">
          <a href="/signup" class="os-btn os-btn-primary" style="padding: 14px 28px; font-size: 15px;">
            Build Your AI Workforce →
          </a>
          <a href="#employees" class="os-btn os-btn-secondary" style="padding: 14px 24px; font-size: 15px;">
            Explore AI Employees
          </a>
          <a href="/demo" class="os-btn os-btn-ghost" style="padding: 14px 20px; font-size: 15px; font-weight: 600;">
            Book a Demo
          </a>
        </div>

        {/* Trust Highlights Strip */}
        <div style="display: flex; gap: 24px; align-items: center; justify-content: center; font-size: 13px; color: var(--ink-secondary); flex-wrap: wrap;">
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="color: var(--status-green); font-weight: 700;">✓</span>
            <span>No credit card</span>
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="color: var(--status-green); font-weight: 700;">✓</span>
            <span>Enterprise ready</span>
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="color: var(--status-green); font-weight: 700;">✓</span>
            <span>Multi-agent collaboration</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* ─── 2. METRICS STRIP ─── */}
  <section class="os-section-light" style="padding: 24px 0; border-top: 1px solid var(--candy-pink); border-bottom: 1px solid var(--candy-pink);">
    <div class="os-container">
      <div style="text-align: center; font-size: 0.75rem; color: var(--ink-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 24px;">
        Built for the next generation of operating teams
      </div>
      <div class="os-grid-4">
        <div style="text-align: center;">
          <div style="font-size: 2.25rem; font-weight: 800; color: var(--ink-black); line-height: 1;">30</div>
          <div style="font-size: 0.9rem; color: var(--ink-secondary); margin-top: 6px;">AI specialists</div>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 2.25rem; font-weight: 800; color: var(--ink-black); line-height: 1;">9</div>
          <div style="font-size: 0.9rem; color: var(--ink-secondary); margin-top: 6px;">Departments covered</div>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 2.25rem; font-weight: 800; color: var(--ink-black); line-height: 1;">120+</div>
          <div style="font-size: 0.9rem; color: var(--ink-secondary); margin-top: 6px;">Output types</div>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 2.25rem; font-weight: 800; color: var(--ink-black); line-height: 1;">1.2M</div>
          <div style="font-size: 0.9rem; color: var(--ink-secondary); margin-top: 6px;">Tasks completed weekly</div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── 3. AI EMPLOYEES SHOWCASE ─── */}
  <EmployeeShowcase />

  {/* ─── 4. WHAT YOU CAN SHIP ─── */}
  <section class="os-section" style="padding: 100px 0; background: #ffffff; border-top: 1px solid var(--border-light); border-bottom: 1px solid var(--border-light);">
    <div class="os-container">
      
      <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: var(--spacing-48); gap: var(--spacing-24); flex-wrap: wrap;">
        <div>
          <div class="os-eyebrow">
            WHAT YOU CAN SHIP
          </div>
          <h2 class="os-h2" style="margin: 0; max-width: 720px;">
            Hire one Assistant. Or stand up your whole workforce.
          </h2>
        </div>
        <a href="/experts" style="font-size: var(--text-small); font-weight: 600; color: var(--ink-secondary); text-decoration: none; padding-bottom: 4px; border-bottom: 1px solid var(--ink-black);">Browse all 30 →</a>
      </div>

      <div class="os-grid-4">
        
        <a href="/experts" class="os-card os-card-cream os-card-symmetric" style="border: 1px solid var(--border-medium); text-decoration: none; color: inherit; display: flex; flex-direction: column;">
          <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
            <img src="/images/cards/assistants.jpg" alt="22 Assistants" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="flex: 1;">
            <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">22 Assistants</h3>
            <p class="os-small" style="margin-bottom: var(--spacing-24);">
              Chat-driven specialists across 6 departments.
            </p>
          </div>
          <div style="font-size: var(--text-caption); font-weight: 700; color: #16a34a;">Learn more →</div>
        </a>

        <a href="/agents" class="os-card os-card-cream os-card-symmetric" style="border: 1px solid var(--border-medium); text-decoration: none; color: inherit; display: flex; flex-direction: column;">
          <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
            <img src="/images/cards/agents.jpg" alt="6 Agents" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="flex: 1;">
            <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">6 Agents</h3>
            <p class="os-small" style="margin-bottom: var(--spacing-24);">
              Run on a cadence. Take real actions with approval gates.
            </p>
          </div>
          <div style="font-size: var(--text-caption); font-weight: 700; color: #d97706;">Learn more →</div>
        </a>

        <a href="#workflow" class="os-card os-card-cream os-card-symmetric" style="border: 1px solid var(--border-medium); text-decoration: none; color: inherit; display: flex; flex-direction: column;">
          <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
            <img src="/images/cards/handoff.jpg" alt="Multi-agent handoff" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="flex: 1;">
            <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">Multi-agent handoff</h3>
            <p class="os-small" style="margin-bottom: var(--spacing-24);">
              Specialists pass work to other specialists, end-to-end.
            </p>
          </div>
          <div style="font-size: var(--text-caption); font-weight: 700; color: #0066ff;">Learn more →</div>
        </a>

        <a href="/experts" class="os-card os-card-cream os-card-symmetric" style="border: 1px solid var(--border-medium); text-decoration: none; color: inherit; display: flex; flex-direction: column;">
          <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
            <img src="/images/cards/seo.jpg" alt="SEO + AEO audits" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="flex: 1;">
            <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">SEO + AEO audits</h3>
            <p class="os-small" style="margin-bottom: var(--spacing-24);">
              Crawl any URL, score on 40 signals, return a fix list.
            </p>
          </div>
          <div style="font-size: var(--text-caption); font-weight: 700; color: #2c8d5e;">Learn more →</div>
        </a>

        <a href="/experts" class="os-card os-card-cream os-card-symmetric" style="border: 1px solid var(--border-medium); text-decoration: none; color: inherit; display: flex; flex-direction: column;">
          <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
            <img src="/images/cards/sales.jpg" alt="Sales pipeline" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="flex: 1;">
            <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">Sales pipeline</h3>
            <p class="os-small" style="margin-bottom: var(--spacing-24);">
              Lead research, outbound drafts, CRM notes that stay tidy.
            </p>
          </div>
          <div style="font-size: var(--text-caption); font-weight: 700; color: #c0426a;">Learn more →</div>
        </a>

        <a href="/experts" class="os-card os-card-cream os-card-symmetric" style="border: 1px solid var(--border-medium); text-decoration: none; color: inherit; display: flex; flex-direction: column;">
          <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
            <img src="/images/cards/hr.jpg" alt="HR + recruiting" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="flex: 1;">
            <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">HR + recruiting</h3>
            <p class="os-small" style="margin-bottom: var(--spacing-24);">
              Drafted JDs, candidate screening, employee-handbook answers.
            </p>
          </div>
          <div style="font-size: var(--text-caption); font-weight: 700; color: #7150d4;">Learn more →</div>
        </a>

        <a href="/experts" class="os-card os-card-cream os-card-symmetric" style="border: 1px solid var(--border-medium); text-decoration: none; color: inherit; display: flex; flex-direction: column;">
          <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
            <img src="/images/cards/finance.jpg" alt="Finance + ops" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="flex: 1;">
            <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">Finance + ops</h3>
            <p class="os-small" style="margin-bottom: var(--spacing-24);">
              Forecasts, standup summaries, tickets that file themselves.
            </p>
          </div>
          <div style="font-size: var(--text-caption); font-weight: 700; color: #c2542f;">Learn more →</div>
        </a>

        <a href="/signup" class="os-card os-card-cream os-card-symmetric" style="border: 1px solid var(--border-medium); text-decoration: none; color: inherit; display: flex; flex-direction: column;">
          <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
            <img src="/images/cards/start.jpg" alt="Free to start" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="flex: 1;">
            <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">Free to start</h3>
            <p class="os-small" style="margin-bottom: var(--spacing-24);">
              50,000 credits a month. No card. No vendor lock-in.
            </p>
          </div>
          <div style="font-size: var(--text-caption); font-weight: 700; color: #16a34a;">Learn more →</div>
        </a>

      </div>

    </div>
  </section>

  {/* ─── 5. THE WORK THAT SHIPS ─── */}
  <section class="os-section" style="padding: 100px 0; background: var(--warm-cream);">
    <div class="os-container">
      
      <div class="os-section-header">
        <div class="os-eyebrow">
          WORK THEY DELIVER
        </div>
        <h2 class="os-h2">
          The work that ships.
        </h2>
        <p class="os-lead">
          Not summaries. Not drafts. The actual deliverables that go to boards, investors, customers and teams.
        </p>
      </div>

      <div class="os-grid-3" style="gap: 20px;">
        
        <a href="/experts/ir" class="os-card os-card-symmetric" style="background: #ffffff; border: 1px solid var(--border-medium); text-decoration: none; position: relative; overflow: hidden; display: flex; flex-direction: column;">
          <div style="position: absolute; left: 0; top: 20px; bottom: 20px; width: 3px; background: #d97706; border-radius: 0 2px 2px 0;"></div>
          <div style="flex: 1;">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px;">
              <span style="font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; color: #d97706; text-transform: uppercase;">INVESTOR UPDATE</span>
              <span style="font-size: 11px; color: var(--ink-secondary);">by <strong style="color: var(--ink-black); font-weight: 700;">Investor Relations</strong></span>
            </div>
            <h3 style="margin: 0 0 10px 0; font-weight: 700; font-size: 17px; letter-spacing: -0.015em; line-height: 1.25; color: var(--ink-black);">October Investor Update</h3>
            <div style="padding: 14px 16px; background: var(--bg-cream-alt); border: 1px solid var(--border-light); border-radius: 8px; font-size: 12.5px; line-height: 1.55; color: var(--ink-secondary);">
              <strong>Highlights.</strong> ARR up 22% MoM to $4.6M. Net new logos: 84. Hired Anjali as VP Product (ex-Razorpay). <br/><br/><strong>Asks.</strong> Intros for VP Sales hire (former CRO, 500-2K SaaS).
            </div>
          </div>
          <div style="margin-top: 14px; font-size: 12px; font-weight: 600; color: #d97706;">See sample →</div>
        </a>

        <a href="/experts/cos" class="os-card os-card-symmetric" style="background: #ffffff; border: 1px solid var(--border-medium); text-decoration: none; position: relative; overflow: hidden; display: flex; flex-direction: column;">
          <div style="position: absolute; left: 0; top: 20px; bottom: 20px; width: 3px; background: #7c3aed; border-radius: 0 2px 2px 0;"></div>
          <div style="flex: 1;">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px;">
              <span style="font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; color: #7c3aed; text-transform: uppercase;">BOARD REPORT</span>
              <span style="font-size: 11px; color: var(--ink-secondary);">by <strong style="color: var(--ink-black); font-weight: 700;">Chief of Staff</strong></span>
            </div>
            <h3 style="margin: 0 0 10px 0; font-weight: 700; font-size: 17px; letter-spacing: -0.015em; line-height: 1.25; color: var(--ink-black);">Q3 Board Pre-Read</h3>
            <div style="padding: 14px 16px; background: var(--bg-cream-alt); border: 1px solid var(--border-light); border-radius: 8px; font-size: 12.5px; line-height: 1.55; color: var(--ink-secondary);">
              Q3 vs Q2: revenue +28%, NRR 118%, customer count +12. <br/><br/><strong>Strategic decisions to surface:</strong> AI infra build vs buy, EU expansion timing, follow-on equity plan.
            </div>
          </div>
          <div style="margin-top: 14px; font-size: 12px; font-weight: 600; color: #7c3aed;">See sample →</div>
        </a>

        <a href="/experts/sdr" class="os-card os-card-symmetric" style="background: #ffffff; border: 1px solid var(--border-medium); text-decoration: none; position: relative; overflow: hidden; display: flex; flex-direction: column;">
          <div style="position: absolute; left: 0; top: 20px; bottom: 20px; width: 3px; background: #16a34a; border-radius: 0 2px 2px 0;"></div>
          <div style="flex: 1;">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px;">
              <span style="font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; color: #16a34a; text-transform: uppercase;">SALES CAMPAIGN</span>
              <span style="font-size: 11px; color: var(--ink-secondary);">by <strong style="color: var(--ink-black); font-weight: 700;">SDR Agent</strong></span>
            </div>
            <h3 style="margin: 0 0 10px 0; font-weight: 700; font-size: 17px; letter-spacing: -0.015em; line-height: 1.25; color: var(--ink-black);">23-touch ABM Sequence</h3>
            <div style="padding: 14px 16px; background: var(--bg-cream-alt); border: 1px solid var(--border-light); border-radius: 8px; font-size: 12.5px; line-height: 1.55; color: var(--ink-secondary);">
              Day 1 · Day 3 · Day 7 · Day 12 · Day 21. <br/><br/><strong>50 prospects.</strong> US Series A SaaS hiring SDRs. Each step: subject + 90-word body + LinkedIn voice note.
            </div>
          </div>
          <div style="margin-top: 14px; font-size: 12px; font-weight: 600; color: #16a34a;">See sample →</div>
        </a>

      </div>

    </div>
  </section>

  {/* ─── 6. LIVE WORKFLOW DEMONSTRATION ─── */}
  <InteractiveWorkflowDemo />

  {/* ─── 7. AI WORKFORCE PLATFORM BENTO GRID ─── */}
  <PlatformBento />

  {/* ─── 8. DEEP OBSERVABILITY & TRACE VISUALIZER ─── */}
  <TraceVisualizer />

  {/* ─── 9. HUMAN-IN-THE-LOOP CONTROL ─── */}
  <HumanInTheLoopCard />

  {/* ─── 10. ENTERPRISE TRUST & SECURITY ARCHITECTURE ─── */}
  <section class="os-section" style="padding: 100px 0; background: #ffffff; border-top: 1px solid var(--border-light); border-bottom: 1px solid var(--border-light);">
    <div class="os-container">
      
      <div class="os-section-header">
        <div class="os-eyebrow">
          ENTERPRISE TRUST & SECURITY
        </div>
        <h2 class="os-h2">
          Secure by default. Built for scale.
        </h2>
        <p class="os-lead">
          Deploy your AI workforce with confidence. OllaSuper provides zero-data-retention sandboxes and cryptographic security guarantees.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
        
        <div class="os-card os-card-cream" style="border: 1px solid var(--border-medium);">
          <div style="font-size: 24px; margin-bottom: 14px;">🔒</div>
          <h3 style="font-size: 17px; font-weight: 700; color: var(--ink-black); margin-bottom: 8px;">Zero Data Retention</h3>
          <p style="font-size: 13px; color: var(--ink-secondary); line-height: 1.5;">
            Customer prompts, internal data, and API payloads are never stored beyond task runtime, and are never used to train foundation models.
          </p>
        </div>

        <div class="os-card os-card-cream" style="border: 1px solid var(--border-medium);">
          <div style="font-size: 24px; margin-bottom: 14px;">🛡️</div>
          <h3 style="font-size: 17px; font-weight: 700; color: var(--ink-black); margin-bottom: 8px;">SOC2 Type II & HIPAA Ready</h3>
          <p style="font-size: 13px; color: var(--ink-secondary); line-height: 1.5;">
            Independently audited controls across encryption at rest (AES-256), in-transit (TLS 1.3), and continuous vulnerability monitoring.
          </p>
        </div>

        <div class="os-card os-card-cream" style="border: 1px solid var(--border-medium);">
          <div style="font-size: 24px; margin-bottom: 14px;">📦</div>
          <h3 style="font-size: 17px; font-weight: 700; color: var(--ink-black); margin-bottom: 8px;">Sandboxed Tool Execution</h3>
          <p style="font-size: 13px; color: var(--ink-secondary); line-height: 1.5;">
            All MCP tool calls run in isolated gVisor container environments with strict egress network policies and zero-host access.
          </p>
        </div>

      </div>

    </div>
  </section>

  {/* ─── 11. QUANTIFIED BUSINESS OUTCOMES & ROI CALCULATOR ─── */}
  <RoiCalculator />

  {/* ─── 12. VERIFIED CASE STUDY & TESTIMONIAL ─── */}
  <section class="os-section" style="padding: 100px 0; background: var(--warm-cream);">
    <div class="os-container">
      <div style="max-width: 900px; margin: 0 auto; background: #ffffff; border: 1px solid var(--border-medium); border-radius: var(--radius-xl); padding: 48px; box-shadow: var(--shadow-md);">
        
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
          <span class="os-badge os-badge-green">Verified Case Study</span>
          <span style="font-size: 13px; font-weight: 700; color: var(--ink-black);">Rampify Global</span>
        </div>

        <blockquote style="font-size: 22px; font-weight: 600; line-height: 1.4; color: var(--ink-black); margin-bottom: 28px; letter-spacing: -0.02em;">
          "OllaSuper’s Sales and Research employees generate 45% of our qualified pipeline each month. Our Account Executives now spend 90% of their time on live customer conversations rather than manual scraping and CRM hygiene."
        </blockquote>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; border-top: 1px solid var(--border-light); padding-top: 20px;">
          <div>
            <div style="font-weight: 700; color: var(--ink-black);">Elena Rostova</div>
            <div style="font-size: 13px; color: var(--ink-muted);">VP of Global Revenue, Rampify</div>
          </div>
          <div style="text-align: right;">
            <div style="font-size: 20px; font-weight: 800; color: var(--status-green);">+$3.4M ARR</div>
            <div style="font-size: 12px; color: var(--ink-muted);">Generated in 6 Months</div>
          </div>
        </div>

      </div>
    </div>
