---
import Layout from "~/layouts/Layout.astro";
import OllaSuperChatLoop from "~/components/OllaSuperChatLoop.astro";
import OutputCard from "~/components/OutputCard.astro";
import DepartmentTabs from "~/components/DepartmentTabs.astro";
import MultiAgentGraph from "~/components/MultiAgentGraph.astro";
import ExpertGlyph from "~/components/ExpertGlyph.astro";

const team = [
  { slug: "data",        name: "Research Agent",      role: "Market scans, A/B writeups, board MoM",      color: "#7c3aed" },
  { slug: "sales",       name: "Sales Agent",         role: "Outbound, pipeline, proposals",              color: "#16a34a" },
  { slug: "marketing",   name: "Marketing Agent",     role: "Posts, campaigns, case studies",             color: "#22c55e" },
  { slug: "hr",          name: "HR Agent",            role: "JDs, offers, reviews, exits",                color: "#ff6b4a" },
  { slug: "operations",  name: "Operations Agent",    role: "SOPs, RFPs, runbooks, change mgmt",          color: "#52525b" },
  { slug: "finance",     name: "Finance Agent",       role: "Reports, invoices, vendor mgmt",             color: "#475569" },
  { slug: "support",     name: "Support Agent",       role: "Tickets, escalations, refunds",              color: "#0d9488" },
  { slug: "engineering", name: "Engineering Agent",   role: "RFCs, post-mortems, code review",            color: "#0066ff" },
  { slug: "cos",         name: "Chief of Staff",      role: "Briefings, OKRs, all-hands",                 color: "#c2410c" },
];

const outputs = [
  { category: "INVESTOR UPDATE", color: "#d97706", title: "October Investor Update",  agent: "Investor Relations", href: "/experts/ir",
    body: "<strong>Highlights.</strong> ARR up 22% MoM to $4.6M. Net new logos: 84. Hired Anjali as VP Product (ex-Razorpay). <br/><strong>Asks.</strong> Intros for VP Sales hire (former CRO, 500-2K SaaS)." },
  { category: "BOARD REPORT", color: "#7c3aed", title: "Q3 Board Pre-Read",  agent: "Chief of Staff", href: "/experts/cos",
    body: "Q3 vs Q2: revenue +28%, NRR 118%, customer count +12. <strong>Strategic decisions to surface:</strong> AI infra build vs buy, EU expansion timing, follow-on equity plan." },
  { category: "SALES CAMPAIGN", color: "#16a34a", title: "23-touch ABM Sequence",  agent: "SDR Agent", href: "/experts/sdr",
    body: "Day 1 · Day 3 · Day 7 · Day 12 · Day 21. <strong>50 prospects.</strong> US Series A SaaS hiring SDRs. Each step: subject + 90-word body + LinkedIn voice note." },
  { category: "SEO AUDIT", color: "#10b981", title: "ollasuper.com SEO Audit",  agent: "SEO Agent", href: "/experts/seo",
    body: "<strong>Score: 64/100.</strong> Top 5 fixes: title-tag rewrites, missing FAQPage schema, 12 broken internal links, page-speed on /experts, 3 cannibalization fixes." },
  { category: "CONTENT BRIEF", color: "#0066ff", title: "AI for Sales Teams · 1,500w",  agent: "AEO Agent", href: "/experts/aeo",
    body: "<strong>Primary keyword:</strong> ai sales tools (KD 38). Outline · 8 H2s · 2,000 words · 5 internal links · Author byline + last-updated. Projected AEO lift: 47 → 78." },
  { category: "HIRING PLAN", color: "#ff6b4a", title: "Senior Engineer · Bengaluru JD",  agent: "HR Agent", href: "/experts/hr",
    body: "<strong>Role:</strong> Own one of four production services that move money for our 200+ B2B customers. <strong>Comp:</strong> ₹32–48 LPA + ESOPs. Hybrid (2 days/week)." },
  { category: "CS REVIEW", color: "#15803d", title: "ACME Co. Q3 QBR",  agent: "Customer Success", href: "/experts/cs",
    body: "Usage +60% YoY (4,200 → 6,720 monthly workflows). 8 teams adopted, up from 3. <strong>Proposal:</strong> upgrade to Unlimited tier — projected to exceed quota by Feb." },
  { category: "INCIDENT REPORT", color: "#1d4ed8", title: "P1 Postmortem · DB Failover",  agent: "DevOps", href: "/experts/devops",
    body: "<strong>4h 12m outage.</strong> Root cause: misconfigured health check after a deploy 3 weeks earlier. <strong>Actions:</strong> 7 items with owners + dates, integration test added." },
  { category: "PRD", color: "#4338ca", title: "Two-way Calendar Sync PRD",  agent: "Product", href: "/experts/product",
    body: "Problem: duplicate events on 38% of bookings — #1 support ticket category. <strong>Success metric:</strong> duplicate-event tickets down 80% in 60 days." },
  { category: "MARKET RESEARCH", color: "#ea580c", title: "HR-tech M&A Landscape",  agent: "M&A Agent", href: "/experts/ma",
    body: "<strong>Tier 1 strategics</strong> (Workday, SAP SF, Oracle Fusion HCM). <strong>EV/Rev comps</strong> at $50M ARR · 40% growth: 8–12x. Recommended outreach order." },
];

const departments = [
  {
    key: "sales", label: "Sales", color: "#16a34a",
    pitch: "From cold outbound to closed-won — without a 6-person SDR team.",
    agents: [
      { name: "SDR Agent",     role: "Sourcing, cadences, objection handling" },
      { name: "Sales Agent",   role: "Pipeline, proposals, renewal pitches" },
      { name: "CS Agent",      role: "QBRs, expansion, churn-saves" },
      { name: "Support Agent", role: "Triage, escalation, refund logic" },
    ],
    outputs: ["Outbound sequences", "Discovery scripts", "Proposal decks", "QBR documents", "Renewal pitches"],
  },
  {
    key: "marketing", label: "Marketing", color: "#22c55e",
    pitch: "Ship a full content engine without hiring an agency.",
    agents: [
      { name: "Marketing Agent",  role: "Posts, campaigns, case studies" },
      { name: "SEO Agent",        role: "Audits, briefs, on-page fixes" },
      { name: "AEO Agent",        role: "Get cited by AI search" },
      { name: "Content Writer",   role: "Long-form essays, voice match" },
    ],
    outputs: ["Blog posts + briefs", "LinkedIn essays", "Case studies", "Email campaigns", "Schema markup + AEO fixes"],
  },
  {
    key: "hr", label: "HR", color: "#ff6b4a",
    pitch: "Hire, onboard, review and offboard — at startup speed.",
    agents: [
      { name: "HR Agent",         role: "JDs, offers, reviews, exits" },
      { name: "Recruiter Agent",  role: "Sourcing, InMails, scorecards" },
      { name: "Career Agent",     role: "Promotion cases, salary asks" },
      { name: "CoS Agent",        role: "Skip-levels, calendar audits" },
    ],
    outputs: ["Job descriptions", "Offer letters + grade rubrics", "Performance review templates", "Interview scorecards", "Exit interview synthesis"],
  },
  {
    key: "ops", label: "Operations", color: "#52525b",
    pitch: "Procedures, vendors, audits — the office's quiet engine.",
    agents: [
      { name: "Operations Agent", role: "SOPs, RFPs, runbooks" },
      { name: "Finance Agent",    role: "AR, AP, vendor onboarding" },
      { name: "SOC 2 Agent",      role: "TSC mapping, evidence, gaps" },
      { name: "DevOps Agent",     role: "Incident response, SLOs" },
    ],
    outputs: ["SOPs", "RFPs + vendor evaluation memos", "Change-management RFCs", "Audit-readiness checklists", "Incident reports"],
  },
  {
    key: "finance", label: "Finance", color: "#475569",
    pitch: "Reports, models, tax — without the Big 4 invoice.",
    agents: [
      { name: "Finance Agent",  role: "AR, AP, board metrics" },
      { name: "Tax Agent",      role: "Federal, state, sales tax, R&D" },
      { name: "M&A Agent",      role: "Targets, comps, CIMs, DD" },
      { name: "IR Agent",       role: "Updates, decks, cap table" },
    ],
    outputs: ["MIS reports + variance commentary", "Sales-tax nexus analysis", "Investor updates + board narratives", "M&A target lists + CIMs", "Vendor onboarding"],
  },
  {
    key: "support", label: "Support", color: "#0d9488",
    pitch: "First responses to escalations to root-cause memos.",
    agents: [
      { name: "Support Agent",  role: "Triage, ack, escalation" },
      { name: "CS Agent",       role: "Onboarding, QBR, expansion" },
      { name: "Engineering",    role: "Bug triage, post-mortems" },
      { name: "Product Agent",  role: "PRDs, beta launches" },
    ],
    outputs: ["First-response templates", "Escalation replies", "Refund / credit decisions", "Bug acknowledgment scripts", "Post-incident summaries"],
  },
  {
    key: "engineering", label: "Engineering", color: "#0066ff",
    pitch: "RFCs, code reviews, post-mortems — at staff-engineer quality.",
    agents: [
      { name: "Engineering",    role: "RFCs, design docs, reviews" },
      { name: "DevOps Agent",   role: "Runbooks, SLOs, incidents" },
      { name: "Product Agent",  role: "PRDs, beta launches" },
      { name: "Designer Agent", role: "Crits, microcopy, audits" },
    ],
    outputs: ["Technical RFCs", "Code-review comments", "Architecture decision records", "Blameless post-mortems", "Design critiques"],
  },
  {
    key: "legal", label: "Legal", color: "#7f1d1d",
    pitch: "Contracts, compliance, IP — drafted to be signed, not negotiated for weeks.",
    agents: [
      { name: "Legal Agent",      role: "NDAs, MSAs, NOCs" },
      { name: "Litigation Agent", role: "Discovery, depo prep, motions" },
      { name: "HIPAA Agent",      role: "BAAs, risk assessments" },
      { name: "SEC Agent",        role: "S-1, 10-K, 10-Q, 8-K" },
    ],
    outputs: ["NDA + MSA drafts", "DPDP / GDPR notices", "BAA review and red-lines", "Litigation discovery protocols", "SEC filings"],
  },
  {
    key: "founder", label: "Founder Office", color: "#f59e0b",
    pitch: "Investor updates to all-hands scripts to the hard layoff email.",
    agents: [
      { name: "Founder Agent",  role: "Investor updates, vision" },
      { name: "CoS Agent",      role: "Briefings, OKRs, calendar" },
      { name: "IR Agent",       role: "Board decks, data room" },
      { name: "M&A Agent",      role: "Targets, comps, DD" },
    ],
    outputs: ["Monthly investor updates", "Board pre-reads + narratives", "All-hands scripts", "Strategic decision memos", "Press + PR comms"],
  },
];

const workflowSteps = [
  { n: "01", t: "Choose a specialist", d: "30 to choose from — Sales, HR, Finance, Engineering. Tap to assign." },
  { n: "02", t: "Add context",          d: "Drop a URL, upload a file, paste text, or connect a workspace." },
  { n: "03", t: "Ask naturally",        d: "Plain English. No prompt engineering. The specialist knows their role." },
  { n: "04", t: "Review the output",    d: "Edit inline, regenerate any block, or accept and ship." },
  { n: "05", t: "Ship the work",        d: "Export to MD · PDF · DOCX. Or paste straight into your tool." },
];

const collaborationAgents = [
  { short: "Sales",    color: "#16a34a" },
  { short: "Data",     color: "#7c3aed" },
  { short: "Finance",  color: "#475569" },
  { short: "Mkt",      color: "#22c55e" },
  { short: "HR",       color: "#ff6b4a" },
  { short: "CoS",      color: "#c2410c" },
];

const enterpriseCards = [
  { t: "Security",        d: "SOC 2 Type II ready. Per-workspace encryption. Audited controls.",                          icon: "🛡" },
  { t: "Compliance",      d: "GDPR, CCPA, HIPAA-ready. DPA on request. Data-residency options.",                            icon: "✓" },
  { t: "Privacy",         d: "Your data is never used to train any model — ours or any vendor's.",                          icon: "🔒" },
  { t: "Governance",      d: "Workspace-level policies, role-based access, granular permissions.",                          icon: "⚙" },
  { t: "Access Controls", d: "SSO via Okta / Azure AD. SCIM provisioning. Per-agent gating.",                               icon: "→" },
  { t: "Audit Logs",      d: "Every action, every output, every model call — exportable to your SIEM.",                     icon: "≡" },
];
---
<Layout
  current=""
  title="OllaSuper — 30 Experts that advise + 6 Agents that act"
  description="30 chat-driven Experts (Sales, HR, SEO, Legal, Finance and more) plus 6 production Agents that run on schedules and take real actions with approval gates. One platform. Both primitives."
>

  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  {/* 1 · HERO — 90vh · premium mesh + grain backdrop */}
  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  <section style="position: relative; min-height: 90vh; display: flex; align-items: center; overflow: hidden; padding: 96px 0 80px;">
    <div class="qw-mesh"></div>
    <div class="qw-grain"></div>

    <div class="qw-section" style="position: relative; z-index: 2; width: 100%;">
      {/* Centered hero — copy on top, chat preview centered below.
         Replaces the 2-col split that pushed the chat off to 77% of the viewport. */}
      <div style="text-align: center; max-width: 920px; margin: 0 auto;">
        <div class="qw-badge-premium" style="margin: 0 auto 28px;">
          <span class="dot"></span>
          AI Workforce Platform
        </div>

        <h1 class="qw-h-display" style="margin: 0 auto; max-width: 880px;">
          Build Your AI Workforce.
        </h1>

        <p style="margin: 24px auto 0; max-width: 680px; font-size: 18px; line-height: 1.55; color: var(--ink-3);">
          <span style="color: var(--ink); font-weight: 600;">30 Experts</span> that advise across Sales, HR, SEO, Legal, Finance and 25 more — plus <span style="color: var(--ink); font-weight: 600;">6 Agents</span> that run on schedules and take real actions with your approval.
        </p>
        <p style="margin: 8px auto 0; max-width: 600px; font-size: 13px; line-height: 1.5; color: var(--ink-3);">
          <a href="/experts" style="color: var(--ink-2); text-decoration: underline; text-decoration-color: var(--rule);">○ Browse the 30 Experts →</a>
          &nbsp;&nbsp;
          <a href="/agents" style="color: var(--ink-2); text-decoration: underline; text-decoration-color: var(--rule);">⚡ Meet the 6 Agents →</a>
        </p>

        <div style="display: flex; gap: 12px; margin-top: 32px; flex-wrap: wrap; justify-content: center;">
          <a href="/signup" class="qw-btn premium qw-btn-block-mobile" style="padding: 14px 26px; font-size: 14.5px;">Start Free →</a>
          <a href="#workflow" class="qw-btn ghost-premium qw-btn-block-mobile" style="padding: 14px 26px; font-size: 14.5px;">Watch Demo</a>
        </div>

        <div style="display: inline-flex; gap: 22px; margin-top: 30px; flex-wrap: wrap; align-items: center; font-size: 12.5px; color: var(--ink-3); justify-content: center;">
          <span style="display: inline-flex; align-items: center; gap: 6px;">
            <span style="color: var(--sage); font-weight: 700;">✓</span> No credit card
          </span>
          <span style="display: inline-flex; align-items: center; gap: 6px;">
            <span style="color: var(--sage); font-weight: 700;">✓</span> Enterprise ready
          </span>
          <span style="display: inline-flex; align-items: center; gap: 6px;">
            <span style="color: var(--sage); font-weight: 700;">✓</span> Multi-agent collaboration
          </span>
        </div>
      </div>

      {/* Chat preview — centered below the headline */}
      <div style="margin-top: 64px; display: flex; align-items: center; justify-content: center;">
        <OllaSuperChatLoop />
      </div>
    </div>
  </section>

  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  {/* 2 · SOCIAL PROOF */}
  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  <section style="border-top: 1px solid var(--rule-soft); border-bottom: 1px solid var(--rule-soft); background: var(--paper);">
    <div class="qw-section" style="padding: 32px 0;">
      <div style="text-align: center; font-size: 12px; color: var(--ink-3); margin-bottom: 24px; font-weight: 500;">
        Built for the next generation of operating teams
      </div>

      <div class="qw-grid-4" style="gap: 32px;">
        {[
          { v: "30",         l: "AI specialists" },
          { v: "9",          l: "Departments covered" },
          { v: "120+",       l: "Output types" },
          { v: "1.2M",       l: "Tasks completed weekly" },
        ].map(s => (
          <div style="text-align: center;">
            <div style="font-size: clamp(34px, 4vw, 48px); font-weight: 700; letter-spacing: -0.03em; color: var(--ink); line-height: 1;">{s.v}</div>
            <div style="margin-top: 6px; font-size: 12.5px; color: var(--ink-3);">{s.l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  {/* 3 · MEET YOUR AI TEAM */}
  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  <section style="padding: 96px 0 80px;">
    <div class="qw-section">
      <div style="max-width: 720px;">
        <div class="qw-eyebrow qw-eyebrow-accent">Your AI Team</div>
        <h2 class="qw-h-display" style="margin-top: 14px; font-size: clamp(36px, 4.6vw, 64px);">
          Meet Your<br/>AI Team.
        </h2>
        <p style="margin-top: 22px; font-size: 17px; line-height: 1.55; color: var(--ink-3); max-width: 540px;">
          Not chatbots. Specialists. Each one with their own role, voice, and tools — ready to ship real work from day one.
        </p>
      </div>

      <div class="qw-grid-3" style="margin-top: 48px; gap: 20px;">
        {team.map(t => (
          <a href={`/experts/${t.slug}`} class="qw-card-premium" style="display: flex; gap: 18px; padding: 24px; color: var(--ink); align-items: center;">
            <div style="flex: 0 0 64px;">
              <ExpertGlyph slug={t.slug} color={t.color} size={64} flat={true} />
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style={`width: 8px; height: 8px; border-radius: 999px; background: ${t.color};`}></span>
                <span style="font-weight: 700; font-size: 15px; letter-spacing: -0.012em; color: var(--ink);">{t.name}</span>
              </div>
              <div style="margin-top: 6px; font-size: 13px; color: var(--ink-3); line-height: 1.5;">{t.role}</div>
            </div>
          </a>
        ))}
      </div>

      <div style="margin-top: 28px; text-align: center;">
        <a href="/experts" style="display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: var(--accent);">
          See all 30 specialists →
        </a>
      </div>
    </div>
  </section>

  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  {/* 4 · WORK THEY DELIVER  ← MOST IMPORTANT */}
  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  <section style="background: var(--bg-elev); border-top: 1px solid var(--rule-soft); border-bottom: 1px solid var(--rule-soft); padding: 96px 0;">
    <div class="qw-section">
      <div style="max-width: 720px;">
        <div class="qw-eyebrow qw-eyebrow-accent">Work They Deliver</div>
        <h2 class="qw-h-display" style="margin-top: 14px; font-size: clamp(36px, 4.6vw, 64px);">
          The work that ships.
        </h2>
        <p style="margin-top: 22px; font-size: 17px; line-height: 1.55; color: var(--ink-3); max-width: 580px;">
          Not summaries. Not drafts. The actual deliverables that go to boards, investors, customers and teams.
        </p>
      </div>

      <div class="qw-grid-3" style="margin-top: 48px; gap: 20px;">
        {outputs.slice(0, 6).map(o => (
          <OutputCard {...o} />
        ))}
      </div>

      <div class="qw-grid-4" style="margin-top: 20px; gap: 20px;">
        {outputs.slice(6).map(o => (
          <OutputCard {...o} />
        ))}
      </div>
    </div>
  </section>

  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  {/* 5 · HOW WORK GETS DONE */}
  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  <section id="workflow" style="padding: 96px 0;">
    <div class="qw-section">
      <div style="max-width: 720px;">
        <div class="qw-eyebrow qw-eyebrow-accent">How Work Gets Done</div>
        <h2 class="qw-h-display" style="margin-top: 14px; font-size: clamp(36px, 4.6vw, 64px);">
          From idea to shipped<br/>in five steps.
        </h2>
      </div>

      <div style="margin-top: 56px; position: relative;">
        {/* Connector line */}
        <div style="position: absolute; left: 0; right: 0; top: 28px; height: 2px; background: var(--rule-soft); z-index: 0;"></div>

        <div class="qw-grid-5" style="position: relative; z-index: 1; gap: 24px;">
          {workflowSteps.map((s, i) => (
            <div style="text-align: left;">
