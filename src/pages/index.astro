---
import Layout from "~/layouts/Layout.astro";
import HeroLiveInterface from "~/components/hero/HeroLiveInterface.astro";
import EmployeeShowcase from "~/components/ai-employees/EmployeeShowcase.astro";
import InteractiveWorkflowDemo from "~/components/workflows/InteractiveWorkflowDemo.astro";
import PlatformBento from "~/components/platform/PlatformBento.astro";
import TraceVisualizer from "~/components/observability/TraceVisualizer.astro";
import HumanInTheLoopCard from "~/components/governance/HumanInTheLoopCard.astro";
import RoiCalculator from "~/components/outcomes/RoiCalculator.astro";
import HowItWorks from "~/components/home/HowItWorks.astro";
import PlatformOverview from "~/components/home/PlatformOverview.astro";
import TrustFooter from "~/components/home/TrustFooter.astro";
import ParticleSwarm from "~/components/home/ParticleSwarm.astro";
---

<Layout 
  title="OllaSuper — Your company. Powered by AI employees."
  description="Deploy intelligent AI employees that research, analyze, execute and automate real business workflows with enterprise observability and human governance."
  current="home"
>

  {/* ─── 1. HERO SECTION ─── */}
  <section class="os-section" style="padding: 32px 0 48px; position: relative; overflow: hidden; background: linear-gradient(180deg, var(--warm-cream) 0%, #fffbf2 100%);">
    
    {/* Stripe-Style Particle Swarm */}
    <ParticleSwarm />

    <div class="os-container-wide" style="position: relative; z-index: 1;">
      <div style="display: flex; flex-direction: column; align-items: center; text-align: center; max-width: 860px; margin: 0 auto; padding-top: 48px;">
        
        {/* Value Proposition & CTAs */}
        <div class="os-eyebrow os-reveal" style="margin-bottom: var(--spacing-24);">
          <span class="os-badge" style="background: var(--candy-pink); color: var(--ink-black); font-size: var(--text-caption); padding: 4px 12px; border-radius: var(--radius-pill); font-weight: 700;">
            <span class="os-live-dot"></span> AI Workforce Platform
          </span>
          <span class="os-caption">Production-Ready 2026</span>
        </div>

        <h1 class="os-display os-reveal os-reveal-delay-1" style="margin-bottom: var(--spacing-24);">
          <span class="os-text-gradient-animate">Build Your AI Workforce.</span>
        </h1>

        <p class="os-lead os-reveal os-reveal-delay-2" style="margin-bottom: 32px; max-width: 640px;">
          <strong style="font-weight: 700; color: var(--ink-black);">80 Experts</strong> that advise across Sales, HR, SEO, Legal, Finance and 25 more — plus <strong style="font-weight: 700; color: var(--ink-black);">6 Agents</strong> that run on schedules and take real actions with your approval.
        </p>

        {/* Primary Action Buttons */}
        <div class="os-reveal os-reveal-delay-3" style="display: flex; gap: 16px; align-items: center; justify-content: center; flex-wrap: wrap; margin-bottom: 24px;">
          <a href="/signup" class="os-btn os-btn-primary os-magnetic" style="padding: 14px 28px; font-size: 15px;">
            Build Your AI Workforce →
          </a>
          <a href="#employees" class="os-btn os-btn-secondary" style="padding: 14px 24px; font-size: 15px;">
            Explore AI Employees
          </a>
          <a href="/demo" class="os-btn os-btn-ghost" style="padding: 14px 20px; font-size: 15px; font-weight: 600;">
            Book a Demo
          </a>
        </div>

        {/* Trust Highlights Strip */}
        <div style="display: flex; gap: 24px; align-items: center; justify-content: center; font-size: 13px; color: var(--ink-secondary); flex-wrap: wrap;">
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="color: var(--status-green); font-weight: 700;">✓</span>
            <span>No credit card</span>
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="color: var(--status-green); font-weight: 700;">✓</span>
            <span>Enterprise ready</span>
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="color: var(--status-green); font-weight: 700;">✓</span>
            <span>Multi-agent collaboration</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* ─── 2. METRICS STRIP ─── */}
  <section class="os-section-light" style="padding: 16px 0; border-top: 1px solid var(--candy-pink); border-bottom: 1px solid var(--candy-pink);">
    <div class="os-container">
      <div style="text-align: center; font-size: 0.75rem; color: var(--ink-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">
        Built for the next generation of operating teams
      </div>
      <div class="os-grid-4">
        <div style="text-align: center;">
          <div style="font-size: 2.25rem; font-weight: 800; color: var(--ink-black); line-height: 1;">30</div>
          <div style="font-size: 0.9rem; color: var(--ink-secondary); margin-top: 6px;">AI specialists</div>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 2.25rem; font-weight: 800; color: var(--ink-black); line-height: 1;">9</div>
          <div style="font-size: 0.9rem; color: var(--ink-secondary); margin-top: 6px;">Departments covered</div>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 2.25rem; font-weight: 800; color: var(--ink-black); line-height: 1;">120+</div>
          <div style="font-size: 0.9rem; color: var(--ink-secondary); margin-top: 6px;">Output types</div>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 2.25rem; font-weight: 800; color: var(--ink-black); line-height: 1;">1.2M</div>
          <div style="font-size: 0.9rem; color: var(--ink-secondary); margin-top: 6px;">Tasks completed weekly</div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── 3. AI EMPLOYEES SHOWCASE ─── */}
  <EmployeeShowcase />

  <HowItWorks />
  <PlatformOverview />

  {/* ─── 4. WHAT YOU CAN SHIP ─── */}
  <section class="os-section" style="padding: 48px 0; background: #ffffff; border-top: 1px solid var(--border-light); border-bottom: 1px solid var(--border-light);">
    <div class="os-container">
      
      <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: var(--spacing-48); gap: var(--spacing-24); flex-wrap: wrap;">
        <div>
          <div class="os-eyebrow">
            WHAT YOU CAN SHIP
          </div>
          <h2 class="os-h2" style="margin: 0; max-width: 720px;">
            Hire one Assistant. Or stand up your whole workforce.
          </h2>
        </div>
        <a href="/experts" class="splash-nav" style="font-size: var(--text-small); font-weight: 600; color: var(--ink-secondary); text-decoration: none; padding-bottom: 4px; border-bottom: 1px solid var(--ink-black);">Browse all 30 →</a>
      </div>

      <style>
        #use-cases-carousel::-webkit-scrollbar {
          display: none;
        }
      </style>
      
      <div style="position: relative; margin-top: var(--spacing-32); margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); padding-left: calc(50vw - 50%); padding-right: calc(50vw - 50%);">
        
        {/* Carousel Container */}
        <div id="use-cases-carousel" style="display: flex; gap: var(--spacing-24); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -ms-overflow-style: none; padding-top: var(--spacing-16); padding-bottom: var(--spacing-32);">
          
          <a href="/experts" class="os-card os-card-cream os-card-symmetric splash-nav" style="flex: 0 0 320px; scroll-snap-align: start; text-decoration: none; color: inherit; display: flex; flex-direction: column;">
            <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
              <img src="/images/cards/assistants.jpg" alt="22 Assistants" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <div style="flex: 1;">
              <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">22 Assistants</h3>
              <p class="os-small" style="margin-bottom: var(--spacing-24);">
                Chat-driven specialists across 6 departments.
              </p>
            </div>
            <div style="font-size: var(--text-caption); font-weight: 700; color: #16a34a;">Learn more →</div>
          </a>

          <a href="/agents" class="os-card os-card-cream os-card-symmetric splash-nav" style="flex: 0 0 320px; scroll-snap-align: start; text-decoration: none; color: inherit; display: flex; flex-direction: column;">
            <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
              <img src="/images/cards/agents.jpg" alt="6 Agents" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <div style="flex: 1;">
              <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">6 Agents</h3>
              <p class="os-small" style="margin-bottom: var(--spacing-24);">
                Run on a cadence. Take real actions with approval gates.
              </p>
            </div>
            <div style="font-size: var(--text-caption); font-weight: 700; color: #d97706;">Learn more →</div>
          </a>

          <a href="/platform" class="os-card os-card-cream os-card-symmetric splash-nav" style="flex: 0 0 320px; scroll-snap-align: start; text-decoration: none; color: inherit; display: flex; flex-direction: column;">
            <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
              <img src="/images/cards/handoff.jpg" alt="Multi-agent handoff" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <div style="flex: 1;">
              <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">Multi-agent handoff</h3>
              <p class="os-small" style="margin-bottom: var(--spacing-24);">
                Specialists pass work to other specialists, end-to-end.
              </p>
            </div>
            <div style="font-size: var(--text-caption); font-weight: 700; color: #0066ff;">Learn more →</div>
          </a>

          <a href="/experts#gtm" class="os-card os-card-cream os-card-symmetric splash-nav" style="flex: 0 0 320px; scroll-snap-align: start; text-decoration: none; color: inherit; display: flex; flex-direction: column;">
            <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
              <img src="/images/cards/seo.jpg" alt="SEO + AEO audits" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <div style="flex: 1;">
              <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">SEO + AEO audits</h3>
              <p class="os-small" style="margin-bottom: var(--spacing-24);">
                Crawl any URL, score on 40 signals, return a fix list.
              </p>
            </div>
            <div style="font-size: var(--text-caption); font-weight: 700; color: #2c8d5e;">Learn more →</div>
          </a>

          <a href="/experts#gtm" class="os-card os-card-cream os-card-symmetric splash-nav" style="flex: 0 0 320px; scroll-snap-align: start; text-decoration: none; color: inherit; display: flex; flex-direction: column;">
            <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
              <img src="/images/cards/sales.jpg" alt="Sales pipeline" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <div style="flex: 1;">
              <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">Sales pipeline</h3>
              <p class="os-small" style="margin-bottom: var(--spacing-24);">
                Lead research, outbound drafts, CRM notes that stay tidy.
              </p>
            </div>
            <div style="font-size: var(--text-caption); font-weight: 700; color: #c0426a;">Learn more →</div>
          </a>

          <a href="/experts#people" class="os-card os-card-cream os-card-symmetric splash-nav" style="flex: 0 0 320px; scroll-snap-align: start; text-decoration: none; color: inherit; display: flex; flex-direction: column;">
            <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
              <img src="/images/cards/hr.jpg" alt="HR + recruiting" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <div style="flex: 1;">
              <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">HR + recruiting</h3>
              <p class="os-small" style="margin-bottom: var(--spacing-24);">
                Drafted JDs, candidate screening, employee-handbook answers.
              </p>
            </div>
            <div style="font-size: var(--text-caption); font-weight: 700; color: #7150d4;">Learn more →</div>
          </a>

          <a href="/experts#ops" class="os-card os-card-cream os-card-symmetric splash-nav" style="flex: 0 0 320px; scroll-snap-align: start; text-decoration: none; color: inherit; display: flex; flex-direction: column;">
            <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
              <img src="/images/cards/finance.jpg" alt="Finance + ops" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <div style="flex: 1;">
              <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">Finance + ops</h3>
              <p class="os-small" style="margin-bottom: var(--spacing-24);">
                Forecasts, standup summaries, tickets that file themselves.
              </p>
            </div>
            <div style="font-size: var(--text-caption); font-weight: 700; color: #c2542f;">Learn more →</div>
          </a>

          <a href="/signup" class="os-card os-card-cream os-card-symmetric splash-nav" style="flex: 0 0 320px; scroll-snap-align: start; text-decoration: none; color: inherit; display: flex; flex-direction: column;">
            <div style="width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); margin-bottom: var(--spacing-16); overflow: hidden; background: var(--bg-cream-alt);">
              <img src="/images/cards/start.jpg" alt="Free to start" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <div style="flex: 1;">
              <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">Free to start</h3>
              <p class="os-small" style="margin-bottom: var(--spacing-24);">
                50,000 credits a month. No card. No vendor lock-in.
              </p>
            </div>
            <div style="font-size: var(--text-caption); font-weight: 700; color: #16a34a;">Learn more →</div>
          </a>

          {/* Spacer for proper ending padding when scrolling */}
          <div style="flex: 0 0 calc(50vw - 50% - var(--spacing-24));"></div>

        </div>

        {/* Navigation Controls */}
        <div style="display: flex; align-items: center; justify-content: center; gap: var(--spacing-16); margin-top: var(--spacing-24);">
          <button id="carousel-prev" aria-label="Previous slide" style="width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--border-medium); background: var(--bg-cream-alt); display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--ink-secondary); transition: all 0.2s; box-shadow: var(--shadow-sm);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          
          <div id="carousel-dots" style="display: flex; gap: 8px;">
            {[...Array(8)].map((_, i) => (
              <div class={`carousel-dot`} data-index={i} style={`width: 8px; height: 8px; border-radius: 50%; background: ${i===0 ? 'var(--ink-black)' : 'var(--border-medium)'}; transition: background 0.3s;`}></div>
            ))}
          </div>

          <button id="carousel-next" aria-label="Next slide" style="width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--border-medium); background: var(--bg-cream-alt); display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--ink-secondary); transition: all 0.2s; box-shadow: var(--shadow-sm);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>

      </div>

      <script>
        import { navigate } from 'astro:transitions/client';

        document.addEventListener('astro:page-load', () => {
          // --- Carousel Logic ---
          const carousel = document.getElementById('use-cases-carousel');
          const prevBtn = document.getElementById('carousel-prev');
          const nextBtn = document.getElementById('carousel-next');
          const dots = document.querySelectorAll('.carousel-dot');

          if (carousel && prevBtn && nextBtn) {
            const gap = 24;
            
            const getScrollAmount = () => {
              const firstCard = carousel.querySelector('a');
              return firstCard ? firstCard.offsetWidth + gap : 344;
            };
            
            prevBtn.addEventListener('click', () => {
              carousel.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
            });
            
            nextBtn.addEventListener('click', () => {
              carousel.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
            });

            carousel.addEventListener('scroll', () => {
              const scrollAmount = getScrollAmount();
              let index = Math.round(carousel.scrollLeft / scrollAmount);
              
              if (index < 0) index = 0;
              if (index >= dots.length) index = dots.length - 1;

              dots.forEach((dot, i) => {
                (dot as HTMLElement).style.background = i === index ? 'var(--ink-black)' : 'var(--border-medium)';
              });
            });
            
            [prevBtn, nextBtn].forEach(btn => {
              btn.addEventListener('mouseenter', () => {
                btn.style.background = 'var(--bg-white)';
                btn.style.borderColor = 'var(--ink-black)';
                btn.style.color = 'var(--ink-black)';
              });
              btn.addEventListener('mouseleave', () => {
                btn.style.background = 'var(--bg-cream-alt)';
                btn.style.borderColor = 'var(--border-medium)';
                btn.style.color = 'var(--ink-secondary)';
              });
            });
          }

          // --- Dynamic Splash Navigation ---
          document.querySelectorAll('.splash-nav').forEach(link => {
            // Prevent duplicate listeners on Astro soft navigations
            const newLink = link.cloneNode(true) as HTMLElement;
            link.parentNode?.replaceChild(newLink, link);
            
            newLink.addEventListener('click', function(e) {
              if (e.metaKey || e.ctrlKey) return; // allow new tabs
              e.preventDefault();
              
              const href = this.getAttribute('href');
              if (!href) return;
              
              // Get precise click coordinates
              const x = e.clientX;
              const y = e.clientY;
              
              // Create dynamic expanding circle overlay
              const splash = document.createElement('div');
              splash.style.position = 'fixed';
              splash.style.left = x + 'px';
              splash.style.top = y + 'px';
              splash.style.width = '0';
              splash.style.height = '0';
              splash.style.borderRadius = '50%';
              splash.style.backgroundColor = 'var(--candy-pink)';
              splash.style.transform = 'translate(-50%, -50%)';
              splash.style.zIndex = '99999'; // extremely high
              splash.style.pointerEvents = 'none'; // prevent blocking UI
              splash.style.transition = 'width 1.2s cubic-bezier(0.65, 0, 0.35, 1), height 1.2s cubic-bezier(0.65, 0, 0.35, 1)';
              
              document.body.appendChild(splash);
              
              // Calculate screen size to determine full cover scale
              const maxDim = Math.max(window.innerWidth, window.innerHeight) * 3;
              
              // Trigger expansion
              requestAnimationFrame(() => {
                splash.style.width = maxDim + 'px';
                splash.style.height = maxDim + 'px';
              });
              
              // Trigger programmatic navigation as soon as circle covers screen
              setTimeout(() => {
                navigate(href);
                
                // Fade out and cleanup the splash overlay after route swap
                setTimeout(() => {
                  splash.style.transition = 'opacity 0.8s ease-in-out';
                  splash.style.opacity = '0';
                  setTimeout(() => splash.remove(), 800);
                }, 200);
              }, 900); 
            });
          });
        });
      </script>

    </div>
  </section>

  {/* ─── 5. THE WORK THAT SHIPS ─── */}
  <section class="os-section" style="padding: 48px 0; background: var(--warm-cream);">
    <div class="os-container">
      
      <div class="os-section-header">
        <div class="os-eyebrow">
