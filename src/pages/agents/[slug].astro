---
import Layout from "~/layouts/Layout.astro";
import { agents, agentCategories } from "~/data/agents";

export function getStaticPaths() {
  return agents.map(a => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params as { slug: string };
const agent = agents.find(a => a.slug === slug)!;
const category = agentCategories[agent.category];

const dashboardBase = (import.meta.env.PUBLIC_DASHBOARD_URL as string | undefined) ?? "https://app.ollasuper.com";
const startChatHref = `${dashboardBase}/chat?agent=${agent.slug}`;

const toolGroups = agent.tools.reduce((acc, t) => {
  (acc[t.category] = acc[t.category] || []).push(t);
  return acc;
}, {} as Record<string, typeof agent.tools>);

const related = agent.pairs.map(p => {
  if (p.startsWith("experts/")) return { kind: "expert", slug: p.slice(8), href: `/${p}` };
  return { kind: "agent", slug: p, href: `/agents/${p}` };
});
---
<Layout current="agents" title={`${agent.name} — OllaSuper`} description={agent.oneliner}>

  {/* HERO */}
  <section class="os-section" style="position: relative; overflow: hidden; background: linear-gradient(180deg, var(--warm-cream) 0%, #fffbf2 100%);">
    <div class="qw-hero-bg"></div>
    <div class="os-container" style="position: relative;">
      <div class="os-small" style="display: flex; align-items: center; gap: var(--spacing-8); font-weight: 500; color: var(--ink-secondary); margin-bottom: var(--spacing-16);">
        <a href="/agents" style="color: var(--ink-secondary); text-decoration: none;">⚡ Agents</a>
        <span style="color: var(--border-medium);">→</span>
        <span style="color: var(--ink-black); font-weight: 600;">{agent.short}</span>
      </div>

      <div style="display: flex; align-items: center; gap: var(--spacing-24);">
        <span style={`display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 16px; background: ${agent.color}1a; color: ${agent.color}; font-weight: 700; font-size: 32px;`}>⚡</span>
        <div>
          <div class="os-eyebrow" style={`color: ${category.color};`}>{category.label} · openfang Agent</div>
          <h1 class="os-display" style="margin-top: 4px;">{agent.name}</h1>
        </div>
      </div>

      <p class="os-lead" style="max-width: 640px; margin-top: var(--spacing-24);">{agent.oneliner}</p>

      <div style="margin-top: var(--spacing-32); display: flex; gap: var(--spacing-16); flex-wrap: wrap;">
        <a href={startChatHref} class="os-btn os-btn-primary">Chat with this Agent →</a>
        <a href="#workflow" class="os-btn os-btn-secondary">How it works</a>
      </div>
    </div>
  </section>

  {/* META BAR */}
  <section class="os-section" style="padding-top: 0; padding-bottom: 40px; background: linear-gradient(180deg, #fffbf2 0%, var(--bg-cream) 100%); border-bottom: 1px solid var(--border-light);">
    <div class="os-container">
      <div class="os-grid-3">
        <div class="os-card os-card-cream os-card-symmetric" style="padding: var(--spacing-24); border: 1px solid var(--border-medium);">
          <div class="os-caption" style="font-weight: 700; text-transform: uppercase;">Schedule</div>
          <div style="font-weight: 700; font-size: 15px; color: var(--ink-black); margin-top: var(--spacing-8);">{agent.schedule.display}</div>
        </div>
        <div class="os-card os-card-cream os-card-symmetric" style="padding: var(--spacing-24); border: 1px solid var(--border-medium);">
          <div class="os-caption" style="font-weight: 700; text-transform: uppercase;">Model</div>
          <div style="font-weight: 700; font-size: 15px; color: var(--ink-black); margin-top: var(--spacing-8);">{agent.modelTier === "deep-research" ? "Tongyi DeepResearch 30B A3B" : agent.modelTier === "smart" ? "OpenAI GPT-4o" : "OpenAI GPT-4o-mini"}</div>
          <div class="os-caption" style="color: var(--ink-secondary); margin-top: 4px;">{agent.model}</div>
        </div>
        <div class="os-card os-card-cream os-card-symmetric" style="padding: var(--spacing-24); border: 1px solid var(--border-medium);">
          <div class="os-caption" style="font-weight: 700; text-transform: uppercase;">Approval</div>
          <div style="font-weight: 700; font-size: 15px; color: var(--ink-black); margin-top: var(--spacing-8);">{agent.approval.display}</div>
          {agent.approval.details && <div class="os-caption" style="color: var(--ink-secondary); margin-top: 4px;">{agent.approval.details}</div>}
        </div>
      </div>
    </div>
  </section>

  {/* WORKFLOW */}
  <section id="workflow" class="os-section">
    <div class="os-container">
      <h2 class="os-h2" style="margin-bottom: 24px;">What it does</h2>
      <p class="os-lead" style="max-width: 740px;">{agent.workflow}</p>
    </div>
  </section>

  {/* TOOLS */}
  <section class="os-section" style="padding-top: 0;">
    <div class="os-container">
      <h2 class="os-h2" style="margin-bottom: 24px;">Tools it can use</h2>
      <div style="display: grid; gap: 32px;">
        {Object.entries(toolGroups).map(([cat, ts]) => (
          <div>
            <div style="font-size: 12px; font-weight: 700; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">{cat}</div>
            <div style="display: grid; gap: 8px;">
              {ts.map(t => (
                <div class="os-card os-card-cream os-card-symmetric" style="display: flex; gap: 16px; padding: 12px 16px; border: 1px solid var(--border-medium); align-items: baseline;">
                  <code style="font-size: 13px; font-weight: 600; font-family: ui-monospace, monospace; color: var(--ink-black);">{t.name}</code>
                  <span style="font-size: 14px; color: var(--ink-secondary); flex: 1;">{t.description}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* WORKSPACE */}
  <section class="os-section" style="padding-top: 0;">
    <div class="os-container">
      <h2 class="os-h2" style="margin-bottom: 24px;">Workspace</h2>
      <p style="font-size: 14px; color: var(--ink-secondary); margin-bottom: 16px;">Paths under <code style="font-size: 13px; font-family: var(--font-mono); background: var(--bg-cream-alt); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--border-light);">/var/lib/openfang/workspace/</code> this Agent reads or writes:</p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        {agent.workspace.map(p => (
          <code style="display: inline-block; padding: 8px 16px; font-size: 13px; font-family: ui-monospace, monospace; background: var(--bg-cream-alt); color: var(--ink-black); border: 1px solid var(--border-medium); border-radius: 6px;">{p}</code>
        ))}
      </div>
    </div>
  </section>

  {/* STARTERS */}
  <section class="os-section" style="padding-top: 0;">
    <div class="os-container">
      <h2 class="os-h2" style="margin-bottom: 24px;">Starter prompts</h2>
      <div class="os-grid-2">
        {agent.starters.map(s => (
          <a href={`${dashboardBase}/chat?agent=${agent.slug}&prompt=${encodeURIComponent(s.prompt)}`} class="os-card os-card-cream os-card-symmetric" style="display: block; padding: 24px; color: var(--ink-black); text-decoration: none; border: 1px solid var(--border-medium);">
            <div style="font-weight: 700; font-size: 15px; color: var(--ink-black);">{s.title}</div>
            <div style="font-size: 13px; color: var(--ink-secondary); margin-top: 6px;">{s.tagline}</div>
            <div style="font-size: 13px; color: var(--ink-secondary); margin-top: 16px; line-height: 1.55;">{s.prompt}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* SAMPLE */}
  <section class="os-section" style="padding-top: 0;">
    <div class="os-container">
      <h2 class="os-h2" style="margin-bottom: 24px;">Sample interaction</h2>
      <div class="os-card os-card-cream os-card-symmetric" style="padding: 0; overflow: hidden; border: 1px solid var(--border-medium);">
        <div style="padding: 20px 24px; background: #ffffff; border-bottom: 1px solid var(--border-light);">
          <div style="font-size: 11px; font-weight: 700; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">You</div>
          <div style="font-size: 15px; line-height: 1.5; color: var(--ink-black);">{agent.sample.user}</div>
        </div>
        <div style="padding: 24px;">
          <div style="display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">
            <span style="font-size: 14px;">⚡</span> {agent.name}
          </div>
          <div style="font-size: 15px; line-height: 1.65; white-space: pre-wrap; color: var(--ink-black);">{agent.sample.assistant}</div>
        </div>
      </div>
    </div>
  </section>

  {/* RELATED */}
  {related.length > 0 && (
    <section class="os-section" style="padding-top: 0; padding-bottom: 100px;">
      <div class="os-container">
        <h2 class="os-h2" style="margin-bottom: 24px;">Pairs well with</h2>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          {related.map(r => (
            <a href={r.href} class="os-btn os-btn-secondary" style="font-size: 13px; font-weight: 600;">
              <span style="margin-right: 8px;">{r.kind === "agent" ? "⚡" : "○"}</span>
              {r.slug}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</Layout>
