---
import Layout from "~/layouts/Layout.astro";
import { agents, agentCategories } from "~/data/agents";

const grouped = Object.keys(agentCategories).map(key => ({
  key,
  ...agentCategories[key as keyof typeof agentCategories],
  agents: agents.filter(a => a.category === key),
}));

const dashboardBase = (import.meta.env.PUBLIC_DASHBOARD_URL as string | undefined) ?? "https://app.ollasuper.com";
---
<Layout current="agents" title="The 6 Agents — OllaSuper" description="6 production Agents that take real actions on schedules, with approval gates: Outbound SDR, Pipeline Curator, SEO Auditor, Content Publisher, Inbox Triage, and Deep Research powered by Tongyi DeepResearch.">

  {/* HERO */}
  <section class="os-section" style="position: relative; overflow: hidden; background: linear-gradient(180deg, var(--warm-cream) 0%, #fffbf2 100%);">
    <div class="qw-hero-bg"></div>
    <div class="os-container" style="position: relative;">
      <div class="os-grid-2" style="align-items: flex-start;">
        <div>
          <div class="os-eyebrow" style="color: #d97706;">⚡ Agents · 6 production workers</div>
          <h1 class="os-display" style="margin-bottom: var(--spacing-16);">
            The 6 Agents.
          </h1>
          <p class="os-lead" style="max-width: 600px;">
            Agents are the action-taking half of OllaSuper. Each runs on a recurring schedule, uses real tools (ollagraph + filesystem + memory), and writes its output to a workspace you can read.
            Every action that could leave the platform is queued for your approval before it ships.
          </p>
          <p style="max-width: 600px; margin-top: 10px; font-size: 14px; color: var(--ink-secondary); font-weight: 500;">
            Looking for the chat-driven Experts? <a href="/experts" style="color: var(--candy-pink); font-weight: 700;">See the 80 Experts →</a>
          </p>
        </div>
        <div class="os-card os-card-cream os-card-symmetric" style="padding: 24px; font-size: 13px; color: var(--ink-secondary); border: 1px solid var(--border-medium);">
          <div style="display: flex; align-items: center; gap: 8px; color: var(--ink-black); font-weight: 700; font-size: 14px; letter-spacing: -0.01em; margin-bottom: 8px;">
            <span style="font-size: 16px;">⚡</span>
            Agents vs ○ Experts
          </div>
          Agents run on schedules and take actions (queued for approval). Experts are chat-driven specialists with no schedule and no real-world side effects.
        </div>
      </div>
    </div>
  </section>

  {/* STICKY CATEGORY FILTER */}
  <div style="position: sticky; top: 57px; z-index: 30; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border-light);">
    <div class="os-container" style="padding: 16px 0;">
      <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
        <a href="#all" class="os-btn os-btn-primary" style="padding: 8px 16px; font-size: 13px;">All 6</a>
        {grouped.map(g => (
          <a href={`#${g.key}`} class="os-btn os-btn-secondary" style="padding: 8px 16px; font-size: 13px;">
            <span style={`width: 8px; height: 8px; border-radius: 999px; background: ${g.color}; margin-right: 6px; display: inline-block;`}></span>
            {g.label} <span style="color: var(--ink-secondary); font-weight: 400; margin-left: 4px;">{g.agents.length}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  {/* GROUPED LIST */}
  <section id="all" class="os-section">
    <div class="os-container">
      {grouped.map((group, gi) => (
        <div id={group.key} style={`margin-top: ${gi === 0 ? '0' : 'var(--spacing-64)'};`}>
          <div style="display: flex; align-items: center; gap: var(--spacing-12); margin-bottom: var(--spacing-24); padding-bottom: var(--spacing-16); border-bottom: 1px solid var(--border-medium);">
            <span style={`width: 14px; height: 14px; border-radius: 999px; background: ${group.color};`}></span>
            <h2 class="os-h2" style="margin: 0;">{group.label}</h2>
            <span class="os-small" style="font-weight: 600;">{group.agents.length} agent{group.agents.length === 1 ? '' : 's'}</span>
          </div>

          <div class="os-grid-2">
            {group.agents.map(a => (
              <a href={`/agents/${a.slug}`} class="os-card os-card-cream os-card-symmetric" style="display: block; color: var(--ink-black); text-decoration: none; border: 1px solid var(--border-medium);">
                <div style="display: flex; align-items: center; gap: var(--spacing-12);">
                  <span style={`display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 8px; background: ${a.color}1a; color: ${a.color}; font-weight: 700; font-size: 16px;`}>⚡</span>
                  <div class="os-h4">{a.name}</div>
                </div>
                <p class="os-small" style="margin-top: var(--spacing-12);">{a.oneliner}</p>
                <div style="margin-top: var(--spacing-16); display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                  <span style="display: inline-block; padding: 4px 8px; border-radius: 4px; background: var(--bg-cream-alt); color: var(--ink-secondary); font-weight: 600; font-size: var(--text-caption); border: 1px solid var(--border-medium);">{a.schedule.display}</span>
                  <span style={`display: inline-block; padding: 4px 8px; border-radius: 4px; background: ${a.color}14; color: ${a.color}; font-weight: 600; font-size: var(--text-caption);`}>{a.modelTier === "deep-research" ? "Tongyi DeepResearch" : a.modelTier === "smart" ? "GPT-4o" : "GPT-4o-mini"}</span>
                  {a.approval.mode !== "none" && (
                    <span style="display: inline-block; padding: 4px 8px; border-radius: 4px; background: rgba(217, 119, 6, 0.1); color: #d97706; font-weight: 600; font-size: var(--text-caption);">Approval required</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  {/* HOW TO USE AN AGENT — added 2026-06-15. Agents are scheduled +      */}
  {/* action-taking, so the five-step flow is different from Experts.     */}
  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  <section class="os-section" style="background: var(--bg-cream-alt); border-top: 1px solid var(--border-light); border-bottom: 1px solid var(--border-light);">
    <div class="os-container">
      <div class="os-section-header">
        <div class="os-eyebrow" style="color: #d97706;">⚡ How to use an Agent</div>
        <h2 class="os-h2">Five steps from "schedule this" to a real action you sign off on.</h2>
        <p class="os-lead">
          Agents run on cron, call tools, draft real outputs (emails, PRs, audits, briefs) — then hold them at an approval gate so nothing ships without your nod.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
        {[
          { n: "1", title: "Pick the Agent",            body: "Six production Agents auto-spawn at boot: Outbound SDR, Pipeline Curator, SEO Auditor, Content Publisher, Inbox Triage, Deep Research. Pick the one whose tools + role match your job." },
          { n: "2", title: "Brief it like a teammate",   body: "Natural language. \"Audit ollasuper.com for AEO regressions every Monday.\" The Agent's system prompt is already loaded with its workflow rules — you just hand it the target." },
          { n: "3", title: "Watch it work",              body: "Agents call real tools: ollagraph scrape, web_fetch, file_write, memory_recall, MCP tools. The dashboard shows the tool-call trace so you can audit what it did and why." },
          { n: "4", title: "Approve before it ships",    body: "Drafts queue in the approval surface — emails before send, blog posts before publish, PRs before merge. One click approves; one click sends back for a rewrite." },
          { n: "5", title: "Schedule + hand off",        body: "Once you trust an Agent, turn on a cron schedule (every 15m / hourly / daily). Or have it hand off to another Agent — SDR finds leads, Outbound drafts emails, Inbox triages replies." },
        ].map(s => (
          <div class="os-card os-card-cream os-card-symmetric" style="padding: 24px;">
            <div style="font-family: var(--font-mono); font-size: 11px; color: #d97706; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">STEP {s.n}</div>
            <div style="font-weight: 700; font-size: 15px; letter-spacing: -0.01em; color: var(--ink-black); margin-top: 10px;">{s.title}</div>
            <p style="margin: 10px 0 0; font-size: 13px; line-height: 1.55; color: var(--ink-secondary);">{s.body}</p>
          </div>
        ))}
      </div>

      <div class="os-card os-card-cream os-card-symmetric" style="margin-top: 40px; padding: 24px; border: 1px solid var(--border-medium); display: flex; align-items: flex-start; gap: 16px; flex-direction: row;">
        <div style="flex: 0 0 36px; height: 36px; border-radius: 50%; background: rgba(217, 119, 6, 0.1); color: #d97706; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px;">!</div>
        <div style="font-size: 14px; line-height: 1.6; color: var(--ink-secondary);">
          <strong style="color: var(--ink-black);">Schedules are off by default.</strong> A misconfigured cron loop on content-publisher (gpt-4o, smart tier) burned $27 in 4 days before we caught it. The 6 production Agents now ship queue-fed only — flip the schedule on per Agent when you actually want one. Use a per-day OpenRouter cap as a safety net.
        </div>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="os-section" style="padding-top: 0;">
    <div class="os-container">
      <div class="os-card os-card-cream os-card-symmetric" style="text-align: center; padding: 48px; border: 1px solid var(--border-medium);">
        <div class="os-eyebrow" style="color: #d97706; justify-content: center;">⚡ Try an Agent</div>
        <h2 class="os-h2" style="margin-top: 12px;">Talk to an Agent — they run real workflows</h2>
        <p class="os-lead" style="max-width: 560px; margin: 16px auto 32px;">
          Every Agent has 4 starter prompts to try. Open the dashboard, pick an Agent, send your first prompt.
        </p>
        <a href={dashboardBase} class="os-btn os-btn-primary" style="font-size: 15px; padding: 14px 28px;">Open the dashboard →</a>
      </div>
    </div>
  </section>

</Layout>
