---
import Layout from "~/layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("journal");
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<Layout current="journal" title={`${post.data.title} — qwriter`} description={post.data.description}>

  <article style="padding: 96px 32px 64px;">
    <div class="qw-section-tight">
      <a href="/journal" class="qw-mono" style="font-size: 11px; color: var(--ink-3); letter-spacing: 0.06em;">← BACK TO JOURNAL</a>
      <div class="qw-eyebrow qw-eyebrow-accent" style="margin-top: 24px;">
        {fmt(post.data.publishedAt).toUpperCase()} · {post.data.author.toUpperCase()}
      </div>
      <h1 class="qw-h-1" style="margin-top: 12px;">{post.data.title}</h1>
      {post.data.description && <p class="qw-body" style="margin-top: 18px; font-size: 19px;">{post.data.description}</p>}

      <div style="margin-top: 40px; font-size: 17px; line-height: 1.7; color: var(--ink); --tw-prose-body: var(--ink);">
        <Content />
      </div>

      <div style="margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--rule); display: flex; gap: 8px; flex-wrap: wrap;">
        {post.data.tags.map((t: string) => (
          <span class="qw-mono" style="padding: 4px 10px; background: var(--bone); color: var(--ink-3); border-radius: 99px; font-size: 11px; letter-spacing: 0.06em;">#{t.toUpperCase()}</span>
        ))}
      </div>
    </div>
  </article>

</Layout>

<style is:global>
  article h2 { font-size: 28px; font-weight: 600; letter-spacing: -0.02em; margin-top: 40px; margin-bottom: 14px; }
  article h3 { font-size: 21px; font-weight: 600; margin-top: 32px; margin-bottom: 10px; }
  article p { margin: 14px 0; }
  article ol, article ul { margin: 14px 0; padding-left: 24px; }
  article li { margin: 6px 0; }
  article a { color: var(--accent); border-bottom: 1px solid var(--accent); }
  article strong { color: var(--ink); font-weight: 600; }
  article code { background: var(--bone); padding: 2px 6px; border-radius: 4px; font-family: var(--font-mono); font-size: 0.92em; }
  article pre { background: var(--bone); padding: 18px 20px; border-radius: 12px; overflow-x: auto; }
</style>
