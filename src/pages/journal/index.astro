---
import Layout from "~/layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("journal")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<Layout current="journal" title="Journal — qwriter">

  <section style="padding: 96px 32px 48px;">
    <div class="qw-section">
      <div class="qw-eyebrow qw-eyebrow-accent">· JOURNAL · NOTES + RELEASES</div>
      <h1 class="qw-h-display" style="margin-top: 12px;">The journal.</h1>
      <p class="qw-body" style="max-width: 540px; margin-top: 14px; font-size: 18px;">
        Short notes on what we're building, what we're learning, and what we
        ship every Friday.
      </p>
    </div>
  </section>

  <section style="padding: 32px;">
    <div class="qw-section">
      <div style="display: flex; flex-direction: column; gap: 8px;">
        {posts.length === 0 ? (
          <p class="qw-body">No posts yet — check back soon.</p>
        ) : posts.map((p) => (
          <a href={`/journal/${p.slug}`}
             style="display: grid; grid-template-columns: 180px 1fr auto; gap: 28px; padding: 28px 0; align-items: baseline; border-bottom: 1px solid var(--rule); color: inherit;">
            <span class="qw-mono" style="font-size: 12px; color: var(--ink-3); letter-spacing: 0.06em;">
              {fmt(p.data.publishedAt).toUpperCase()}
            </span>
            <div>
              <h2 class="qw-h-2">{p.data.title}</h2>
              {p.data.description && (
                <p style="margin-top: 8px; color: var(--ink-3); font-size: 15px; line-height: 1.55;">{p.data.description}</p>
              )}
            </div>
            <span style="color: var(--ink-3); font-size: 14px;">read →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>
