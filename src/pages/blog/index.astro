---
import BaseLayout from '~/layouts/BlogBaseLayout.astro';
import PostCard from '~/components/blog/PostCard.astro';
import FormattedDate from '~/components/blog/FormattedDate.astro';
import { SITE } from '~/blog-config';
import { getPublishedPosts, readingTime } from '~/utils/posts';

const posts = await getPublishedPosts();
const featured = posts[0];
const rest = posts.slice(1);

const allTags = [...new Set(posts.flatMap(p => p.data.tags || []))].sort();

function getTagColor(tag: string) {
  const t = tag.toLowerCase();
  if (t === 'ai workforce') return '#ff8000';
  if (t === 'guide' || t === 'guides') return '#E3256B';
  const hash = tag.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const colors = ['#7C3AED', '#2563EB', '#0284C7', '#059669', '#D97706', '#0891B2', '#4F46E5', '#0D9488', '#F59E0B', '#E11D48'];
  return colors[hash % colors.length];
}
---

<BaseLayout>
  <div class="home-layout">
    <aside class="sidebar-left">
      <span class="sidebar-title">ALL BLOG POSTS</span>
      <ul class="sidebar-list">
        {posts.map((p) => (
          <li><a href={`/blog/${p.slug}/`}>{p.data.title}</a></li>
        ))}
      </ul>
    </aside>

    <main class="main-content" style="min-width: 0;">
      <section class="hero">
        <h1 class="hero-title">{SITE.brand} <span style="color: var(--accent);">Blog</span></h1>
        <p class="hero-tagline">{SITE.description}</p>
        
        {allTags.length > 0 && (
          <div class="hero-tags" style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-top: 20px; max-width: 100%;">
            {allTags.map((tag) => (
              <a href={`/tags/${tag}/`} style={`font-size: 0.8rem; font-weight: 600; padding: 4px 10px; border-radius: 20px; background: transparent; color: ${getTagColor(tag)}; border: 1px solid ${getTagColor(tag)}80; text-decoration: none; transition: all 0.2s ease; white-space: nowrap;`} onmouseover={`this.style.background='${getTagColor(tag)}15'; this.style.borderColor='${getTagColor(tag)}'`} onmouseout={`this.style.background='transparent'; this.style.borderColor='${getTagColor(tag)}80'`}>
                #{tag}
              </a>
            ))}
          </div>
        )}
      </section>

      <div class="section-header">
        <span class="section-badge">NEWEST ARTICLES</span>
        <span class="section-desc">Latest from our experts</span>
      </div>

      {posts.length === 0 && <p class="empty">No posts yet — check back soon.</p>}

      {
        featured && (() => {
          const tagColor = featured.data.tags && featured.data.tags.length > 0 ? getTagColor(featured.data.tags[0]) : 'var(--border)';
          return (
          <a class="featured" href={`/blog/${featured.slug}/`} style={`--card-accent: ${tagColor};`}>
            <div class="featured-media">
              {featured.data.cover ? (
                <img src={featured.data.cover} alt={featured.data.title} class="featured-img" width="1200" height="630" loading="eager" decoding="async" />
              ) : (
                <div class="featured-img-placeholder"></div>
              )}
            </div>
            <div class="featured-content">
              {featured.data.tags && featured.data.tags.length > 0 && (
                <span class="featured-tag" style="background: var(--card-accent)">{featured.data.tags[0]}</span>
              )}
              <h2 class="featured-title">{featured.data.title}</h2>
              <p class="featured-desc" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; margin-bottom: 1rem; font-size: 0.95rem; line-height: 1.5;">{featured.data.description}</p>
              <div class="featured-meta">
                <span>{readingTime(featured.body)} min read</span>
                <span aria-hidden="true">·</span>
                <span><FormattedDate date={featured.data.pubDate} /></span>
                <span aria-hidden="true">·</span>
                <span class="featured-more">Read article →</span>
              </div>
            </div>
          </a>
          );
        })()
      }

      {
        rest.length > 0 && (
          <div class="post-list">
            {rest.map((p) => (
              <PostCard
                url={`/blog/${p.slug}/`}
                title={p.data.title}
                description={p.data.description}
                pubDate={p.data.pubDate}
                tags={p.data.tags}
                minutes={readingTime(p.body)}
              />
            ))}
          </div>
        )
      }
    </main>

    <aside class="sidebar-right">
      <span class="sidebar-title purple">OLLASUPER</span>
      <ul class="sidebar-list">
        <li><a href="https://ollasuper.com/">Return to the main OllaSuper homepage to see everything.</a></li>
        <li><a href="https://ollasuper.com/platform">Explore the autonomous platform that powers AI work.</a></li>
        <li><a href="https://ollasuper.com/ai-employees">Meet your new AI employee workforce and see them in action.</a></li>
        <li><a href="https://ollasuper.com/solutions">Discover industry-specific solutions tailored for your business.</a></li>
        <li><a href="https://ollasuper.com/resources">Read our comprehensive guides and educational resources.</a></li>
        <li><a href="https://ollasuper.com/blog">Follow the OllaSuper blog for the latest insights and news.</a></li>
        <li><a href="https://ollasuper.com/pricing">View our flexible pricing plans designed for teams of all sizes.</a></li>
        <li><a href="https://ollasuper.com/login">Access your OllaSuper dashboard to manage your AI workers.</a></li>
        <li><a href="https://ollasuper.com/demo">Schedule a personalized demo to see how we can help you.</a></li>
        <li><a href="https://ollasuper.com/signup" style="color: #3b82f6; font-weight: 600;">Deploy your AI workforce today and start scaling your team →</a></li>
      </ul>
    </aside>
  </div>
</BaseLayout>
