---
import Layout from "~/layouts/Layout.astro";
import { BLOG_POSTS, type BlogPost } from "~/data/blog";
import Post1 from "~/components/blog/posts/post-1.astro";
import Post2 from "~/components/blog/posts/post-2.astro";

const contentComponents: Record<string, any> = {
  "what-are-ai-agents-complete-guide-for-businesses-2026": Post1,
  "ai-agents-vs-ai-assistants-whats-the-difference": Post2,
};

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const PostContent = contentComponents[post.slug];
---

<Layout
  title={`${post.title} — OllaSuper`}
  description={post.description}
  current="blog"
>
  {/* JSON-LD Structured Data */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.description,
    "datePublished": post.publishDate,
    "dateModified": post.updatedDate,
    "keywords": post.keywords.join(", "),
    "author": {
      "@type": "Organization",
      "name": post.author.name,
      "url": "https://ollasuper.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": "OllaSuper",
      "logo": {
        "@type": "ImageObject",
        "url": "https://ollasuper.com/favicon.svg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://ollasuper.com/blog/${post.slug}`
    }
  })} />

  <article class="os-section" style="background: var(--warm-cream); padding-top: var(--spacing-48); padding-bottom: 100px;">
    <div class="os-container" style="max-width: 1180px;">
      
      {/* Breadcrumb */}
      <nav aria-label="Breadcrumb" class="os-small" style="color: var(--ink-muted); margin-bottom: var(--spacing-24); display: flex; gap: var(--spacing-8); align-items: center;">
        <a href="/" style="color: inherit; text-decoration: none;">Home</a>
        <span>/</span>
        <a href="/blog" style="color: inherit; text-decoration: none;">Blog</a>
        <span>/</span>
        <span style="color: var(--ink-black); font-weight: 600;">{post.category}</span>
      </nav>

      {/* ─── 1. ARTICLE HERO HEADER ─── */}
      <header style="margin-bottom: var(--spacing-48); border-bottom: 1px solid var(--border-medium); padding-bottom: var(--spacing-32); width: 100%;">
        <div class="os-caption" style="display: flex; gap: var(--spacing-12); font-weight: 700; color: var(--candy-pink-hover); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--spacing-16); align-items: center; flex-wrap: wrap;">
          <span class="os-badge os-badge-pink">{post.category}</span>
          <span>•</span>
          <span>Updated {post.updatedDate}</span>
          <span>•</span>
          <span>{post.readTime}</span>
        </div>

        <h1 class="os-display" style="margin-bottom: var(--spacing-24); color: var(--ink-black);">
          {post.title}
        </h1>

        <p class="os-lead" style="max-width: 1000px; margin-bottom: var(--spacing-24);">
          {post.description}
        </p>

        {/* Author and Tag Metadata */}
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; padding-top: var(--spacing-16); border-top: 1px solid var(--border-light);">
          <div style="display: flex; align-items: center; gap: var(--spacing-12);">
            <div style="width: 38px; height: 38px; border-radius: 50%; background: var(--candy-pink-soft); border: 1px solid var(--candy-pink-border); display: flex; align-items: center; justify-content: center; font-size: 18px;">
              {post.author.avatar}
            </div>
            <div>
              <div class="os-small" style="font-weight: 700; color: var(--ink-black);">{post.author.name}</div>
              <div class="os-caption">{post.author.role}</div>
            </div>
          </div>

          <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            {post.keywords.slice(0, 5).map((kw) => (
              <span class="os-badge" style="background: #ffffff; border: 1px solid var(--border-light); font-size: var(--text-caption); color: var(--ink-secondary);">
                #{kw}
              </span>
            ))}
          </div>
        </div>
      </header>

      {/* ─── 2. TABLE OF CONTENTS (24Observe Style Grid) ─── */}
      <nav style="background: #ffffff; border: 1px solid var(--border-medium); border-radius: var(--radius-xl); padding: 32px; margin-bottom: var(--spacing-32); box-shadow: var(--shadow-sm);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid var(--border-light);">
          <h3 style="font-size: 1.2rem; font-weight: 800; color: var(--ink-black); margin: 0; display: flex; align-items: center; gap: 10px;">
            <span style="color: var(--candy-pink);">☰</span> Table of Contents
          </h3>
          <span style="font-size: 0.85rem; color: var(--ink-muted); font-weight: 600;">{post.tableOfContents.length} Sections</span>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; width: 100%;">
          {post.tableOfContents.map((toc) => (
            <a href={`#${toc.id}`} class="os-toc-link" style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: var(--bg-cream-alt); border: 1px solid var(--border-light); border-radius: 8px; color: var(--ink-black); text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: all 0.15s ease;">
              <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 6px; background: var(--candy-pink-soft); color: #a81c85; font-size: 0.75rem; font-weight: 800; flex-shrink: 0;">
                {toc.num}
              </span>
              <span style="flex: 1; color: var(--ink-black);">{toc.title}</span>
              <span style="color: var(--candy-pink-hover); font-size: 0.9rem; flex-shrink: 0;">→</span>
            </a>
          ))}
        </div>
      </nav>

      {/* ─── 3. TL;DR CALLOUT BOX ─── */}
      <section style="background: #ffffff; border-left: 5px solid var(--candy-pink); border-radius: 10px; border-top: 1px solid var(--border-light); border-right: 1px solid var(--border-light); border-bottom: 1px solid var(--border-light); padding: 28px; margin-bottom: var(--spacing-32); box-shadow: var(--shadow-sm);">
        <h3 id="tldr" style="font-size: 1.2rem; font-weight: 800; color: #a81c85; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
          <span>⚡</span> TL;DR
        </h3>
        <p style="font-size: 1.1rem; line-height: 1.7; color: var(--ink-secondary); margin: 0;">
          {post.tldr}
        </p>
      </section>

      {/* ─── 4. ARTICLE BODY CONTENT (FORMATTED PROSE & CARDS) ─── */}
      <div class="blog-content" style="display: flex; flex-direction: column; gap: var(--spacing-32); line-height: 1.8; font-size: 1.08rem; color: var(--ink-secondary);">
        {PostContent ? <PostContent /> : <p>Content coming soon...</p>}

        {/* ─── 5. FAQ SECTION ─── */}
        <section class="os-card" style="background: #ffffff; border: 1px solid var(--border-medium); padding: 48px;">
          <h2 id="faq" class="os-h2" style="margin-bottom: 28px; color: var(--ink-black);">
            Frequently Asked Questions (FAQ)
          </h2>

          <div style="display: flex; flex-direction: column; gap: 24px;">
            {post.faqs.map((faq) => (
              <div style="border-bottom: 1px solid var(--border-light); padding-bottom: 20px;">
                <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--ink-black); margin-bottom: 8px;">
                  {faq.question}
                </h3>
                <p style="font-size: 1rem; line-height: 1.65; color: var(--ink-secondary); margin: 0;">
                  {faq.answer}
                </p>
              </div>
            ))}
          </div>
        </section>

        {/* ─── 6. BOTTOM ACTION CTA ─── */}
        <div style="background: #0c0f17; color: #ffffff; border: 1px solid #1e293b; border-radius: var(--radius-xl); padding: 48px; text-align: center; margin-top: 24px;">
          <span class="os-badge os-badge-pink" style="margin-bottom: 12px;">Deploy OllaSuper</span>
          <h2 style="font-size: 26px; font-weight: 800; color: #ffffff; margin-bottom: 12px;">
            Ready to build your AI workforce?
          </h2>
          <p style="font-size: 15px; color: #94a3b8; max-width: 560px; margin: 0 auto 28px;">
            Deploy intelligent, approval-gated AI employees across Research, Sales, Support, and Operations with full observability.
          </p>
          <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
            <a href="/signup" class="os-btn os-btn-primary" style="padding: 12px 28px; font-size: 15px;">
              Build Your AI Workforce →
            </a>
            <a href="/demo" class="os-btn os-btn-secondary" style="background: #1a2234; color: #ffffff; border-color: #334155; padding: 12px 24px;">
              Book a 1:1 Demo
            </a>
          </div>
        </div>

      </div>

    </div>
  </article>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          document.querySelectorAll('.os-toc-link').forEach(link => {
            link.classList.remove('active');
            if (link.getAttribute('href') === `#${id}`) {
              link.classList.add('active');
            }
          });
        }
      });
    }, { rootMargin: '-120px 0px -40% 0px' });

    document.querySelectorAll('.blog-content :is(h2, h3, h4)[id], #tldr').forEach((heading) => {
      observer.observe(heading);
    });
  });
</script>

<style>
  .os-toc-link.active {
    background: var(--candy-pink-soft) !important;
    border-color: var(--candy-pink-border) !important;
  }
  .os-toc-link.active span:first-child {
    background: var(--candy-pink) !important;
    color: #ffffff !important;
  }
  .os-toc-link.active span:nth-child(2) {
    color: var(--ink-black) !important;
    font-weight: 800 !important;
  }
  .os-toc-link:hover {
    background: #ffffff !important;
    border-color: var(--candy-pink) !important;
    transform: translateY(-1px);
  }
</style>
