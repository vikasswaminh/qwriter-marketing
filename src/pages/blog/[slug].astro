---
import Layout from "~/layouts/Layout.astro";
import { BLOG_POSTS, type BlogPost } from "~/data/blog";
import Post1 from "~/components/blog/posts/post-1.astro";
import Post2 from "~/components/blog/posts/post-2.astro";
import Post3 from "~/components/blog/posts/post-3.astro";

const contentComponents: Record<string, any> = {
  "what-are-ai-agents-complete-guide-for-businesses-2026": Post1,
  "ai-agents-vs-ai-assistants-whats-the-difference": Post2,
  "ai-automation-how-businesses-can-automate-workflows-with-ai": Post3,
};

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const PostContent = contentComponents[post.slug];
---

<Layout
  title={`${post.title} — OllaSuper`}
  description={post.description}
  current="blog"
>
  {/* JSON-LD Structured Data */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.description,
    "datePublished": post.publishDate,
    "dateModified": post.updatedDate,
    "keywords": post.keywords.join(", "),
    "author": {
      "@type": "Organization",
      "name": post.author.name,
      "url": "https://ollasuper.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": "OllaSuper",
      "logo": {
        "@type": "ImageObject",
        "url": "https://ollasuper.com/favicon.svg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://ollasuper.com/blog/${post.slug}`
    }
  })} />

  <article class="os-section" style="background: var(--warm-cream); padding-top: var(--spacing-48); padding-bottom: 100px;">
    <div class="os-container" style="max-width: 1180px;">
      
      {/* Breadcrumb */}
      <nav aria-label="Breadcrumb" class="os-small" style="color: var(--ink-muted); margin-bottom: var(--spacing-24); display: flex; gap: var(--spacing-8); align-items: center;">
        <a href="/" style="color: inherit; text-decoration: none;">Home</a>
        <span>/</span>
        <a href="/blog" style="color: inherit; text-decoration: none;">Blog</a>
        <span>/</span>
        <span style="color: var(--ink-black); font-weight: 600;">{post.category}</span>
      </nav>

      {/* ─── 1. ARTICLE HERO HEADER ─── */}
      <header style="margin-bottom: var(--spacing-48); border-bottom: 1px solid var(--border-medium); padding-bottom: var(--spacing-32); width: 100%;">
        <div class="os-caption" style="display: flex; gap: var(--spacing-12); font-weight: 700; color: var(--candy-pink-hover); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--spacing-16); align-items: center; flex-wrap: wrap;">
          <span class="os-badge os-badge-pink">{post.category}</span>
          <span>•</span>
          <span>{post.updatedDate}</span>
          <span>•</span>
          <span>{post.readTime}</span>
        </div>

        <h1 class="os-display" style="margin-bottom: var(--spacing-24); color: var(--ink-black);">
          {post.title}
        </h1>

        <p class="os-lead" style="max-width: 1000px; margin-bottom: var(--spacing-24);">
          {post.description}
        </p>

        {/* Author and Tag Metadata */}
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; padding-top: var(--spacing-16); border-top: 1px solid var(--border-light);">
          <div style="display: flex; align-items: center; gap: var(--spacing-12);">
            <div style="width: 38px; height: 38px; border-radius: 50%; background: var(--candy-pink-soft); border: 1px solid var(--candy-pink-border); display: flex; align-items: center; justify-content: center; font-size: 18px;">
              {post.author.avatar}
            </div>
            <div>
              <div class="os-small" style="font-weight: 700; color: var(--ink-black);">{post.author.name}</div>
              <div class="os-caption">{post.author.role}</div>
            </div>
          </div>

          <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            {post.keywords.slice(0, 5).map((kw) => (
              <span class="os-badge" style="background: #ffffff; border: 1px solid var(--border-light); font-size: var(--text-caption); color: var(--ink-secondary);">
                #{kw}
              </span>
            ))}
          </div>
        </div>
      </header>

      <div class="blog-layout-grid">
        <aside class="blog-sidebar">
          {/* ─── 2. TABLE OF CONTENTS (NetworkersHome Reference Style) ─── */}
          <nav style="margin-bottom: var(--spacing-32);">
            <span style="display: inline-block; padding: 4px 10px; font-size: 10px; font-weight: 800; color: #ffffff; background: linear-gradient(to right, #f472b6, #a81c85); border-radius: 9999px; margin-bottom: 16px; letter-spacing: 0.05em; text-transform: uppercase;">
              TABLE OF CONTENTS
            </span>
            
            <div style="display: flex; flex-direction: column; gap: 4px; width: 100%;">
              {post.tableOfContents.map((toc, index) => (
                <a href={`#${toc.id}`} class={`os-toc-link ${index === 0 ? 'active' : ''}`} style="display: block; padding: 8px 12px; border-radius: 6px; color: var(--ink-secondary); text-decoration: none; font-size: 0.85rem; line-height: 1.3; transition: all 0.15s ease;">
                  {toc.title}
                </a>
              ))}
            </div>
          </nav>
        </aside>

        <div class="blog-main-column">

      {/* ─── 3. TL;DR CALLOUT BOX ─── */}
      <section style="background: var(--candy-pink-soft); border-left: 5px solid var(--candy-pink); border-radius: 10px; border-top: 1px solid var(--candy-pink); border-right: 1px solid var(--candy-pink); border-bottom: 1px solid var(--candy-pink); padding: 28px; margin-bottom: var(--spacing-32); box-shadow: var(--shadow-sm);">
        <h3 id="tldr" style="font-size: 1.2rem; font-weight: 800; color: #a81c85; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
          <span>⚡</span> TL;DR
        </h3>
        <p style="font-size: 1.1rem; line-height: 1.7; color: var(--ink-black); margin: 0;">
          {post.tldr}
        </p>
      </section>

      {/* ─── 3.5 KEY TAKEAWAYS ─── */}
      {post.keyTakeaways && post.keyTakeaways.length > 0 && (
        <section style="margin-bottom: 24px;">
          <h3 style="font-size: 1.5rem; font-weight: 800; color: var(--ink-black); margin-bottom: 24px;">
            Key Takeaways
          </h3>
          <div style="display: flex; flex-direction: column; gap: 16px;">
            {post.keyTakeaways.map((takeaway) => (
              <div style="background: #ffffff; border: 1px solid var(--border-medium); border-left: 4px solid var(--candy-pink); border-radius: var(--radius-md); padding: 24px; box-shadow: var(--shadow-sm);">
                <h4 style="font-size: 1.15rem; font-weight: 800; color: var(--ink-black); margin-bottom: 12px;">
                  {takeaway.title}
                </h4>
                <p style="font-size: 1.05rem; line-height: 1.6; color: var(--ink-secondary); margin: 0;">
                  {takeaway.description}
                </p>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* ─── 4. ARTICLE BODY CONTENT (FORMATTED PROSE & CARDS) ─── */}
      <div class="blog-content" style="display: flex; flex-direction: column; gap: var(--spacing-32); line-height: 1.8; font-size: 1.08rem; color: var(--ink-secondary);">
        {PostContent ? <PostContent /> : <p>Content coming soon...</p>}

        {/* ─── 5. FAQ SECTION ─── */}
        {post.faqs && post.faqs.length > 0 && (
          <section class="os-card" style="background: #ffffff; border: 1px solid var(--border-medium); padding: 48px; border-radius: var(--radius-lg);">
            <h2 id="faq" class="os-h2" style="margin-bottom: 32px; color: var(--ink-black); font-size: 1.75rem; font-weight: 800;">
              Frequently Asked Questions (FAQ)
            </h2>

            <div style="display: flex; flex-direction: column; gap: 16px;">
              {post.faqs.map((faq) => (
                <details class="os-faq-item" style="border: 1px solid var(--candy-pink); border-radius: var(--radius-md); background: var(--bg-cream-alt); overflow: hidden;">
                  <summary style="padding: 20px 24px; font-size: 1.1rem; font-weight: 700; color: var(--ink-black); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; user-select: none;">
                    {faq.question}
                    <span class="os-faq-icon" style="color: var(--candy-pink); font-size: 1.5rem; font-weight: 300; transition: transform 0.3s ease;">+</span>
                  </summary>
                  <div style="padding: 24px; background: var(--candy-pink-soft); font-size: 1.05rem; line-height: 1.7; color: var(--ink-secondary); border-top: 1px solid var(--candy-pink);">
                    <p style="margin: 0;">
                      {faq.answer}
                    </p>
                  </div>
                </details>
              ))}
            </div>

            <style>
              /* Hide the default details marker (triangle) in webkit/blink */
              .os-faq-item summary::-webkit-details-marker {
                display: none;
              }
              
              /* Rotate the '+' to an 'x' when open */
              .os-faq-item[open] .os-faq-icon {
                transform: rotate(45deg);
                color: var(--ink-black);
              }

              .os-faq-item summary:hover {
                background: #f8fafc;
              }
            </style>
          </section>
        )}

        {/* ─── BRINGING IT ALL TOGETHER SECTION ─── */}
        {post.conclusion && (
          <section class="os-card" style="background: var(--candy-pink-soft); border-left: 5px solid var(--candy-pink); padding: 40px; border-radius: var(--radius-lg); margin-top: 24px; box-shadow: var(--shadow-sm);">
            <h2 id="conclusion" class="os-h2" style="margin-bottom: 24px; color: var(--ink-black); font-size: 1.75rem; font-weight: 800;">
              {post.conclusion.title}
            </h2>
            <div style="display: flex; flex-direction: column; gap: 16px; color: var(--ink-secondary); font-size: 1.1rem; line-height: 1.7;">
              {post.conclusion.content.map((paragraph, idx) => (
                <p style={`margin: 0; ${idx === post.conclusion.content.length - 1 ? 'font-weight: 600; color: var(--ink-black);' : ''}`}>
                  {paragraph}
                </p>
              ))}
            </div>
          </section>
        )}

        {/* ─── 5.5 BACKLINK ─── */}
        <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--border-medium); font-size: 1rem; color: var(--ink-secondary); text-align: center;">
          Learn more about building an autonomous AI workforce at <a href="https://ollasuper.com" style="color: var(--candy-pink); text-decoration: underline; font-weight: 600;">ollasuper.com</a>.
        </div>

        {/* ─── 6. BOTTOM ACTION CTA ─── */}
        <div style="background: #0c0f17; color: #ffffff; border: 1px solid #1e293b; border-radius: var(--radius-xl); padding: 48px; text-align: center; margin-top: 24px;">
          <span class="os-badge os-badge-pink" style="margin-bottom: 12px;">Deploy OllaSuper</span>
          <h2 style="font-size: 26px; font-weight: 800; color: #ffffff; margin-bottom: 12px;">
            Ready to build your AI workforce?
          </h2>
          <p style="font-size: 15px; color: #94a3b8; max-width: 560px; margin: 0 auto 28px;">
            Deploy intelligent, approval-gated AI employees across Research, Sales, Support, and Operations with full observability.
          </p>
          <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
            <a href="/signup" class="os-btn os-btn-primary" style="padding: 12px 28px; font-size: 15px;">
              Build Your AI Workforce →
            </a>
            <a href="/demo" class="os-btn os-btn-secondary" style="background: #1a2234; color: #ffffff; border-color: #334155; padding: 12px 24px;">
              Book a 1:1 Demo
            </a>
          </div>
        </div>

      </div>
        </div>

      </div>
    </div>
  </article>
</Layout>



<style is:global>
  .os-toc-link.active {
    background: var(--candy-pink-soft) !important;
    color: #a81c85 !important;
    font-weight: 700 !important;
  }
  .os-toc-link:hover {
    background: var(--candy-pink-soft) !important;
    color: #a81c85 !important;
  }

  .blog-layout-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 48px;
    align-items: start;
  }
  .blog-sidebar {
    position: sticky;
    top: 100px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding-right: 8px; /* space for scrollbar */
  }
  
  /* Minimal scrollbar styling for the sidebar */
  .blog-sidebar::-webkit-scrollbar {
    width: 4px;
  }
  .blog-sidebar::-webkit-scrollbar-thumb {
    background-color: var(--border-medium);
    border-radius: 4px;
  }

  .blog-main-column {
    min-width: 0;
  }
  @media (max-width: 900px) {
    .blog-layout-grid {
      grid-template-columns: 1fr;
    }
    .blog-sidebar {
      position: static !important;
      margin-bottom: 32px;
    }
  }

  /* Reference Blog Overrides */
  .blog-content p {
    font-size: 1.15rem !important;
    line-height: 1.8 !important;
    margin-bottom: 24px !important;
  }
  .blog-content h2 {
    font-size: 2.2rem !important;
    font-weight: 800 !important;
    margin-bottom: 24px !important;
    margin-top: 48px !important;
  }
</style>

<script>
  // Robust anchor link handling for the Table of Contents
  function initTocLinks() {
    const tocLinks = document.querySelectorAll('.os-toc-link');
    
    tocLinks.forEach(link => {
      // Remove any previous event listeners by cloning if necessary (not strictly needed here but safe)
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href || !href.startsWith('#')) return;
        
        const targetId = href.substring(1);
        const targetElement = document.getElementById(targetId);
        
        if (targetElement) {
          e.preventDefault(); // Stop standard browser jump
          
          // Manually scroll into view accounting for the sticky header
          const headerOffset = 100; // nav + breathing room
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
          
          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
          
          // Update the URL hash quietly
          window.history.pushState(null, '', href);
          
          // Update active state in TOC
          tocLinks.forEach(l => l.classList.remove('active'));
          link.classList.add('active');
        }
      });
    });
  }

  // Run on initial load and after any ViewTransition page swaps
  document.addEventListener('DOMContentLoaded', initTocLinks);
  document.addEventListener('astro:page-load', initTocLinks);
</script>
