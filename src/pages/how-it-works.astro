---
import Layout from "~/layouts/Layout.astro";
import Logo from "~/components/Logo.astro";

const expertSteps = [
  { n:"01", t:"Pick an Assistant",     side:"People · GTM · Ops · Data · Build · Personal",
    b:"22 chat-driven specialists across six departments. Tap a card, the right system prompt loads and the right tools are wired in. You can switch Assistants mid-chat; the new one inherits the conversation and the context. Assistants are advisory — they draft, audit, advise. They never take real-world action on their own." },
  { n:"02", t:"Drop the context",   side:"URL · Crawl · Files · Drive",
    b:"Four input modes in one chat: paste a URL (crawled in ~600 ms), upload a file (PDF · DOCX · MD · CSV up to 100 MB), connect a Drive folder, or paste text. The Assistant always shows what it's grounded in." },
  { n:"03", t:"Ask in plain English", side:"76 starter prompts · 14 tones",
    b:"US business English by default — clean, direct, no buzzwords. 120+ starter prompts across the Assistants kill the blank page. Paste your last email and say 'continue this voice' to clone tone." },
  { n:"04", t:"Memory carries",     side:"Per-project memory · opt-out anytime",
    b:"Every chat remembers the last one. The model learns whether you write short or long, whether you use 'we' or 'I', whether you cite numbers or stories. Turn it off per-chat if you need a fresh take." },
  { n:"05", t:"Ship it",            side:"MD · PDF · DOCX · HTML",
    b:"Edit inline, regenerate any block, save as a template. Export to Markdown · PDF · DOCX, or copy paste-ready HTML straight into Gmail, Confluence, Notion or whatever your team uses." },
];

const agentSteps = [
  { n:"A1", t:"Pick an Agent",         side:"6 production workers · scheduled · approval-gated",
    b:"6 ⚡ Agents are different from the 22 ○ Assistants. They run on a schedule (every 30 min, every 6 h) or on manual trigger. They call real tools — ollagraph scrapes, WHOIS, AEO audits — and write to a workspace you can read. Outbound SDR, SEO Auditor, Content Publisher, Inbox Triage, Pipeline Curator, Deep Research." },
  { n:"A2", t:"Wire the inputs",       side:"deals.yaml · inbox/ · audit_targets/",
    b:"Each Agent reads from a workspace path: Pipeline Curator wants pipeline/deals.yaml; Inbox Triage scans inbox/unread/; SEO Auditor reads audit_targets.yaml. You drop the data, the Agent picks it up on the next run. Drag and drop from Drive or upload directly." },
  { n:"A3", t:"Watch the schedule",    side:"cron-style · run on demand · pause anytime",
    b:"Each Agent has a built-in schedule. Outbound SDR every 30 min; SEO Auditor every 6 h; Inbox Triage every 15 min; Pipeline Curator every 4 h. Deep Research and Content Publisher are manual-trigger only. Pause any Agent with one click. See the next scheduled run, the last 10 runs, and the cost burned." },
  { n:"A4", t:"Approve before send",   side:"every outbound action queued",
    b:"Action-taking Agents (Outbound SDR, Content Publisher, Inbox Triage) write to outbox/drafts/ and stop. You read the draft, edit it, click approve. Nothing leaves the platform without that click. Advisory Agents (SEO Auditor, Pipeline Curator, Deep Research) skip this — they only produce reports for you." },
  { n:"A5", t:"Hand off across Agents", side:"shared workspace · handoffs/<agent>/",
    b:"Deep Research can drop a brief at handoffs/outbound-sdr/ and Outbound SDR picks it up. Content Publisher hands off to SEO Auditor for post-publish monitoring. Assistants can hand off to Agents and vice-versa via shared memory namespaces. The 30 + 6 work as one workforce, not two silos." },
];
---
<Layout current="how" title="How OllaSuper Works — Assistants + Agents" description="22 chat-driven Assistants. 6 scheduled Agents. 200M proxies. 4,000+ tools. Memory across sessions. Approval gates on every outbound action.">

  {/* HERO */}
  <section class="os-section" style="position: relative; overflow: hidden; background: linear-gradient(180deg, var(--warm-cream) 0%, #fffbf2 100%);">
    <div class="qw-hero-bg"></div>
    <div class="os-container" style="position: relative; text-align: center;">
      <div class="os-eyebrow" style="margin-bottom: var(--spacing-24);">
        <span class="os-badge os-badge-pink" style="padding: 4px 12px;">How it works</span>
      </div>
      <h1 class="os-display" style="margin-bottom: var(--spacing-24); max-width: 1000px; margin-inline: auto;">
        Two primitives.<br/><span style="color: var(--ink-secondary);">One workforce.</span>
      </h1>
      <p class="os-lead" style="max-width: 700px; margin-bottom: var(--spacing-48); margin-inline: auto;">
        OllaSuper isn't 19 tools wired together. It's <span style="color: var(--ink-black); font-weight: 600;">22 chat-driven Assistants</span> that advise,
        and <span style="color: var(--ink-black); font-weight: 600;">6 scheduled Agents</span> that act with your approval — both running on the same workspace, files, and memory.
      </p>
      <div style="display: flex; gap: var(--spacing-16); justify-content: center; flex-wrap: wrap;">
        <a href="#experts-flow" class="os-btn os-btn-secondary" style="padding: 12px 20px; font-size: var(--text-small);">○ How Assistants work</a>
        <a href="#agents-flow" class="os-btn os-btn-secondary" style="padding: 12px 20px; font-size: var(--text-small);">⚡ How Agents work</a>
      </div>
    </div>
  </section>

  {/* EXPERTS FLOW — 5 stages */}
  <section id="experts-flow" class="os-section" style="border-top: 1px solid var(--border-light); background: #ffffff;">
    <div class="os-container">
      <div class="os-section-header" style="border-bottom: 2px solid var(--border-medium); padding-bottom: var(--spacing-24); margin-bottom: var(--spacing-32); text-align: left; align-items: flex-start; max-width: 100%; margin-inline: 0;">
        <div class="os-eyebrow">○ Assistants · chat-driven · advisory only</div>
        <h2 class="os-h2">The 22 Assistants — pick, ground, ask, ship.</h2>
        <p class="os-lead" style="max-width: 620px;">
          The default chat surface. 22 Assistants across People, GTM, Ops, Data, Build, and Personal.
          They draft, audit, advise — they never send a real email or modify a real system on their own.
        </p>
      </div>
      {expertSteps.map(s => (
        <div class="os-grid-2" style="padding: var(--spacing-32) 0; border-bottom: 1px solid var(--border-light); align-items: flex-start;">
          <div>
            <div style="display: inline-flex; align-items: center; gap: var(--spacing-12);">
              <span style="display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 999px; background: rgba(255, 131, 218, 0.15); color: var(--candy-pink); font-family: var(--font-mono); font-weight: 700; font-size: var(--text-caption);">{s.n}</span>
              <span class="os-caption" style="font-weight: 600;">Step {s.n}</span>
            </div>
            <div class="os-small" style="margin-top: var(--spacing-12); font-weight: 600;">{s.side}</div>
          </div>
          <div>
            <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">{s.t}</h3>
            <p class="os-small" style="max-width: 720px;">{s.b}</p>
          </div>
        </div>
      ))}
   <section id="agents-flow" class="os-section" style="border-top: 1px solid var(--border-light); background: var(--warm-cream);">
    <div class="os-container">
      <div class="os-section-header" style="border-bottom: 2px solid var(--border-medium); padding-bottom: var(--spacing-24); margin-bottom: var(--spacing-32); text-align: left; align-items: flex-start; max-width: 100%; margin-inline: 0;">
        <div class="os-eyebrow" style="color: #d97706;">⚡ Agents · scheduled · action-taking · approval-gated</div>
        <h2 class="os-h2">The 6 Agents — schedule, wire, watch, approve, hand off.</h2>
        <p class="os-lead" style="max-width: 640px;">
          Agents go where Assistants can't — they run on cron-style schedules, call real tools (ollagraph + memory + filesystem),
          write to a workspace you can read, and queue every outbound action for your approval before it leaves the platform.
          See <a href="/agents" style="color: var(--candy-pink); font-weight: 600;">/agents</a> for the full list.
        </p>
      </div>
      {agentSteps.map(s => (
        <div class="os-grid-2" style="padding: var(--spacing-32) 0; border-bottom: 1px solid var(--border-light); align-items: flex-start;">
          <div>
            <div style="display: inline-flex; align-items: center; gap: var(--spacing-12);">
              <span style="display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 999px; background: rgba(217, 119, 6, 0.1); color: #d97706; font-family: var(--font-mono); font-weight: 700; font-size: var(--text-caption);">{s.n}</span>
              <span class="os-caption" style="font-weight: 600;">Step {s.n}</span>
            </div>
            <div class="os-small" style="margin-top: var(--spacing-12); font-weight: 600;">{s.side}</div>
          </div>
          <div>
            <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">{s.t}</h3>
            <p class="os-small" style="max-width: 720px;">{s.b}</p>
          </div>
        </div>
      ))}
    </div>
  </section>p>
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* INTELLIGENCE ROUTING — model-agnostic */}
  <section class="os-section" style="background: var(--bg-cream-alt); border-top: 1px solid var(--border-light); border-bottom: 1px solid var(--border-light);">
    <div class="os-container">
      <div class="os-grid-2" style="align-items: center;">
        <div>
          <div class="os-eyebrow">Intelligence routing</div>
          <h2 class="os-h2">
            Right model.<br/>Every task.
          </h2>
          <p class="os-lead" style="max-width: 420px;">
            All inference is routed through OpenRouter — never Anthropic.
            Assistants mix OpenAI, Gemini, and Mistral based on the task.
            Agents pin specific models (Tongyi DeepResearch for the SEO and research workloads; GPT-4o-mini and GPT-4o for the rest).
            You don't pick. You don't tune.
          </p>
        </div>
        <div class="os-grid-1" style="gap: var(--spacing-16);">
          {[
            {n:"Long-form",  v:"Drafting + code",      w:"Frontier model tuned for sustained output and structured generation."},
            {n:"Reasoning",  v:"Editing + analysis",   w:"Frontier model tuned for long-context reasoning and judgment."},
            {n:"Research",   v:"Vision + summarisation", w:"Frontier model tuned for multimodal research and grounded summaries."},
          ].map((m) => (
            <div class="os-card os-card-cream os-card-symmetric" style="padding: var(--spacing-24);">
              <div class="os-caption" style="font-weight: 700; text-transform: uppercase;">{m.n}</div>
              <div class="os-h4" style="margin-top: var(--spacing-8);">{m.v}</div>
              <div class="os-small" style="margin-top: var(--spacing-12);">{m.w}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* SECURITY — 4-col soft cards */}
  <section class="os-section">
    <div class="os-container">
      <div class="os-section-header" style="align-items: flex-start; text-align: left; margin-bottom: var(--spacing-32); max-width: 100%; margin-inline: 0;">
        <div class="os-eyebrow">Your data</div>
        <h2 class="os-h2">
          Your files don't train anyone's model. <span style="color: var(--ink-secondary);">Including ours.</span>
        </h2>
      </div>
      <div class="os-grid-4">
        {[
          {t:"DPDP-aligned",            d:"India's Digital Personal Data Protection Act — designed-in, not bolted on."},
          {t:"Per-workspace isolation", d:"Files and chats scoped to your workspace. Nobody else sees them."},
          {t:"No training on your data",d:"Not our vendors'. Not ours. Inference only, per contract."},
          {t:"Delete = gone",           d:"Hit delete and it's purged from storage and the LLM's logs within 30 days."},
        ].map(c => (
          <div class="os-card os-card-cream os-card-symmetric" style="padding: var(--spacing-24);">
            <h3 class="os-h4" style="margin-bottom: var(--spacing-8);">{c.t}</h3>
            <p class="os-small">{c.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* CTA — soft card */}
  <section class="os-section" style="padding-top: 0;">
    <div class="os-container">
      <div class="os-card os-card-cream os-card-symmetric" style="display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-24); padding: var(--spacing-32) var(--spacing-48); flex-direction: row; border: 1px solid var(--border-medium); flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: var(--spacing-24); flex-wrap: wrap;">
          <Logo size={48} />
          <div>
            <h2 class="os-h2" style="margin-bottom: 4px;">
              Open a chat. Pick an Assistant or an Agent. <span style="color: var(--candy-pink);">Ship the work.</span>
            </h2>
            <div class="os-small" style="font-weight: 500;">No card · Free tier · 30 ○ Assistants + 6 ⚡ Agents · 200M proxies · 4,000+ tools</div>
          </div>
        </div>
        <a href="/signup" class="os-btn os-btn-primary" style="white-space: nowrap;">Start free →</a>
      </div>
    </div>
  </section>

</Layout>
