---
import Layout from "~/layouts/Layout.astro";

const tiers = [
  {
    name: "Starter",
    price: "$0",
    interval: "forever free",
    badge: "Free Tier",
    tagline: "For individual founders and small teams exploring AI employees.",
    features: [
      "1 Active AI Employee (Research or Support)",
      "50,000 credits / month included",
      "Read-only autonomous execution",
      "Web scraping & public registry MCP tools",
      "Basic execution trace logs (7-day retention)",
      "Community Discord & Documentation support"
    ],
    cta: "Start Free",
    ctaHref: "/signup",
    isPrimary: false,
  },
  {
    name: "Growth",
    price: "$49",
    interval: "per month",
    badge: "Most Popular",
    tagline: "For high-velocity revenue, marketing, and operations squads.",
    features: [
      "Up to 5 Active AI Employees (Sales, Marketing, Research)",
      "1,500,000 credits / month included",
      "Human-in-the-Loop Slack & Dashboard approval gates",
      "Full CRM two-way sync (Salesforce & HubSpot)",
      "Deep Observability traces (30-day retention)",
      "Continuous event & cron schedule automation",
      "Priority email & chat support"
    ],
    cta: "Deploy Growth Squad →",
    ctaHref: "/signup?plan=growth",
    isPrimary: true,
  },
  {
    name: "Scale",
    price: "$199",
    interval: "per month",
    badge: "High Autonomy",
    tagline: "For scaling companies deploying full autonomous departments.",
    features: [
      "Unlimited AI Employees across all 6 departments",
      "10,000,000 credits / month included",
      "Custom MCP Tool Server registration",
      "Deterministic golden dataset test runner",
      "Team RBAC & workspace isolation",
      "Full Observability with 90-day retention",
      "Dedicated Slack channel with solutions architect"
    ],
    cta: "Upgrade to Scale →",
    ctaHref: "/signup?plan=scale",
    isPrimary: false,
  },
  {
    name: "Enterprise",
    price: "Custom",
    interval: "billed annually",
    badge: "Private VPC",
    tagline: "For regulated organizations requiring sovereign data isolation.",
    features: [
      "Single-Tenant Private VPC or On-Prem deployment",
      "Zero-Data Retention cryptographic SLA",
      "Custom fine-tuned domain models & private adapters",
      "SOC2 Type II & HIPAA compliance attestation",
      "Custom ERP / mainframe connector development",
      "24/7/365 Dedicated SRE support with 15-min SLA"
    ],
    cta: "Talk to Enterprise Sales",
    ctaHref: "/demo",
    isPrimary: false,
  }
];

const faqs = [
  {
    q: "What is an AI Employee and how does it differ from traditional software?",
    a: "An AI Employee is an autonomous agent with persistent memory, tool-calling capabilities (via Model Context Protocol), and the ability to execute multi-step business goals without continuous human prompting. Unlike simple bots, they can browse the web, query databases, draft communications, and request human approval for high-risk actions."
  },
  {
    q: "How does Human-in-the-Loop approval work?",
    a: "You define approval policies per employee or per action type. Read-only actions (research, data extraction, analysis) run autonomously. High-risk write actions (sending emails, publishing articles, updating database records, or initiating financial transactions) trigger 1-click approval cards in Slack or your OllaSuper dashboard."
  },
  {
    q: "What is Model Context Protocol (MCP)?",
    a: "MCP is the open standard for connecting AI models to external tools, databases, and APIs. OllaSuper provides 100+ native MCP servers (Salesforce, HubSpot, Stripe, PostgreSQL, Notion, GitHub) and allows you to attach your own internal private MCP servers."
  },
  {
    q: "Do you train on customer proprietary data?",
    a: "Never. OllaSuper enforces a strict Zero-Data Retention policy for model training. Customer prompts, files, and tool execution payloads are processed ephemerally in isolated sandboxes and are never used to train foundation models."
  },
  {
    q: "Can I cancel or change plans anytime?",
    a: "Yes. You can upgrade, downgrade, or cancel your subscription at any time directly from your billing dashboard with zero lock-in."
  }
];
---

<Layout
  title="Pricing & Plans — OllaSuper AI Workforce Platform"
  description="Transparent, value-driven pricing. Deploy specialized AI employees with full observability, human oversight, and Model Context Protocol."
  current="pricing"
>
  <article class="os-section" style="background: var(--warm-cream); padding-top: 64px; padding-bottom: 100px;">
    <div class="os-container">
      
      {/* Header */}
      <div class="os-section-header">
        <div class="os-eyebrow" style="margin-bottom: var(--spacing-12);">
          <span class="os-live-dot"></span> TRANSPARENT PRICING
        </div>
        <h1 class="os-h1" style="margin-bottom: var(--spacing-16);">
          Predictable pricing for your AI workforce.
        </h1>
        <p class="os-lead">
          Start free with no credit card required. Upgrade as your autonomous employee fleet expands across departments.
        </p>
      </div>

      {/* Pricing Cards Grid */}
      <div class="os-grid-4" style="margin-bottom: var(--spacing-80); align-items: stretch;">
        {tiers.map((tier) => (
          <div class={`os-card os-card-symmetric ${tier.isPrimary ? 'os-card-cream' : ''}`} style={`border: ${tier.isPrimary ? '2px solid var(--candy-pink)' : '1px solid var(--border-medium)'}; background: #ffffff; position: relative; padding: var(--spacing-32); display: flex; flex-direction: column; height: 100%;`}>
            
            {tier.isPrimary && (
              <div style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--candy-pink); color: var(--ink-black); font-size: var(--text-caption); font-weight: 700; padding: 3px 12px; border-radius: var(--radius-pill); text-transform: uppercase;">
                Recommended
              </div>
            )}

            <div style="flex: 1; display: flex; flex-direction: column;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-12);">
                <h2 class="os-h3" style="font-weight: 800; color: var(--ink-black);">{tier.name}</h2>
                <span class="os-badge os-badge-pink" style="font-size: 10px;">{tier.badge}</span>
              </div>

              <p class="os-small" style="margin-bottom: var(--spacing-20); flex-shrink: 0;">
                {tier.tagline}
              </p>

              <div style="margin-bottom: var(--spacing-24); padding-bottom: var(--spacing-20); border-bottom: 1px solid var(--border-light); flex-shrink: 0;">
                <div style="font-size: 38px; font-weight: 900; color: var(--ink-black); letter-spacing: -0.03em;">
                  {tier.price}
                </div>
                <div class="os-caption">{tier.interval}</div>
              </div>

              {/* Feature Checklist */}
              <div style="margin-bottom: var(--spacing-24); flex: 1;">
                <div class="os-caption" style="font-weight: 700; text-transform: uppercase; margin-bottom: 10px;">What's Included</div>
                <ul style="list-style: none; display: flex; flex-direction: column; gap: 8px; font-size: var(--text-small); color: var(--ink-secondary);">
                  {tier.features.map((feat) => (
                    <li style="display: flex; align-items: flex-start; gap: 8px;">
                      <span style="color: var(--status-green); font-weight: 700;">✓</span>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div style="margin-top: auto; padding-top: var(--spacing-24);">
              <a href={tier.ctaHref} class={`os-btn ${tier.isPrimary ? 'os-btn-primary' : 'os-btn-secondary'}`} style="width: 100%; padding: 12px; text-align: center;">
                {tier.cta}
              </a>
            </div>

          </div>
        ))}
      </div>

      {/* FAQ Section */}
      <div style="width: 100%; margin: 0 auto;">
        <div class="os-section-header">
          <h2 class="os-h2">
            Frequently Asked Questions
          </h2>
        </div>

        <div style="display: flex; flex-direction: column; gap: 16px;">
          {faqs.map((faq) => (
            <details class="os-faq-item" style="border: 1px solid var(--candy-pink); border-radius: var(--radius-md); background: var(--bg-cream-alt); overflow: hidden;">
              <summary style="padding: 20px 24px; font-size: 1.1rem; font-weight: 700; color: var(--ink-black); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; user-select: none;">
                {faq.q}
                <span class="os-faq-icon" style="color: var(--candy-pink); font-size: 1.5rem; font-weight: 300; transition: transform 0.3s ease;">+</span>
              </summary>
              <div style="padding: 24px; background: var(--candy-pink-soft); font-size: 1.05rem; line-height: 1.7; color: var(--ink-secondary); border-top: 1px solid var(--candy-pink);">
                <p style="margin: 0;">
                  {faq.a}
                </p>
              </div>
            </details>
          ))}
        </div>

        <style>
          /* Hide the default details marker (triangle) in webkit/blink */
          .os-faq-item summary::-webkit-details-marker {
            display: none;
          }
          
          /* Rotate the '+' to an 'x' when open */
          .os-faq-item[open] .os-faq-icon {
            transform: rotate(45deg);
            color: var(--ink-black);
          }

          .os-faq-item summary:hover {
            background: #f8fafc;
          }
        </style>
      </div>

    </div>
  </article>
</Layout>
