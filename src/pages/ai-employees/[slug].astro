---
import Layout from "~/layouts/Layout.astro";
import { AI_EMPLOYEES, type AIEmployee } from "~/data/employees";

export function getStaticPaths() {
  return AI_EMPLOYEES.map((employee) => ({
    params: { slug: employee.slug },
    props: { employee },
  }));
}

interface Props {
  employee: AIEmployee;
}

const { employee } = Astro.props;
---

<Layout
  title={`${employee.name} — Autonomous AI Employee | OllaSuper`}
  description={employee.purpose}
  current="ai-employees"
>
  {/* Machine-Readable Semantic Schema */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": employee.name,
    "applicationCategory": "BusinessApplication",
    "description": employee.purpose,
    "featureList": employee.capabilities,
    "operatingSystem": "Web, Model Context Protocol",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })} />

  <article class="os-section" style="background: var(--warm-cream); padding-top: var(--spacing-64); padding-bottom: 100px;">
    <div class="os-container">
      
      {/* Breadcrumb */}
      <nav aria-label="Breadcrumb" class="os-small" style="color: var(--ink-muted); margin-bottom: var(--spacing-24); display: flex; gap: var(--spacing-8);">
        <a href="/" style="color: inherit; text-decoration: none;">Home</a>
        <span>/</span>
        <a href="/ai-employees" style="color: inherit; text-decoration: none;">AI Employees</a>
        <span>/</span>
        <span style="color: var(--ink-black); font-weight: 600;">{employee.name}</span>
      </nav>

      {/* Hero Header */}
      <div class="os-card os-card-cream os-card-symmetric" style={
        employee.slug === 'research' ? 'background: linear-gradient(rgba(255,255,255,0), rgba(255,255,255,0)), url(/images/research_bg.png); background-size: cover; background-position: center; border: 1px solid var(--candy-pink); padding: var(--spacing-48); box-shadow: var(--shadow-sm); margin-bottom: var(--spacing-48);' : 
        employee.slug === 'sales' ? 'background: linear-gradient(rgba(255,255,255,0.5), rgba(255,255,255,0.5)), url(/images/sales_bg.png); background-size: cover; background-position: center; border: 1px solid var(--candy-pink); padding: var(--spacing-48); box-shadow: var(--shadow-sm); margin-bottom: var(--spacing-48);' : 
        employee.slug === 'marketing' ? 'background: linear-gradient(rgba(255,255,255,0.5), rgba(255,255,255,0.5)), url(/images/marketing_bg.png); background-size: cover; background-position: center; border: 1px solid var(--candy-pink); padding: var(--spacing-48); box-shadow: var(--shadow-sm); margin-bottom: var(--spacing-48);' : 
        employee.slug === 'customer-support' ? 'background: linear-gradient(rgba(255,255,255,0.5), rgba(255,255,255,0.5)), url(/images/support_bg.png); background-size: cover; background-position: center; border: 1px solid var(--candy-pink); padding: var(--spacing-48); box-shadow: var(--shadow-sm); margin-bottom: var(--spacing-48);' : 
        employee.slug === 'operations' ? 'background: linear-gradient(rgba(255,255,255,0.5), rgba(255,255,255,0.5)), url(/images/operations_bg.png); background-size: cover; background-position: center; border: 1px solid var(--candy-pink); padding: var(--spacing-48); box-shadow: var(--shadow-sm); margin-bottom: var(--spacing-48);' : 
        employee.slug === 'custom' ? 'background: linear-gradient(rgba(255,255,255,0.5), rgba(255,255,255,0.5)), url(/images/custom_bg.png); background-size: cover; background-position: center; border: 1px solid var(--candy-pink); padding: var(--spacing-48); box-shadow: var(--shadow-sm); margin-bottom: var(--spacing-48);' : 
        'background: #ffffff; border: 1px solid var(--candy-pink); padding: var(--spacing-48); box-shadow: var(--shadow-sm); margin-bottom: var(--spacing-48);'
      }>
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: var(--spacing-24); margin-bottom: var(--spacing-24);">
          <div style="display: flex; align-items: center; gap: 20px;">
            <div style="width: 64px; height: 64px; border-radius: 18px; background: var(--bg-cream-alt); border: 1px solid var(--border-light); display: flex; align-items: center; justify-content: center; font-size: 32px;">
              {employee.avatarIcon}
            </div>
            <div>
              <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                <h1 class="os-h3">{employee.name}</h1>
                <span class="os-badge os-badge-pink">{employee.badge}</span>
              </div>
              <div class="os-small" style="font-weight: 500;">{employee.role}</div>
            </div>
          </div>

          <div style="display: flex; gap: var(--spacing-12); align-items: center;">
            <a href="/demo" class="os-btn os-btn-secondary" style="padding: 12px 24px;">
              Simulate Live Run
            </a>
            <a href="/signup" class="os-btn os-btn-primary" style="padding: 12px 28px;">
              Deploy to Workforce →
            </a>
          </div>
        </div>

        <p class="os-body" style="max-width: 840px;">
          {employee.purpose}
        </p>

        {/* Stats Strip */}
        <div class="os-grid-3" style="margin-top: var(--spacing-32); padding-top: var(--spacing-24); border-top: 1px solid var(--border-light);">
          <div>
            <div class="os-caption" style="font-weight: 700; text-transform: uppercase;">Average Time Saved</div>
            <div class="os-h4">{employee.stats.avgTimeSaved}</div>
          </div>
          <div>
            <div class="os-caption" style="font-weight: 700; text-transform: uppercase;">Success Rate</div>
            <div class="os-h4" style="color: var(--status-green);">{employee.stats.successRate}</div>
          </div>
          <div>
            <div class="os-caption" style="font-weight: 700; text-transform: uppercase;">Governance Mode</div>
            <div class="os-h4">{employee.approvalMode}</div>
          </div>
        </div>
      </div>

      {/* Main Grid: Details & Specifications */}
      <div class="os-grid-2" style="margin-bottom: 32px;">
        
        {/* Capabilities */}
        <section class="os-card os-card-cream" style="background: #ffffff; border: 1px solid var(--candy-pink); height: 100%; display: flex; flex-direction: column;">
          <h2 style="font-size: 18px; font-weight: 700; color: var(--ink-black); margin-bottom: 8px;">
            Core Capabilities
          </h2>
          <p style="font-size: 14px; color: var(--ink-secondary); margin-bottom: 24px; line-height: 1.5;">
            This AI employee is pre-configured with a specialized skill set designed to execute complex, multi-step workflows autonomously.
          </p>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 14px; color: var(--ink-secondary);">
            {employee.capabilities.map((cap) => (
              <li style="display: flex; align-items: flex-start; gap: 10px;">
                <span style="color: var(--status-green); font-weight: 700;">✓</span>
                <span>{cap}</span>
              </li>
            ))}
          </ul>
        </section>

        {/* Inputs & Outputs */}
        <section class="os-card os-card-cream" style="background: #ffffff; border: 1px solid var(--candy-pink); height: 100%; display: flex; flex-direction: column;">
          <h2 style="font-size: 18px; font-weight: 700; color: var(--ink-black); margin-bottom: 8px;">
            Inputs & Deliverables
          </h2>
          <p style="font-size: 14px; color: var(--ink-secondary); margin-bottom: 24px; line-height: 1.5;">
            Provide the necessary context and watch the employee generate ready-to-use, production-grade assets.
          </p>
          
          <div style="margin-bottom: 18px;">
            <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 6px;">Accepted Inputs</div>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--ink-secondary);">
              {employee.inputs.map((inp) => (
                <li style="display: flex; align-items: center; gap: 6px;">
                  <span>→</span> <span>{inp}</span>
                </li>
              ))}
            </ul>
          </div>

          <div style="border-top: 1px solid var(--border-light); padding-top: 14px;">
            <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 6px;">Produced Deliverables</div>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--ink-secondary);">
              {employee.outputs.map((out) => (
                <li style="display: flex; align-items: center; gap: 6px;">
                  <span style="color: var(--status-green);">✓</span> <span>{out}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        {/* Workflow Execution Pipeline */}
        <section class="os-card os-card-cream" style="background: #ffffff; border: 1px solid var(--candy-pink); height: 100%; display: flex; flex-direction: column;">
          <h2 style="font-size: 18px; font-weight: 700; color: var(--ink-black); margin-bottom: 8px;">
            Autonomous Execution Sequence
          </h2>
          <p style="font-size: 14px; color: var(--ink-secondary); margin-bottom: 24px; line-height: 1.5;">
            Watch how this employee breaks down a high-level goal into a deterministic sequence of actions, tool calls, and verifications.
          </p>
          <div style="display: flex; flex-direction: column; gap: 16px;">
            {employee.workflowSteps.map((step) => (
              <div style="border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 16px; background: var(--bg-cream-alt);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                  <span style="font-weight: 700; font-size: 14px; color: var(--ink-black);">
                    Step {step.stepNumber}: {step.name}
                  </span>
                  <span style="font-family: var(--font-mono); font-size: 11px; color: #2563eb; background: #eff6ff; padding: 2px 6px; border-radius: 4px;">
                    {step.toolUsed}
                  </span>
                </div>
                <p style="font-size: 13px; color: var(--ink-secondary); margin-bottom: 8px;">{step.action}</p>
                {step.outputPreview && (
                  <div style="font-family: var(--font-mono); font-size: 11px; color: #059669; background: #ecfdf5; padding: 6px 10px; border-radius: 4px;">
                    ↳ {step.outputPreview}
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>

        {/* Supported MCP Tools */}
        <section class="os-card os-card-cream" style="background: #ffffff; border: 1px solid var(--candy-pink); height: 100%; display: flex; flex-direction: column;">
          <h2 style="font-size: 18px; font-weight: 700; color: var(--ink-black); margin-bottom: 8px;">
            Connected MCP Tools
          </h2>
          <p style="font-size: 14px; color: var(--ink-secondary); margin-bottom: 20px; line-height: 1.5;">
            This employee has native access to the following integrations via the open Model Context Protocol.
          </p>
          <div style="display: flex; flex-direction: column; gap: 10px;">
            {employee.tools.map((t) => (
              <div style="padding: 10px 12px; border-radius: var(--radius-sm); background: var(--bg-cream-alt); border: 1px solid var(--border-light);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                  <span style="font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: var(--ink-black);">{t.name}</span>
                  <span class="os-badge" style="font-size: 10px; background: #ffffff; border: 1px solid var(--border-light);">{t.category}</span>
                </div>
                <div style="font-size: 12px; color: var(--ink-muted);">{t.description}</div>
              </div>
            ))}
          </div>
        </section>

      </div>

      {/* Sample Production Run Box */}
      <section class="os-card os-card-cream" style="border: 1px solid var(--candy-pink); width: 100%; box-shadow: 0 8px 32px rgba(255, 131, 218, 0.08);">
        <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--candy-pink); margin-bottom: 8px;">
          Verified Sample Run
        </div>
        <div style="font-size: 14px; color: var(--ink-black); font-weight: 600; margin-bottom: 16px;">
          "{employee.sampleRun.prompt}"
        </div>
        <div style="font-size: 13px; color: #16a34a; font-weight: 500; line-height: 1.5; background: rgba(22, 163, 74, 0.08); border: 1px solid rgba(22, 163, 74, 0.2); padding: 12px 16px; border-radius: 8px; margin-bottom: 16px;">
          ✓ {employee.sampleRun.resultSummary}
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 12px; color: var(--ink-secondary); font-family: var(--font-mono); font-weight: 500;">
          <span>Time: {employee.sampleRun.executionTime}</span>
          <span>Approval: {employee.sampleRun.humanApprovalRequired ? 'Required' : 'Bypassed'}</span>
        </div>
      </section>

    </div>

      </div>

    </div>
  </article>
</Layout>
