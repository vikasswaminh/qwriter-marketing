---
import Layout from "~/layouts/Layout.astro";
import ExpertGlyph from "~/components/ExpertGlyph.astro";
import { experts, departments } from "~/data/experts";
import { marked } from "marked";

export async function getStaticPaths() {
  return experts.map(e => ({ params: { slug: e.slug }, props: { expert: e } }));
}

const { expert } = Astro.props as { expert: typeof experts[number] };
const dept = departments[expert.department];
const related = expert.pairs
  .map(slug => experts.find(e => e.slug === slug))
  .filter((e): e is typeof experts[number] => Boolean(e));
const promptUrl = (prompt: string) =>
  `/signup?expert=${expert.slug}&prompt=${encodeURIComponent(prompt)}`;

// Render the sample chat content as HTML
marked.setOptions({ gfm: true, breaks: false });
const assistantHtml = marked.parse(expert.sample.assistant) as string;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": expert.name,
  "name": `${expert.name} — OllaSuper`,
  "description": expert.oneliner,
  "provider": { "@type": "Organization", "name": "OllaSuper", "url": "https://ollasuper.com" },
  "areaServed": "Worldwide",
  "url": `https://ollasuper.com/experts/${expert.slug}`,
  "category": dept.label,
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": `${expert.short} capabilities`,
    "itemListElement": expert.tasks.flatMap(group => group.items.map(item => ({
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": item, "category": group.group }
    })))
  }
};
---
<Layout
  current="experts"
  title={`${expert.name} — OllaSuper`}
  description={expert.oneliner}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <style>
    .os-expert-card {
      background: #ffffff;
      border: 1px solid var(--border-medium);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      transition: box-shadow 0.2s ease, transform 0.2s ease;
    }
    .os-expert-link-card {
      background: #ffffff;
      border: 1px solid var(--border-medium);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      transition: all 0.2s ease;
      cursor: pointer;
    }
    .os-expert-link-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
      border-color: var(--text-primary);
    }
    .os-expert-prompt-container:hover .os-expert-prompt-content {
      display: block !important;
    }
  </style>

  {/* MAIN UNIFIED LAYOUT - Tighter spacing for density */}
  <main style="padding: 24px 0 96px 0; background: var(--bg-primary); min-height: 100vh;">
    <div class="os-container">
      
      {/* BREADCRUMB */}
      <div style="font-weight: 600; font-size: 13px; margin-bottom: 24px; padding: 8px 16px; background: rgba(255,255,255,0.7); backdrop-filter: blur(12px); border-radius: 999px; display: inline-flex; align-items: center; border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
        <a href="/" style="color: var(--text-secondary); text-decoration: none; transition: color 0.2s ease;" onmouseover="this.style.color='var(--text-primary)'" onmouseout="this.style.color='var(--text-secondary)'">Home</a>
        <span style="margin: 0 var(--spacing-12); color: var(--border-medium);">/</span>
        <a href="/experts" style="color: var(--text-secondary); text-decoration: none; transition: color 0.2s ease;" onmouseover="this.style.color='var(--text-primary)'" onmouseout="this.style.color='var(--text-secondary)'">Experts</a>
        <span style="margin: 0 var(--spacing-12); color: var(--border-medium);">/</span>
        <span style="color: var(--text-primary);">{expert.name}</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 32px;">
        
        {/* HERO */}
        <div class="os-grid-2" style="align-items: center; gap: 32px;">
          <div>
            <div class="os-small" style="display: inline-flex; align-items: center; gap: var(--spacing-8); padding: 6px 14px; background: #ffffff; border: 1px solid var(--border-medium); border-radius: 999px; font-weight: 700; font-size: 13px; color: var(--text-primary); margin-bottom: 16px; box-shadow: var(--shadow-sm);">
              <span style={`width: 10px; height: 10px; border-radius: 999px; background: ${expert.color};`}></span>
              {dept.label} <span style="color: var(--border-medium); font-weight: 400;">·</span> Expert
            </div>
            <h1 class="os-display" style="line-height: 1.1; margin-bottom: 16px;">{expert.name}</h1>
            <p class="os-lead" style="max-width: 540px; font-size: 1.15rem; color: var(--text-secondary); line-height: 1.5;">
              {expert.oneliner}
            </p>
            <div style="display: flex; gap: 12px; margin-top: 24px; flex-wrap: wrap;">
              <a href="https://app.ollasuper.com/login" class="os-btn" style="background: var(--text-primary); color: white; border: none; font-weight: 700; padding: 14px 28px; font-size: 1.05rem; box-shadow: var(--shadow-md); transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                Hire {expert.short} — Start free →
              </a>
              <a href="/experts" class="os-btn os-btn-secondary" style="background: white; padding: 14px 24px; font-size: 1.05rem; font-weight: 600;">All 80 agents</a>
            </div>
          </div>

          <div style="display: flex; align-items: center; justify-content: center; position: relative;">
            <div style={`position: absolute; inset: 0; background: radial-gradient(50% 50% at 50% 50%, ${expert.color}25, transparent 80%); filter: blur(32px); transform: scale(1.1); z-index: 0;`}></div>
            <div class="os-expert-card" style="position: relative; padding: 48px; border-radius: 24px; display: flex; align-items: center; justify-content: center; width: 100%; max-width: 360px; z-index: 1;">
              <ExpertGlyph slug={expert.slug} color={expert.color} size={200} flat={true} />
            </div>
          </div>
        </div>

        {/* CONTENT STACK */}
        <div style="display: flex; flex-direction: column; gap: 40px;">
          
          {/* STARTER PROMPTS */}
          <div>
            <div style="margin-bottom: 20px; display: flex; align-items: flex-end; justify-content: space-between;">
              <div>
                <h2 class="os-h2" style="font-size: 1.8rem; letter-spacing: -0.02em;">Starter prompts</h2>
                <p style="color: var(--text-secondary); margin-top: 6px; font-size: 1.05rem;">4 ways to start with {expert.short}. Click any to open in the app.</p>
              </div>
            </div>
            <div class="os-grid-4" style="gap: 16px;">
              {expert.starters.map(c => (
                <div class="os-expert-link-card" style="display: flex; flex-direction: column; padding: 20px;">
                  <a href={promptUrl(c.prompt)} style="display: block; color: var(--text-primary); text-decoration: none; flex: 1;">
                    <div style="display: flex; justify-content: space-between; gap: 12px; align-items: flex-start;">
                      <div style="font-weight: 800; font-size: 16px; letter-spacing: -0.01em; line-height: 1.3; color: var(--text-primary);">{c.title}</div>
                      <span style={`color: ${expert.color}; font-weight: 700; font-size: 18px; line-height: 1;`}>→</span>
                    </div>
                    <div style="margin-top: 10px; font-size: 14px; color: var(--text-secondary); line-height: 1.45;">{c.tagline}</div>
                  </a>
                  <div class="os-expert-prompt-container" style="margin-top: 20px; border-top: 1px solid var(--border-light); padding-top: 12px; position: relative;">
                    <div style={`font-size: 12px; font-weight: 800; color: ${expert.color}; display: flex; align-items: center; gap: 6px;`}>
                      <span style="font-family: var(--font-mono); opacity: 0.7;">{`</>`}</span> Preview prompt
                    </div>
                    <div class="os-expert-prompt-content" style="display: none; position: absolute; top: 100%; left: -21px; width: calc(100% + 42px); margin-top: 12px; padding: 16px; background: #ffffff; border: 1px solid var(--border-medium); border-radius: 8px; font-family: var(--font-mono); font-size: 12px; line-height: 1.6; color: var(--text-primary); box-shadow: var(--shadow-lg); z-index: 50;">
                      {c.prompt}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* WHAT IT DOES */}
          <div style="display: flex; flex-direction: column; gap: 20px;">
            <div>
              <h2 class="os-h2" style="font-size: 1.8rem; letter-spacing: -0.02em;">What it does</h2>
              <p style="color: var(--text-secondary); margin-top: 6px; font-size: 1.05rem;">Tasks {expert.short} ships every week autonomously.</p>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px;">
              {expert.tasks.map(group => (
                <div class="os-expert-card" style="padding: 24px; height: 100%;">
                  <div style={`display: inline-flex; align-items: center; padding: 6px 14px; border-radius: 6px; background: ${expert.color}15; color: ${expert.color}; font-weight: 800; font-size: 13px; letter-spacing: 0.02em;`}>{group.group}</div>
                  <ul style="list-style: none; padding: 0; margin: 20px 0 0;">
                    {group.items.map((item, i) => (
                      <li style={`padding: 12px 0; ${i > 0 ? 'border-top: 1px solid var(--border-light);' : ''} font-size: 14px; line-height: 1.5; color: var(--text-secondary); display: flex; gap: 12px; align-items: flex-start;`}>
                        <span style={`color: ${expert.color}; font-size: 16px; margin-top: -1px; font-weight: bold;`}>✓</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>

          {/* SAMPLE CHAT */}
          <div style="display: flex; flex-direction: column; gap: 20px;">
            <div>
              <h2 class="os-h2" style="font-size: 1.8rem; letter-spacing: -0.02em;">Sample chat</h2>
              <p style="color: var(--text-secondary); margin-top: 6px; font-size: 1.05rem;">A real {expert.short} session. No edits or cherry-picks.</p>
            </div>
            <div class="os-expert-card" style="overflow: hidden; padding: 0;">
              <div style="display: flex; gap: 12px; padding: 20px 24px; border-bottom: 1px solid var(--border-light); background: #faf8f2;">
                <div style="flex: 0 0 28px; height: 28px; border-radius: 999px; background: var(--text-primary); color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 11px;">You</div>
                <div style="flex: 1; padding-top: 4px; font-size: 14px; line-height: 1.5; color: var(--text-primary);">{expert.sample.user}</div>
              </div>
              <div style="display: flex; gap: 12px; padding: 24px; background: #ffffff;">
                <div style={`flex: 0 0 28px; height: 28px; border-radius: 999px; background: ${expert.color}; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 11px;`}>{expert.short.slice(0,2)}</div>
                <div class="os-chat-body" style="flex: 1; padding-top: 4px; font-size: 14px; line-height: 1.6; color: var(--text-primary);" set:html={assistantHtml} />
              </div>
              <div style="padding: 12px 24px; background: #faf8f2; display: flex; gap: 16px; align-items: center; font-size: 12px; font-weight: 600; color: var(--text-secondary); border-top: 1px solid var(--border-light);">
                <span style="display: flex; align-items: center; gap: 6px;"><span style={`color: ${expert.color}; font-size: 13px;`}>✦</span> Grounded securely</span>
                <span style="color: var(--border-medium);">·</span>
                <span>Memory on</span>
                <span style="color: var(--border-medium);">·</span>
                <span>4,000+ tools</span>
              </div>
            </div>
          </div>

          {/* RELATED EXPERTS */}
          {related.length > 0 && (
            <div style="margin-top: 8px; padding-top: 32px; border-top: 1px solid var(--border-medium);">
              <div style="margin-bottom: 20px;">
                <h2 class="os-h2" style="font-size: 1.8rem; letter-spacing: -0.02em;">Pairs well with</h2>
                <p style="color: var(--text-secondary); margin-top: 6px; font-size: 1.05rem;">{expert.short} works best alongside these {related.length} experts.</p>
              </div>
              <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px;">
                {related.map(r => (
                  <a href={`/experts/${r.slug}`} class="os-expert-link-card" style="display: flex; align-items: center; gap: 16px; padding: 16px; color: var(--text-primary); text-decoration: none;">
                    <div style="flex: 0 0 auto;">
                      <ExpertGlyph slug={r.slug} color={r.color} size={48} flat={true} />
                    </div>
                    <div style="flex: 1; min-width: 0;">
                      <div style="font-weight: 800; font-size: 15px; letter-spacing: -0.01em; line-height: 1.2; color: var(--text-primary);">{r.name}</div>
                      <div style="font-size: 13px; color: var(--text-secondary); line-height: 1.4; margin-top: 6px; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">{r.oneliner}</div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

          {/* CTA */}
          <div style="margin-top: 8px;">
            <div class="os-expert-card" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; padding: 40px; position: relative; overflow: hidden;">
              <div style={`position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: ${expert.color};`}></div>
              <div>
                <h2 style="font-weight: 800; font-size: 28px; letter-spacing: -0.02em; line-height: 1.15; color: var(--text-primary); margin-bottom: 8px;">Put {expert.short} on your team.</h2>
                <p style="font-size: 16px; color: var(--text-secondary); font-weight: 500;">Plus 18 other experts. One subscription. No setup required.</p>
              </div>
              <a href="https://app.ollasuper.com/login" class="os-btn" style={`background: ${expert.color}; color: #ffffff; border: none; white-space: nowrap; font-weight: 800; font-size: 1.05rem; padding: 14px 32px; box-shadow: var(--shadow-sm); transition: transform 0.2s ease;`} onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">Start free →</a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </main>
</Layout>
