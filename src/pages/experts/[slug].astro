---
import Layout from "~/layouts/Layout.astro";
import ExpertGlyph from "~/components/ExpertGlyph.astro";
import { experts, departments } from "~/data/experts";
import { marked } from "marked";

export async function getStaticPaths() {
  return experts.map(e => ({ params: { slug: e.slug }, props: { expert: e } }));
}

const { expert } = Astro.props as { expert: typeof experts[number] };
const dept = departments[expert.department];
const related = expert.pairs
  .map(slug => experts.find(e => e.slug === slug))
  .filter((e): e is typeof experts[number] => Boolean(e));
const promptUrl = (prompt: string) =>
  `https://app.ollasuper.com/?expert=${expert.slug}&prompt=${encodeURIComponent(prompt)}`;

// Render the sample chat content as HTML (no raw markdown asterisks visible).
marked.setOptions({ gfm: true, breaks: false });
const assistantHtml = marked.parse(expert.sample.assistant) as string;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": expert.name,
  "name": `${expert.name} — OllaSuper`,
  "description": expert.oneliner,
  "provider": { "@type": "Organization", "name": "OllaSuper", "url": "https://ollasuper.com" },
  "areaServed": "Worldwide",
  "url": `https://ollasuper.com/experts/${expert.slug}`,
  "category": dept.label,
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": `${expert.short} capabilities`,
    "itemListElement": expert.tasks.flatMap(group => group.items.map(item => ({
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": item, "category": group.group }
    })))
  }
};
---
<Layout
  current="experts"
  title={`${expert.name} — OllaSuper`}
  description={expert.oneliner}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  {/* BREADCRUMB */}
  <div style="border-bottom: 1px solid var(--border-light); background: #ffffff;">
    <div class="os-container os-small" style="padding: var(--spacing-16) 0; font-weight: 500;">
      <a href="/" style="color: var(--ink-secondary); text-decoration: none;">Home</a>
      <span style="margin: 0 var(--spacing-8); color: var(--border-medium);">/</span>
      <a href="/experts" style="color: var(--ink-secondary); text-decoration: none;">Experts</a>
      <span style="margin: 0 var(--spacing-8); color: var(--border-medium);">/</span>
      <span style="color: var(--ink-black); font-weight: 700;">{expert.name}</span>
    </div>
  </div>

  {/* HERO */}
  <section class="os-section" style="position: relative; overflow: hidden; background: linear-gradient(180deg, var(--warm-cream) 0%, #fffbf2 100%);">
    <div class="qw-hero-bg"></div>
    <div class="os-container" style="position: relative;">
      <div class="os-grid-2" style="align-items: center;">
        <div>
          <div class="os-small" style="display: inline-flex; align-items: center; gap: var(--spacing-8); padding: 6px 12px; background: #ffffff; border: 1px solid var(--border-medium); border-radius: 999px; font-weight: 600; color: var(--ink-secondary); margin-bottom: var(--spacing-24); box-shadow: var(--shadow-sm);">
            <span style={`width: 8px; height: 8px; border-radius: 999px; background: ${expert.color};`}></span>
            {dept.label} <span style="color: var(--border-medium);">·</span> Expert
          </div>
          <h1 class="os-display">{expert.name}</h1>
          <p class="os-lead" style="max-width: 540px; margin-top: var(--spacing-24);">
            {expert.oneliner}
          </p>
          <div style="display: flex; gap: var(--spacing-16); margin-top: var(--spacing-32); flex-wrap: wrap;">
            <a href="/signup" class="os-btn os-btn-primary">
              Hire {expert.short} — Start free →
            </a>
            <a href="/experts" class="os-btn os-btn-secondary">All 80 agents</a>
          </div>
        </div>

        <div style="display: flex; align-items: center; justify-content: center; position: relative;">
          <div style={`position: absolute; inset: -24px; background: radial-gradient(60% 60% at 50% 50%, ${expert.color}22, transparent 70%); filter: blur(24px);`}></div>
          <div class="os-card os-card-cream os-card-symmetric" style="position: relative; padding: var(--spacing-48); border: 1px solid var(--border-medium);">
            <ExpertGlyph slug={expert.slug} color={expert.color} size={200} flat={true} />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* STARTER PROMPTS */}
  <section class="os-section" style="background: var(--bg-cream-alt); border-top: 1px solid var(--border-light); border-bottom: 1px solid var(--border-light);">
    <div class="os-container">
      <div class="os-section-header" style="align-items: flex-start; text-align: left;">
        <div style="display: flex; align-items: flex-end; justify-content: space-between; width: 100%; gap: 24px;">
          <div>
            <div class="os-eyebrow">Starter prompts</div>
            <h2 class="os-h2">4 ways to start with {expert.short}.</h2>
          </div>
          <span style="font-size: 13px; color: var(--ink-secondary); font-weight: 500;">Click any → opens in app with prompt pre-loaded</span>
        </div>
      </div>
      <div class="os-grid-4">
        {expert.starters.map(c => (
          <a href={promptUrl(c.prompt)} class="os-card os-card-cream os-card-symmetric" style="display: flex; flex-direction: column; padding: 24px; color: var(--ink-black); text-decoration: none; border: 1px solid var(--border-medium);">
            <div style="display: flex; justify-content: space-between; gap: 8px; align-items: flex-start;">
              <div style="font-weight: 700; font-size: 15px; letter-spacing: -0.012em; line-height: 1.3; color: var(--ink-black);">{c.title}</div>
              <span style={`color: ${expert.color}; font-weight: 700; font-size: 16px;`}>→</span>
            </div>
            <div style="margin-top: 10px; font-size: 13px; color: var(--ink-secondary); line-height: 1.5;">{c.tagline}</div>
            <details style="margin-top: 20px;">
              <summary style="cursor: pointer; list-style: none; font-size: 12px; font-weight: 600; color: var(--ink-secondary);">▸ Preview prompt</summary>
              <div style="margin-top: 12px; padding: 12px 16px; background: #ffffff; border: 1px solid var(--border-light); border-radius: 8px; font-family: var(--font-mono); font-size: 11px; line-height: 1.6; color: var(--ink-muted);">{c.prompt}</div>
            </details>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* WHAT IT DOES */}
  <section class="os-section">
    <div class="os-container">
      <div class="os-section-header" style="align-items: flex-start; text-align: left; margin-bottom: 32px;">
        <div class="os-eyebrow">What it does</div>
        <h2 class="os-h2">Tasks {expert.short} ships every week.</h2>
      </div>
      <div style={`display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px;`}>
        {expert.tasks.map(group => (
          <div class="os-card os-card-cream os-card-symmetric" style="padding: 24px; border: 1px solid var(--border-medium);">
            <div style={`display: inline-block; padding: 4px 10px; border-radius: 6px; background: ${expert.color}1a; color: ${expert.color}; font-weight: 700; font-size: 12px; letter-spacing: 0;`}>{group.group}</div>
            <ul style="list-style: none; padding: 0; margin: 16px 0 0;">
              {group.items.map(item => (
                <li style="padding: 12px 0; border-top: 1px solid var(--border-light); font-size: 14px; line-height: 1.5; color: var(--ink-secondary);">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* SAMPLE CHAT */}
  <section class="os-section" style="background: var(--bg-cream-alt); border-top: 1px solid var(--border-light); border-bottom: 1px solid var(--border-light);">
    <div class="os-container" style="max-width: 900px;">
      <div class="os-section-header" style="align-items: flex-start; text-align: left; margin-bottom: 32px;">
        <div style="display: flex; align-items: flex-end; justify-content: space-between; width: 100%;">
          <div>
            <div class="os-eyebrow">Worked sample</div>
            <h2 class="os-h2">A real {expert.short} chat.</h2>
          </div>
          <span style="font-size: 13px; color: var(--ink-secondary); font-weight: 500;">No edits · no cherry-picks</span>
        </div>
      </div>

      <div class="os-card os-card-cream os-card-symmetric" style="overflow: hidden; padding: 0; border: 1px solid var(--border-medium);">
        <div style="display: flex; gap: 16px; padding: 24px 32px; border-bottom: 1px solid var(--border-light); background: #ffffff;">
          <div style="flex: 0 0 32px; height: 32px; border-radius: 999px; background: var(--ink-black); color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 12px;">You</div>
          <div style="flex: 1; padding-top: 6px; font-size: 15px; line-height: 1.6; color: var(--ink-black);">{expert.sample.user}</div>
        </div>
        <div style="display: flex; gap: 16px; padding: 32px;">
          <div style={`flex: 0 0 32px; height: 32px; border-radius: 999px; background: ${expert.color}; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 12px;`}>{expert.short.slice(0,2)}</div>
          <div class="os-chat-body" style="flex: 1; padding-top: 6px; font-size: 15px; line-height: 1.65; color: var(--ink-black);" set:html={assistantHtml} />
        </div>
        <div style="padding: 16px 32px; background: #ffffff; display: flex; gap: 12px; align-items: center; font-size: 12px; font-weight: 600; color: var(--ink-secondary); border-top: 1px solid var(--border-light);">
          <span style={`color: ${expert.color};`}>✦</span>
          <span>grounded in your files + site</span>
          <span style="color: var(--border-medium);">·</span>
          <span>memory on</span>
          <span style="color: var(--border-medium);">·</span>
          <span>200M proxies + 4,000 tools</span>
        </div>
      </div>
    </div>
  </section>

  {/* RELATED EXPERTS */}
  {related.length > 0 && (
    <section class="os-section">
      <div class="os-container">
        <div class="os-section-header" style="align-items: flex-start; text-align: left; margin-bottom: 24px;">
          <div class="os-eyebrow">Pairs well with</div>
          <h2 class="os-h2">{expert.short} works best alongside these {related.length}.</h2>
        </div>
        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          {related.map(r => (
            <a href={`/experts/${r.slug}`} class="os-card os-card-cream os-card-symmetric" style="display: inline-flex; align-items: center; gap: 16px; padding: 12px 24px 12px 16px; color: var(--ink-black); text-decoration: none; border-radius: 999px; border: 1px solid var(--border-medium);">
              <ExpertGlyph slug={r.slug} color={r.color} size={40} flat={true} />
              <span>
                <span style="display: block; font-weight: 700; font-size: 15px; letter-spacing: -0.012em; line-height: 1.1; color: var(--ink-black);">{r.name}</span>
                <span style="display: block; font-size: 13px; color: var(--ink-secondary); line-height: 1.35; max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 4px;">{r.oneliner}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* CTA — soft card, accent only on button */}
  <section class="os-section" style="padding-top: 0;">
    <div class="os-container">
      <div class="os-card os-card-cream os-card-symmetric" style="display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 48px; border: 1px solid var(--border-medium); position: relative; overflow: hidden;">
        {/* expert-color accent on the left edge — subtle */}
        <div style={`position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: ${expert.color};`}></div>
        <div>
          <div style="font-weight: 800; font-size: 28px; letter-spacing: -0.022em; line-height: 1.15; color: var(--ink-black);">Put {expert.short} on your team.</div>
          <div style="margin-top: 8px; font-size: 15px; color: var(--ink-secondary); font-weight: 500;">Plus 18 other experts. One subscription. No setup.</div>
        </div>
        <a href="/signup" class="os-btn" style={`background: ${expert.color}; color: #ffffff; border: none; white-space: nowrap;`}>Start free →</a>
      </div>
    </div>
  </section>

</Layout>
