---
import Layout from "~/layouts/Layout.astro";
import ExpertGlyph from "~/components/ExpertGlyph.astro";
import { experts, departments } from "~/data/experts";

const grouped = Object.keys(departments).map(key => ({
  key,
  ...departments[key as keyof typeof departments],
  experts: experts.filter(e => e.department === key),
}));
---
<Layout current="experts" title="The 22 Assistants — OllaSuper" description="Meet every Assistant: HR, Sales, Operations, SEO, AEO, Data, Engineering, Product, Finance, Legal and 9 more. Each with their own prompts, glyph, and detail page.">

  {/* HERO */}
  <section class="os-section" style="position: relative; overflow: hidden; background: linear-gradient(180deg, var(--warm-cream) 0%, #fffbf2 100%);">
    <div class="qw-hero-bg"></div>
    <div class="os-container" style="position: relative;">
      <div class="os-grid-2" style="align-items: flex-start;">
        <div>
          <div class="os-eyebrow">Assistants · 22 specialists</div>
          <h1 class="os-display" style="margin-bottom: var(--spacing-16);">
            The 22 Assistants.
          </h1>
          <p class="os-lead" style="max-width: 560px;">
            Every Assistant ships with its own system prompt, four starter chips, and a worked sample.
          </p>
        </div>
        <div class="os-card os-card-cream os-card-symmetric" style="padding: 24px; font-size: 13px; color: var(--ink-secondary); border: 1px solid var(--border-medium);">
          <div style="display: flex; align-items: center; gap: 8px; color: var(--ink-black); font-weight: 700; font-size: 14px; letter-spacing: -0.01em; margin-bottom: 8px;">
            <span style="display: inline-block; width: 6px; height: 6px; border-radius: 999px; background: var(--candy-pink);"></span>
            Tip
          </div>
          Filter chips below are sticky. Scroll past a department to jump to the next one.
        </div>
      </div>
    </div>
  </section>

  {/* STICKY DEPARTMENT FILTER */}
  <div style="position: sticky; top: 57px; z-index: 30; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border-light);">
    <div class="os-container" style="padding: 16px 0;">
      <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
        <a href="#all" class="os-btn os-btn-primary" style="padding: 8px 16px; font-size: 13px;">All 22</a>
        {grouped.map(g => (
          <a href={`#${g.key}`} class="os-btn os-btn-secondary" style={`padding: 8px 16px; font-size: 13px;`}
             onmouseover={`this.style.borderColor='${g.color}'; this.style.color='${g.color}';`} onmouseout="this.style.borderColor='var(--border-medium)'; this.style.color='var(--ink-black)';">
            <span style={`width: 8px; height: 8px; border-radius: 999px; background: ${g.color};`}></span>
            {g.label} <span style="color: var(--ink-secondary); font-weight: 400; margin-left: 4px;">{g.experts.length}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  {/* GROUPED LIST */}
  <section id="all" class="os-section">
    <div class="os-container">
      {grouped.map((group, gi) => (
        <div id={group.key} style={`margin-top: ${gi === 0 ? '0' : 'var(--spacing-64)'};`}>
          <div style="display: flex; align-items: center; gap: var(--spacing-12); margin-bottom: var(--spacing-24); padding-bottom: var(--spacing-16); border-bottom: 1px solid var(--border-medium);">
            <span style={`width: 14px; height: 14px; border-radius: 999px; background: ${group.color};`}></span>
            <h2 class="os-h2" style="margin: 0;">{group.label}</h2>
            <span class="os-small" style="font-weight: 600;">{group.experts.length} Assistants</span>
          </div>

          <div class="os-grid-3">
            {group.experts.map(e => (
              <a href={`/experts/${e.slug}`} class="os-card os-card-cream os-card-symmetric" style="display: flex; gap: var(--spacing-16); color: var(--ink-black); text-decoration: none; border: 1px solid var(--border-medium);">
                <div style="flex: 0 0 64px;"><ExpertGlyph slug={e.slug} color={e.color} size={64} flat={true} /></div>
                <div style="flex: 1; min-width: 0;">
                  <div class="os-h4">{e.name}</div>
                  <p class="os-small" style="margin-top: var(--spacing-8);">{e.oneliner}</p>
                  <div style="margin-top: var(--spacing-16); display: flex; gap: 6px; flex-wrap: wrap;">
                    {e.tasks.slice(0, 3).map(t => (
                      <span style={`display: inline-block; padding: 4px 8px; border-radius: 4px; background: ${e.color}14; color: ${e.color}; font-weight: 600; font-size: var(--text-caption);`}>{t.group}</span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  {/* HOW TO USE AN ASSISTANT — added 2026-06-15. Five-step flow with the     */}
  {/* same paper card chrome as the rest of the page.                      */}
  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  <section class="os-section" style="background: var(--bg-cream-alt); border-top: 1px solid var(--border-light); border-bottom: 1px solid var(--border-light);">
    <div class="os-container">
      <div class="os-section-header">
        <div class="os-eyebrow">How to use an Assistant</div>
        <h2 class="os-h2">Five steps from "I need help with…" to a shippable answer.</h2>
        <p class="os-lead">
          Assistants are chat-driven specialists. They advise. They don't take real-world actions on their own — that's what <a href="/agents" style="color: var(--candy-pink); font-weight: 600; text-decoration: underline;">Agents</a> are for.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
        {[
          { n: "1", title: "Browse or search",        body: "Filter by department (People / GTM / Ops / Data / Build / Personal) or type a problem into the ⌘K palette. Each Assistant lists their starters so you can preview what kinds of work they're good at." },
          { n: "2", title: "Open the chat",           body: "One click on an Assistant tile lands you in the chat surface with their system prompt already loaded. The badge in the topbar reminds you which Assistant you're talking to mid-thread." },
          { n: "3", title: "Pick a starter", body: "Every Assistant ships 4 starter prompts that are the dominant use cases for that role. They're a faster start than a blank page. Or just describe what you need." },
          { n: "4", title: "Ground in your sources",   body: "Use the source toggle in the composer to attach scans, uploaded files, or text snippets. Replies cite the chunks they used — you can click through to verify." },
          { n: "5", title: "Iterate, copy, save",      body: "Hover any AI reply for Copy / Regenerate / Save. Save sends a reply into your Documents workspace; Regenerate runs the same prompt for an alternate take." },
        ].map(s => (
          <div class="os-card os-card-cream os-card-symmetric" style="padding: 24px;">
            <div style="font-family: var(--font-mono); font-size: 11px; color: var(--candy-pink); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">STEP {s.n}</div>
            <div style="font-weight: 700; font-size: 15px; letter-spacing: -0.01em; color: var(--ink-black); margin-top: 10px;">{s.title}</div>
            <p style="margin: 10px 0 0; font-size: 13px; line-height: 1.55; color: var(--ink-secondary);">{s.body}</p>
          </div>
        ))}
      </div>

      <div class="os-card os-card-cream os-card-symmetric" style="margin-top: 40px; padding: 24px; border: 1px solid var(--border-medium); display: flex; align-items: flex-start; gap: 16px; flex-direction: row;">
        <div style="flex: 0 0 36px; height: 36px; border-radius: 50%; background: rgba(255, 131, 218, 0.15); color: var(--candy-pink); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px;">i</div>
        <div style="font-size: 14px; line-height: 1.6; color: var(--ink-secondary);">
          <strong style="color: var(--ink-black);">Credits.</strong> Every chat turn spends credits = the LLM tokens the reply used. Free tier = 50,000/month, no card required. Hover the credit chip in the topbar to see a live read of what's left.
        </div>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="os-section" style="padding-top: 0;">
    <div class="os-container">
      <div class="os-card os-card-cream os-card-symmetric" style="display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 32px 40px; flex-direction: row; border: 1px solid var(--border-medium);">
        <div>
          <div style="font-weight: 800; font-size: 24px; letter-spacing: -0.02em; color: var(--ink-black); margin-bottom: 6px;">22 Assistants. One subscription.</div>
          <div style="font-size: 14px; color: var(--ink-secondary); font-weight: 500;">All 22 unlocked on the free tier. Upgrade for higher tool-call limits and team workspaces.</div>
        </div>
        <a href="/signup" class="os-btn os-btn-primary" style="white-space: nowrap;">Start free →</a>
      </div>
    </div>
  </section>

</Layout>
