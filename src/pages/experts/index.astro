---
import Layout from "~/layouts/Layout.astro";
import ExpertGlyph from "~/components/ExpertGlyph.astro";
import { experts, departments } from "~/data/experts";

const grouped = Object.keys(departments).map(key => ({
  key,
  ...departments[key as keyof typeof departments],
  experts: experts.filter(e => e.department === key),
}));
---
<Layout current="experts" title="The 19 Experts — OllaSuper" description="Meet every expert: HR, Sales, Operations, SEO, AEO, Data, Engineering, Product, Finance, Legal and 9 more. Each with their own prompts, glyph, and detail page.">

  {/* HERO */}
  <section style="position: relative; padding: 56px 0 28px; overflow: hidden;">
    <div class="qw-hero-bg"></div>
    <div class="qw-section" style="position: relative;">
      <div class="qw-split">
        <div>
          <div class="qw-eyebrow qw-eyebrow-accent">Agents · 30 specialists</div>
          <h1 class="qw-h-display" style="margin-top: 10px;">
            The 30 agents.
          </h1>
          <p class="qw-body" style="max-width: 560px; margin-top: 14px; font-size: 16px;">
            Every expert ships with its own system prompt, four starter chips, and a worked sample.
          </p>
        </div>
        <div class="qw-card" style="padding: 14px 16px; font-size: 13px; color: var(--ink-3);">
          <div style="display: flex; align-items: center; gap: 6px; color: var(--ink); font-weight: 600; font-size: 13px; letter-spacing: -0.01em; margin-bottom: 4px;">
            <span style="display: inline-block; width: 6px; height: 6px; border-radius: 999px; background: var(--accent);"></span>
            Tip
          </div>
          Filter chips below are sticky. Scroll past a department to jump to the next one.
        </div>
      </div>
    </div>
  </section>

  {/* STICKY DEPARTMENT FILTER */}
  <div style="position: sticky; top: 57px; z-index: 30;" class="qw-nav-blur">
    <div class="qw-section" style="padding: 12px 0;">
      <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
        <a href="#all" class="qw-btn primary" style="padding: 6px 12px; font-size: 12px;">All 30</a>
        {grouped.map(g => (
          <a href={`#${g.key}`} class="qw-btn ghost" style={`padding: 6px 12px; font-size: 12px;`}
             onmouseover={`this.style.borderColor='${g.color}'; this.style.color='${g.color}';`} onmouseout="this.style.borderColor='var(--rule)'; this.style.color='var(--ink)';">
            <span style={`width: 7px; height: 7px; border-radius: 999px; background: ${g.color};`}></span>
            {g.label} <span style="color: var(--ink-3); font-weight: 400; margin-left: 4px;">{g.experts.length}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  {/* GROUPED LIST */}
  <section id="all" style="padding: 36px 0 72px;">
    <div class="qw-section">
      {grouped.map((group, gi) => (
        <div id={group.key} style={`margin-top: ${gi === 0 ? '0' : '44px'};`}>
          <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid var(--rule);">
            <span style={`width: 12px; height: 12px; border-radius: 999px; background: ${group.color};`}></span>
            <h2 class="qw-h-2" style="margin: 0;">{group.label}</h2>
            <span style="font-size: 12px; color: var(--ink-3);">{group.experts.length} experts</span>
          </div>

          <div class="qw-bento qw-grid-3">
            {group.experts.map(e => (
              <a href={`/experts/${e.slug}`} class="qw-bento-cell" style="display: flex; gap: 16px; padding: 18px; color: var(--ink);">
                <div style="flex: 0 0 64px;"><ExpertGlyph slug={e.slug} color={e.color} size={64} flat={true} /></div>
                <div style="flex: 1; min-width: 0;">
                  <div style="font-weight: 600; font-size: 15px; letter-spacing: -0.012em; line-height: 1.2; color: var(--ink);">{e.name}</div>
                  <p style="margin-top: 4px; font-size: 12.5px; line-height: 1.5; color: var(--ink-3);">{e.oneliner}</p>
                  <div style="margin-top: 10px; display: flex; gap: 4px; flex-wrap: wrap;">
                    {e.tasks.slice(0, 3).map(t => (
                      <span style={`display: inline-block; padding: 2px 7px; border-radius: 4px; background: ${e.color}14; color: ${e.color}; font-weight: 500; font-size: 11px;`}>{t.group}</span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* CTA */}
  <section class="qw-pad">
    <div class="qw-section">
      <div class="qw-card-pop" style="display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 22px 26px;">
        <div>
          <div style="font-weight: 600; font-size: 20px; letter-spacing: -0.02em; color: var(--ink);">30 agents. One subscription.</div>
          <div style="margin-top: 3px; font-size: 13px; color: var(--ink-3);">All 30 unlocked on the free tier. Upgrade for higher tool-call limits and team workspaces.</div>
        </div>
        <a href="/signup" class="qw-btn accent">Start free →</a>
      </div>
    </div>
  </section>

</Layout>
