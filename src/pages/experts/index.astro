---
import Layout from "~/layouts/Layout.astro";
import ExpertGlyph from "~/components/ExpertGlyph.astro";
import TrustFooter from "~/components/home/TrustFooter.astro";
import { experts, departments } from "~/data/experts";

const grouped = Object.keys(departments).map(key => ({
  key,
  ...departments[key as keyof typeof departments],
  experts: experts.filter(e => e.department === key),
}));
---
<Layout current="experts" title="The 22 Assistants — OllaSuper" description="Meet every Assistant: HR, Sales, Operations, SEO, AEO, Data, Engineering, Product, Finance, Legal and 9 more. Each with their own prompts, glyph, and detail page.">

  {/* PREMIUM HERO */}
  <section class="os-section premium-hero" style="position: relative; overflow: hidden; padding: 48px 0 48px; background: linear-gradient(180deg, var(--warm-cream) 0%, #fffbf2 100%);">
    {/* Subtle Glow Backdrop (Matching Homepage) */}
    <div style="position: absolute; top: -10%; left: 50%; transform: translateX(-50%); width: 800px; height: 400px; background: radial-gradient(circle, rgba(255, 131, 218, 0.12) 0%, rgba(255, 252, 246, 0) 70%); pointer-events: none; z-index: 0;"></div>
    
    <div class="os-container" style="position: relative; z-index: 1;">
      <div class="os-grid-2" style="align-items: center; gap: 64px;">
        <div>
          <div class="os-eyebrow" style="color: var(--candy-pink); margin-bottom: 16px;">
            <span class="os-badge" style="background: var(--candy-pink-soft); border: 1px solid rgba(244,114,182,0.2); color: var(--candy-pink); font-size: 11px;">22 SPECIALISTS</span>
          </div>
          <h1 class="os-display" style="font-size: 4rem; line-height: 1.1; margin-bottom: 24px; color: var(--ink-black); letter-spacing: -0.03em;">
            The 22 Assistants.
          </h1>
          <p class="os-lead" style="max-width: 500px; color: var(--ink-secondary); font-size: 1.1rem; line-height: 1.6;">
            Every Assistant ships with its own system prompt, four starter chips, and a highly tuned workflow. Ready to deploy instantly.
          </p>
        </div>
        
        {/* Sleek Tip Card */}
        <div class="os-card os-card-cream" style="padding: 32px; background: rgba(255,255,255,0.8); backdrop-filter: blur(20px); border: 1px solid rgba(255,131,218,0.2); box-shadow: 0 20px 40px rgba(0,0,0,0.04); border-radius: 24px;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 40px; height: 40px; border-radius: 12px; background: var(--candy-pink-soft); color: var(--candy-pink); display: flex; align-items: center; justify-content: center;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
            </div>
            <div style="font-weight: 800; font-size: 16px; color: var(--ink-black);">Pro Tip</div>
          </div>
          <p style="font-size: 14px; color: var(--ink-secondary); line-height: 1.6; margin: 0;">
            The filter chips below are sticky. Scroll past a department to jump straight to the next one without losing your place.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* STICKY DEPARTMENT FILTER */}
  <div style="position: sticky; top: 57px; z-index: 30; background: rgba(255, 251, 242, 0.85); backdrop-filter: blur(24px); border-bottom: 1px solid rgba(0,0,0,0.05); padding: 16px 0;">
    <div class="os-container">
      <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center; justify-content: center;">
        <a href="#all" class="os-btn filter-chip active" style="padding: 8px 18px; font-size: 13px; font-weight: 700; border-radius: 99px;">All 22</a>
        {grouped.map(g => (
          <a href={`#${g.key}`} class="os-btn filter-chip" style={`padding: 8px 18px; font-size: 13px; font-weight: 600; border-radius: 99px;`}
             onmouseover={`this.style.borderColor='${g.color}'; this.style.color='${g.color}'; this.style.background='${g.color}11'`} 
             onmouseout="this.style.borderColor='var(--border-medium)'; this.style.color='var(--ink-black)'; this.style.background='transparent'">
            <span style={`width: 8px; height: 8px; border-radius: 999px; background: ${g.color}; display: inline-block; margin-right: 6px;`}></span>
            {g.label} <span style="color: var(--ink-muted); font-weight: 500; margin-left: 4px;">{g.experts.length}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  {/* GROUPED LIST */}
  <section id="all" class="os-section" style="padding: 80px 0; background: var(--bg-cream-alt);">
    <div class="os-container">
      {grouped.map((group, gi) => (
        <div id={group.key} style={`margin-top: ${gi === 0 ? '0' : '100px'};`}>
          <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 32px; padding-bottom: 16px; border-bottom: 2px solid rgba(0,0,0,0.04);">
            <div style={`width: 48px; height: 48px; border-radius: 14px; background: ${group.color}15; color: ${group.color}; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 800;`}>
              {group.label.charAt(0)}
            </div>
            <div>
              <h2 class="os-h2" style="margin: 0; font-size: 2rem; letter-spacing: -0.02em;">{group.label}</h2>
              <div style="font-size: 13px; color: var(--ink-secondary); font-weight: 600; margin-top: 4px;">{group.experts.length} Specialists</div>
            </div>
          </div>

          <div class="os-grid-3">
            {group.experts.map(e => (
              <a href={`/experts/${e.slug}`} class="os-card expert-card os-tilt" style="text-decoration: none; display: flex; flex-direction: column; height: 100%; background: #ffffff; border: 1px solid var(--border-medium); border-radius: 20px; padding: 24px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; overflow: hidden;">
                {/* Subtle top border glow on hover */}
                <div class="expert-card-glow" style={`background: ${e.color};`}></div>
                
                <div style="display: flex; gap: 20px; margin-bottom: 20px; align-items: flex-start;">
                  <div style="flex: 0 0 64px;">
                    <ExpertGlyph slug={e.slug} color={e.color} size={64} flat={true} />
                  </div>
                  <div style="flex: 1;">
                    <div style="font-size: 1.1rem; font-weight: 800; color: var(--ink-black); margin-bottom: 6px;">{e.name}</div>
                    <p style="font-size: 0.85rem; color: var(--ink-secondary); line-height: 1.5; margin: 0;">{e.oneliner}</p>
                  </div>
                </div>

                <div style="margin-top: auto; display: flex; gap: 6px; flex-wrap: wrap; padding-top: 16px; border-top: 1px solid var(--border-light);">
                  {e.tasks.slice(0, 3).map(t => (
                    <span style={`display: inline-block; padding: 4px 10px; border-radius: 6px; background: ${e.color}0A; color: ${e.color}; font-weight: 700; font-size: 11px; letter-spacing: 0.02em; border: 1px solid ${e.color}1A;`}>
                      {t.group}
                    </span>
                  ))}
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  {/* PREMIUM BENTO: HOW TO USE AN ASSISTANT                          */}
  {/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
  <section class="os-section" style="padding: 100px 0 40px; background: var(--bg-cream-alt); border-top: 1px solid var(--border-light);">
    <div class="os-container">
      
      <div class="os-reveal" style="text-align: center; margin-bottom: 64px;">
        <div class="os-eyebrow" style="margin-bottom: 12px; color: var(--candy-pink); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.85rem;">
          HOW TO USE AN ASSISTANT
        </div>
        <h2 class="os-h2" style="font-size: 2.5rem; letter-spacing: -0.02em; margin-bottom: 16px;">
          Five steps to a shippable answer.
        </h2>
        <p class="os-lead" style="max-width: 600px; margin: 0 auto; color: var(--ink-secondary);">
          Assistants are chat-driven specialists. They advise. They don't take real-world actions on their own — that's what <a href="/agents" style="color: var(--candy-pink); font-weight: 700; text-decoration: none;">Agents</a> are for.
        </p>
      </div>

      <div class="os-reveal os-reveal-delay-1" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
        
        {/* Step 1 & 2 (Bigger cells) */}
        <div class="bento-cell os-tilt" style="grid-column: span 2; background: var(--bg-cream-alt); border-radius: 24px; padding: 40px; border: 1px solid var(--border-medium); display: flex; flex-direction: column; justify-content: center;">
          <div style="display: flex; gap: 40px; align-items: flex-start;">
            <div style="flex: 1;">
              <div style="font-family: var(--font-mono); font-size: 12px; color: var(--candy-pink); font-weight: 800; margin-bottom: 12px;">STEP 1</div>
              <h3 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 12px;">Browse or search</h3>
              <p style="color: var(--ink-secondary); line-height: 1.6; font-size: 0.95rem;">Filter by department (People / GTM / Ops / Data) or type a problem into the ⌘K palette. Each Assistant lists their starters so you can preview what kinds of work they're good at.</p>
            </div>
            <div style="flex: 1;">
              <div style="font-family: var(--font-mono); font-size: 12px; color: var(--candy-pink); font-weight: 800; margin-bottom: 12px;">STEP 2</div>
              <h3 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 12px;">Open the chat</h3>
              <p style="color: var(--ink-secondary); line-height: 1.6; font-size: 0.95rem;">One click on an Assistant tile lands you in the chat surface with their system prompt already loaded. The badge in the topbar reminds you which Assistant you're talking to.</p>
            </div>
          </div>
        </div>

        {/* Step 3 */}
        <div class="bento-cell os-tilt" style="background: linear-gradient(135deg, var(--warm-cream), #ffffff); border-radius: 24px; padding: 40px; border: 1px solid var(--candy-pink-soft);">
          <div style="font-family: var(--font-mono); font-size: 12px; color: var(--candy-pink); font-weight: 800; margin-bottom: 12px;">STEP 3</div>
          <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 12px;">Pick a starter</h3>
          <p style="color: var(--ink-secondary); line-height: 1.6; font-size: 0.95rem;">Every Assistant ships 4 starter prompts that represent their dominant use cases. They're a much faster start than a blank page.</p>
        </div>

        {/* Step 4 */}
        <div class="bento-cell os-tilt" style="background: #ffffff; border-radius: 24px; padding: 40px; border: 1px solid var(--border-medium);">
          <div style="font-family: var(--font-mono); font-size: 12px; color: var(--candy-pink); font-weight: 800; margin-bottom: 12px;">STEP 4</div>
          <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 12px;">Ground in your sources</h3>
          <p style="color: var(--ink-secondary); line-height: 1.6; font-size: 0.95rem;">Use the source toggle to attach scans, files, or snippets. Replies automatically cite the chunks they used.</p>
        </div>

        {/* Step 5 */}
        <div class="bento-cell os-tilt" style="grid-column: span 2; background: #fafbfc; border-radius: 24px; padding: 40px; border: 1px solid var(--border-medium); display: flex; align-items: center; justify-content: space-between;">
          <div style="max-width: 400px;">
            <div style="font-family: var(--font-mono); font-size: 12px; color: var(--candy-pink); font-weight: 800; margin-bottom: 12px;">STEP 5</div>
            <h3 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 12px;">Iterate, copy, save</h3>
            <p style="color: var(--ink-secondary); line-height: 1.6; font-size: 0.95rem; margin: 0;">Hover any AI reply for Copy / Regenerate / Save. Save sends a reply into your Documents workspace; Regenerate runs the same prompt for an alternate take.</p>
          </div>
          
          <div style="padding: 24px; background: #ffffff; border-radius: 16px; border: 1px dashed var(--border-medium);">
            <div style="font-size: 12px; font-weight: 700; color: var(--ink-black); margin-bottom: 8px;">💡 Credits</div>
            <div style="font-size: 12px; color: var(--ink-secondary); max-width: 200px; line-height: 1.5;">Every chat turn spends credits = the LLM tokens used. Free tier = 50,000/month.</div>
          </div>
        </div>

      </div>

    </div>
  </section>

  {/* NEW UNIFIED FOOTER CTA */}
  <TrustFooter />

</Layout>

<style>
  /* Filter Chip Styles */
  .filter-chip {
    background: transparent;
    border: 1px solid var(--border-medium);
    color: var(--ink-black);
    transition: all 0.2s ease;
  }
  .filter-chip.active {
    background: var(--ink-black) !important;
    color: #ffffff !important;
    border-color: var(--ink-black) !important;
  }

  /* Expert Card Hover States */
  .expert-card {
    transform: translateY(0);
    box-shadow: 0 4px 6px rgba(0,0,0,0.02);
  }
  .expert-card-glow {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .expert-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
    border-color: transparent;
  }
  .expert-card:hover .expert-card-glow {
    opacity: 1;
  }

  /* Bento Hover */
  .bento-cell {
    transition: transform 0.3s ease;
  }
  .bento-cell:hover {
    transform: translateY(-4px);
  }

  @media (max-width: 900px) {
    section div[style*="grid-template-columns: repeat(3, 1fr)"] {
      grid-template-columns: 1fr !important;
    }
    .bento-cell[style*="grid-column: span 2"] {
      grid-column: span 1 !important;
    }
    .bento-cell > div[style*="display: flex; gap: 40px; align-items: flex-start;"] {
      flex-direction: column !important;
      gap: 32px !important;
    }
    .bento-cell > div[style*="display: flex; align-items: center; justify-content: space-between;"] {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 24px !important;
    }
  }
</style>
