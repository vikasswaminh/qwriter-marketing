---
import Layout from "~/layouts/Layout.astro";
import { AI_EMPLOYEES } from "~/data/employees";
import RibbonBackground from "~/components/shared/RibbonBackground.astro";
---

<Layout
  title="Book a Demo & Live Simulation — OllaSuper AI Workforce"
  description="Experience a live demonstration of OllaSuper AI employees executing real business workflows."
  current="demo"
>
  <section class="os-section" style="padding-top: 0; position: relative; overflow: hidden; background: linear-gradient(180deg, var(--warm-cream) 0%, #fffbf2 100%);">
    
    {/* HERO SECTION WITH RIBBON */}
    <div style="position: relative; overflow: hidden; padding-top: 24px; padding-bottom: 48px; border-bottom: 1px solid var(--border-light);">
      
      <RibbonBackground id="stripe-ribbon-demo" lines={40} opacity={0.6} />

      <div class="os-container" style="position: relative; z-index: 1;">
        {/* Main Header */}
        <div class="os-section-header">
          <div class="os-eyebrow" style="margin-bottom: var(--spacing-12);">
            <span class="os-live-dot"></span> LIVE 1:1 ARCHITECTURE DEMO
          </div>
          <h1 class="os-h1" style="margin-bottom: var(--spacing-16);">
            See OllaSuper AI employees in action.
          </h1>
          <p class="os-lead">
            Schedule a 25-minute live technical walkthrough with an AI systems architect. We’ll simulate your company’s exact workflow using our autonomous employee fleet.
          </p>
        </div>
      </div>
    </div>

    <div class="os-container" style="position: relative; z-index: 1; padding-top: 48px; padding-bottom: 64px;">
      
      {/* Two Column Layout for Features and Form */}
      <div class="os-grid-2" style="gap: var(--spacing-32); align-items: stretch; max-width: 1200px; margin: 0 auto;">
        
        {/* Left Info Card */}
        <div style="display: flex; flex-direction: column; justify-content: space-between;">
          
          <div style="display: flex; flex-direction: column; gap: var(--spacing-32); margin-bottom: var(--spacing-40);">
            
            <div>
              <h2 class="os-h3" style="margin-bottom: var(--spacing-8);">What to Expect</h2>
              <p class="os-small" style="color: var(--ink-muted); margin: 0;">A hands-on, deeply technical look at our architecture.</p>
            </div>

            <div style="display: flex; flex-direction: column; gap: var(--spacing-24);">
              <div style="display: flex; gap: var(--spacing-16); align-items: flex-start;">
                <div style="width: 46px; height: 46px; border-radius: 12px; background: var(--candy-pink-soft); border: 1px solid var(--candy-pink-border); display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">🎯</div>
                <div>
                  <h3 class="os-h4" style="margin-bottom: 4px; font-size: 1.05rem;">Custom Workflow Simulation</h3>
                  <p class="os-small" style="color: var(--ink-secondary); margin: 0; line-height: 1.5;">Watch an AI employee research, enrich leads, or reconcile transactions against your specific schema.</p>
                </div>
              </div>

              <div style="display: flex; gap: var(--spacing-16); align-items: flex-start;">
                <div style="width: 46px; height: 46px; border-radius: 12px; background: var(--candy-pink-soft); border: 1px solid var(--candy-pink-border); display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">🔌</div>
                <div>
                  <h3 class="os-h4" style="margin-bottom: 4px; font-size: 1.05rem;">Model Context Protocol</h3>
                  <p class="os-small" style="color: var(--ink-secondary); margin: 0; line-height: 1.5;">Learn how to connect your private APIs, databases, and Salesforce/HubSpot instances securely.</p>
                </div>
              </div>

              <div style="display: flex; gap: var(--spacing-16); align-items: flex-start;">
                <div style="width: 46px; height: 46px; border-radius: 12px; background: var(--candy-pink-soft); border: 1px solid var(--candy-pink-border); display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">🛡️</div>
                <div>
                  <h3 class="os-h4" style="margin-bottom: 4px; font-size: 1.05rem;">Security & Governance</h3>
                  <p class="os-small" style="color: var(--ink-secondary); margin: 0; line-height: 1.5;">Review our SOC2 Type II controls, Human-in-the-Loop policies, and private VPC deployment options.</p>
                </div>
              </div>
            </div>
          </div>

          <div style="padding-top: var(--spacing-24); border-top: 1px solid var(--border-light);">
            <div class="os-caption" style="font-weight: 700; text-transform: uppercase; margin-bottom: 12px; color: var(--ink-black); letter-spacing: 0.05em;">Available AI Employees for Simulation</div>
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
              {AI_EMPLOYEES.map((e) => (
                <span class="os-badge os-badge-pink" style="font-size: 12px; padding: 6px 12px;">{e.avatarIcon} {e.name}</span>
              ))}
            </div>
          </div>
        </div>

        {/* Right Form Card */}
        <div style="display: flex; flex-direction: column;">
          <h2 class="os-h3" style="margin-bottom: var(--spacing-8);">
            Request a Technical Demo
          </h2>
          <p class="os-small" style="color: var(--ink-muted); margin-bottom: var(--spacing-32);">
            Fill out your details to receive an instant calendar invite.
          </p>

          <form id="os-demo-form" style="display: flex; flex-direction: column; gap: 20px; flex-grow: 1;">
            <div>
              <label for="email" style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-black); margin-bottom: 8px;">Work Email *</label>
              <input type="email" id="email" required placeholder="alex@company.com" style="width: 100%; padding: 14px 16px; border: 1px solid var(--border-medium); border-radius: 8px; font-size: 15px; background: var(--bg-cream-alt); transition: border-color 0.2s;" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
              <div>
                <label for="first_name" style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-black); margin-bottom: 8px;">First Name *</label>
                <input type="text" id="first_name" required placeholder="Alex" style="width: 100%; padding: 14px 16px; border: 1px solid var(--border-medium); border-radius: 8px; font-size: 15px; background: var(--bg-cream-alt); transition: border-color 0.2s;" />
              </div>
              <div>
                <label for="last_name" style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-black); margin-bottom: 8px;">Last Name *</label>
                <input type="text" id="last_name" required placeholder="Rivera" style="width: 100%; padding: 14px 16px; border: 1px solid var(--border-medium); border-radius: 8px; font-size: 15px; background: var(--bg-cream-alt); transition: border-color 0.2s;" />
              </div>
            </div>

            <div>
              <label for="company" style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-black); margin-bottom: 8px;">Company Name *</label>
              <input type="text" id="company" required placeholder="Acme Global Inc." style="width: 100%; padding: 14px 16px; border: 1px solid var(--border-medium); border-radius: 8px; font-size: 15px; background: var(--bg-cream-alt); transition: border-color 0.2s;" />
            </div>

            <div style="margin-bottom: auto;">
              <label for="use_case" style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-black); margin-bottom: 8px;">Primary Workflow of Interest</label>
              <select id="use_case" style="width: 100%; padding: 14px 16px; border: 1px solid var(--border-medium); border-radius: 8px; font-size: 15px; background: var(--bg-cream-alt); transition: border-color 0.2s;">
                <option value="research">Market & Competitor Research</option>
                <option value="sales">Autonomous Outbound SDR & Pipeline</option>
                <option value="marketing">Technical Content & SEO Strategy</option>
                <option value="support">Tier-1/2 Technical Customer Support</option>
                <option value="operations">Financial Reconciliation & BizOps</option>
                <option value="custom">Custom Enterprise MCP Fleet</option>
              </select>
            </div>

            <button type="submit" class="os-btn os-btn-primary" style="padding: 16px; font-size: 16px; margin-top: 12px; width: 100%; display: flex; justify-content: center;">
              Schedule Live Technical Walkthrough →
            </button>

            <div id="os-demo-success" style="display: none; padding: 16px; background: var(--status-green-bg); color: var(--status-green); border: 1px solid rgba(22, 163, 74, 0.3); border-radius: 8px; font-size: 14px; text-align: center; font-weight: 600; margin-top: 8px;">
              ✓ Demo request received! An invitation has been sent to your work email.
            </div>
          </form>
        </div>

      </div>

    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('os-demo-form');
  const success = document.getElementById('os-demo-success');

  if (form && success) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      success.style.display = 'block';
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.style.display = 'none';
      }
    });
  }
</script>
