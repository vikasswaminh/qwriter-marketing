---
import BaseLayout from '~/layouts/BlogBaseLayout.astro';
import { getPublishedPosts, readingTime } from '~/utils/posts';

const posts = await getPublishedPosts();
const tagsMap = new Map();

for (const p of posts) {
  for (const t of p.data.tags) {
    if (!tagsMap.has(t)) {
      tagsMap.set(t, []);
    }
    tagsMap.get(t).push(p);
  }
}

// Sort tags by number of posts (descending)
const sortedTags = [...tagsMap.keys()].sort((a, b) => tagsMap.get(b).length - tagsMap.get(a).length);

const featuredTags = sortedTags.slice(0, 2);
const regularTags = sortedTags.slice(2);
const totalArticles = posts.length;
const totalTopics = sortedTags.length;
---

<BaseLayout title="Tags" description="Browse posts by topic.">
  <div class="tags-page-container">
    <header class="tags-header">
      <div class="tags-eyebrow">
        <span class="square-dot"></span>
        <span>TOPICS & SPECIALS</span>
        <span class="eyebrow-line"></span>
      </div>
      <h1 class="tags-title">Explore <span class="text-gradient">Topics</span></h1>
      <p class="tags-subtitle">Explore technical guides, insights, and workflows organized by topic.</p>
      
      <div class="tags-stats-bar">
        <div class="stat-item">
          <span class="stat-num">{totalTopics}</span>
          <span class="stat-lbl">Active Topics</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">{totalArticles}</span>
          <span class="stat-lbl">Published Guides</span>
        </div>
      </div>
    </header>

    {sortedTags.length === 0 && <p class="empty">No topics found.</p>}
    
    {featuredTags.length > 0 && (
      <section class="specials-section">
        <h2 class="section-heading">Featured Specials</h2>
        <div class="specials-grid">
          {featuredTags.map((tag, i) => (
            <div class={`special-card ${i === 0 ? 'special-card--orange' : 'special-card--purple'}`}>
              <div class="special-card-header">
                <span class={`badge-pill ${i === 0 ? 'badge-pill--orange' : 'badge-pill--purple'}`}>FEATURED COLLECTION</span>
                <span class="count-pill">{tagsMap.get(tag).length} Articles</span>
              </div>
              <h3>{tag}</h3>
              <p>Essential guides, technical breakdowns, and strategic insights related to {tag}.</p>
              <ul class="special-post-list">
                {tagsMap.get(tag).map(p => (
                  <li>
                    <a href={`/blog/${p.slug}/`}>
                      <span class="post-title-text">{p.data.title}</span>
                      <span class="read-time">{readingTime(p.body)}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <a href={`/tags/${tag}/`} class={`special-view-link ${i === 0 ? 'special-view-link--orange' : 'special-view-link--purple'}`}>
                View All {tag} &rarr;
              </a>
            </div>
          ))}
        </div>
      </section>
    )}

    {regularTags.length > 0 && (
      <section class="topics-section">
        <h2 class="section-heading">All Topics</h2>
        <div class="topics-grid">
          {regularTags.map(tag => (
            <div class="topic-card">
              <div class="topic-card-top">
                <a href={`/tags/${tag}/`} class="topic-tag-name">#{tag.toLowerCase().replace(/\s+/g, '-')}</a>
                <span class="topic-count-pill">{tagsMap.get(tag).length} {tagsMap.get(tag).length === 1 ? 'article' : 'articles'}</span>
              </div>
              <ul class="topic-post-list">
                {tagsMap.get(tag).slice(0, 4).map(p => (
                  <li>
                    <a href={`/blog/${p.slug}/`}>{p.data.title}</a>
                  </li>
                ))}
                {tagsMap.get(tag).length > 4 && (
                  <li class="more-items">+ {tagsMap.get(tag).length - 4} more guides...</li>
                )}
              </ul>
              <a href={`/tags/${tag}/`} class="topic-card-link">
                View all in #{tag.toLowerCase().replace(/\s+/g, '-')} &rarr;
              </a>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .tags-page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  
  /* Header & Stats */
  .tags-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .tags-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }
  .square-dot {
    width: 6px;
    height: 6px;
    background: var(--color-primary);
  }
  .eyebrow-line {
    width: 30px;
    height: 1px;
    background: rgba(0,0,0,0.1);
  }
  .tags-title {
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--color-heading);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .text-gradient {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-hover));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .tags-subtitle {
    font-size: 1rem;
    color: var(--color-muted);
    max-width: 500px;
    margin: 0 auto 2rem;
    line-height: 1.5;
  }
  .tags-stats-bar {
    display: inline-flex;
    background: #ffffff;
    border: 1px solid #E2E8F0;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05);
    border-radius: 8px;
    padding: 0.75rem 1.5rem;
    gap: 2rem;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .stat-num {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-primary-hover);
  }
  .stat-lbl {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    color: #64748B;
    letter-spacing: 0.05em;
  }

  /* Section Headings */
  .section-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-heading);
    margin-bottom: 1rem;
    border-bottom: 1px solid #E2E8F0;
    padding-bottom: 0.5rem;
  }
  .specials-section {
    margin-bottom: 3rem;
  }

  /* Specials Grid */
  .specials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }
  .special-card {
    background: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .special-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.05);
    border-color: #CBD5E1;
  }
  
  /* Premium Badges */
  .badge-pill--orange {
    background: #FFF7ED;
    color: #C2410C;
    border: 1px solid #FFEDD5;
  }
  .special-view-link--orange {
    color: #C2410C;
    background: #FFF7ED;
  }
  .special-view-link--orange:hover {
    background: #FFEDD5;
  }
  
  .badge-pill--purple {
    background: #FDF2F8;
    color: #BE185D;
    border: 1px solid #FCE7F3;
  }
  .special-view-link--purple {
    color: #BE185D;
    background: #FDF2F8;
  }
  .special-view-link--purple:hover {
    background: #FCE7F3;
  }

  .special-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .badge-pill, .count-pill {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }
  .count-pill {
    background: #F8FAFC;
    color: #475569;
    border: 1px solid #E2E8F0;
  }
  .special-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 0.25rem;
  }
  .special-card p {
    font-size: 0.85rem;
    color: #475569;
    line-height: 1.4;
    margin-bottom: 1rem;
  }
  .special-post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }
  .special-post-list li {
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #F1F5F9;
  }
  .special-post-list li:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }
  .special-post-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    text-decoration: none;
    color: #1E293B;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.3;
    transition: color 0.2s;
  }
  .special-post-list a:hover {
    color: var(--color-primary);
  }
  .read-time {
    font-size: 0.7rem;
    color: #94A3B8;
    font-weight: 500;
    white-space: nowrap;
  }
  .special-view-link {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.8rem;
    text-align: center;
    transition: background 0.2s;
  }

  /* Topics Grid */
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }
  .topic-card {
    background: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  .topic-card:hover {
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05);
    border-color: #CBD5E1;
  }
  .topic-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .topic-tag-name {
    font-family: 'Martian Mono', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    color: #0F172A;
    text-decoration: none;
  }
  .topic-tag-name:hover {
    color: var(--color-primary);
  }
  .topic-count-pill {
    font-size: 0.65rem;
    font-weight: 600;
    color: #475569;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }
  .topic-post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
    flex-grow: 1;
  }
  .topic-post-list li {
    position: relative;
    padding-left: 0.75rem;
    margin-bottom: 0.4rem;
    font-size: 0.8rem;
    line-height: 1.3;
  }
  .topic-post-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #CBD5E1;
  }
  .topic-post-list a {
    color: #334155;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }
  .topic-post-list a:hover {
    color: var(--color-primary);
  }
  .more-items {
    font-style: italic;
    color: #94A3B8;
    font-size: 0.75rem;
  }
  .more-items::before {
    display: none;
  }
  .topic-card-link {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.2s;
  }
  .topic-card-link:hover {
    color: var(--color-primary-hover);
  }

  @media (max-width: 768px) {
    .tags-title { font-size: 2rem; }
    .specials-grid { grid-template-columns: 1fr; }
    .topics-grid { grid-template-columns: 1fr; }
  }
</style>
