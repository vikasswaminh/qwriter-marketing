---
import BaseLayout from '~/layouts/BlogBaseLayout.astro';
import PostCard from '~/components/blog/PostCard.astro';
import { getPublishedPosts, readingTime } from '~/utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Set<string>();
  for (const p of posts) for (const t of p.data.tags) tags.add(t);
  return [...tags].map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)), tag },
  }));
}

const { posts, tag } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <p class="post-eyebrow" style="margin: 0;"><a href="/blog">← Back to blogs</a></p>
    <p class="post-eyebrow" style="margin: 0;"><a href="/tags/">All tags →</a></p>
  </div>
  <h1 class="page-title" style="margin-top: 0;">#{tag}</h1>
  <div class="post-list">
    {
      posts.map((p) => (
        <PostCard
          url={`/blog/${p.slug}/`}
          title={p.data.title}
          description={p.data.description}
          pubDate={p.data.pubDate}
          tags={p.data.tags}
          minutes={readingTime(p.body)}
        />
      ))
    }
  </div>
</BaseLayout>
