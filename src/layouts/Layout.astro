---
import "~/styles/global.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  current?: string;
  /** Set to false on pages where the marketing nav/footer would feel out of
   *  place (e.g. the auth pages). */
  chrome?: boolean;
}

const {
  title = "OllaSuper — Build Your AI Workforce",
  description = "Deploy AI specialists across Sales, Marketing, HR, Operations, Finance, Support and Engineering from a single workspace. 30 specialists. 9 departments. Free tier.",
  current,
  chrome = true,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0066ff" />

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="OllaSuper" />
    <meta property="og:image" content="https://ollasuper.com/og-default.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_IN" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://ollasuper.com/og-default.svg" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    {/* Perf — preload the two font weights actually used above-the-fold
        (Lato 400 + 700) so they're requested in parallel with the CSS.
        Subsetted to latin (English only) to keep the per-weight file ~23 KB.
        Removed Google Fonts preconnects 2026-06-15 — fonts are self-hosted
        under /fonts/ on the same origin now. */}
    <link rel="preload" href="/fonts/Lato-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Lato-700-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/* Structured data — Organization + WebSite */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://ollasuper.com/#org",
          "name": "OllaSuper",
          "url": "https://ollasuper.com",
          "logo": "https://ollasuper.com/favicon.svg",
          "description": "AI Workforce Platform. Deploy AI specialists across Sales, Marketing, HR, Operations, Finance, Support and Engineering from a single workspace. 30 specialists. 9 departments. Multi-agent collaboration.",
          "sameAs": []
        },
        {
          "@type": "WebSite",
          "@id": "https://ollasuper.com/#site",
          "url": "https://ollasuper.com",
          "name": "OllaSuper",
          "publisher": { "@id": "https://ollasuper.com/#org" }
        }
      ]
    })} />
  </head>
  <body>
    {chrome && <Nav current={current} />}
    <main>
      <slot />
    </main>
    {chrome && <Footer />}
  </body>
</html>
