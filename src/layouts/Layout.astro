---
import "~/styles/global.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  current?: string;
  chrome?: boolean;
}

const {
  title = "OllaSuper — Your company. Powered by AI employees.",
  description = "Deploy intelligent AI employees that research, analyze, execute and automate real business workflows with enterprise observability and human governance.",
  current,
  chrome = true,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ViewTransitions />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#ff83da" />

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="OllaSuper" />
    <meta property="og:image" content="https://ollasuper.com/og-default.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://ollasuper.com/og-default.svg" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    {/* Preload and Load Lato (Google Fonts) */}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">

    {/* Machine-Readable Agentic Discoverability Link */}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Agent Readability Spec" />

    {/* Structured Data: JSON-LD */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://ollasuper.com/#org",
          "name": "OllaSuper",
          "url": "https://ollasuper.com",
          "logo": "https://ollasuper.com/favicon.svg",
          "description": "AI Workforce Platform. Deploy intelligent AI employees that research, analyze, execute, and automate business workflows with full observability.",
          "knowsAbout": ["AI Employees", "Model Context Protocol", "Autonomous Agents", "Workflow Automation"]
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://ollasuper.com/#software",
          "name": "OllaSuper AI Workforce Platform",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web, Cloud VPC",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://ollasuper.com/#site",
          "url": "https://ollasuper.com",
          "name": "OllaSuper",
          "publisher": { "@id": "https://ollasuper.com/#org" }
        }
      ]
    })} />
  </head>
  <body>
    <a href="#main-content" class="os-skip-link">Skip to main content</a>
    {chrome && <Nav current={current} />}
    <main id="main-content">
      <slot />
    </main>
    {chrome && <Footer />}

    <script>
      function initAnimations() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('os-revealed');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: "0px 0px -50px 0px"
        });

        document.querySelectorAll('.os-reveal').forEach((el) => {
          observer.observe(el);
        });

        // Magnetic CTAs
        const magnetics = document.querySelectorAll('.os-magnetic');
        magnetics.forEach((btn) => {
          btn.addEventListener('mousemove', (e) => {
            const el = e.currentTarget as HTMLElement;
            const rect = el.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            el.style.transform = `translate(${x * 0.3}px, ${y * 0.3}px)`;
          });
          btn.addEventListener('mouseleave', (e) => {
            const el = e.currentTarget as HTMLElement;
            el.style.transform = `translate(0px, 0px)`;
          });
        });

        // 3D Card Tilt Physics
        const tiltCards = document.querySelectorAll('.os-tilt');
        tiltCards.forEach((card) => {
          card.addEventListener('mousemove', (e) => {
            const el = e.currentTarget as HTMLElement;
            const rect = el.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            // Calculate rotation (max 6 degrees)
            const rotateX = ((y - centerY) / centerY) * -6; 
            const rotateY = ((x - centerX) / centerX) * 6;
            
            el.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
          });
          card.addEventListener('mouseleave', (e) => {
            const el = e.currentTarget as HTMLElement;
            el.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
          });
        });
      }

      // Run on initial load and after view transitions
      document.addEventListener('astro:page-load', initAnimations);
    </script>
  </body>
</html>
