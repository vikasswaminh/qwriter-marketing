---
import "~/styles/global.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  current?: string;
  chrome?: boolean;
}

const {
  title = "OllaSuper — Your company. Powered by AI employees.",
  description = "Deploy intelligent AI employees that research, analyze, execute and automate real business workflows with enterprise observability and human governance.",
  current,
  chrome = true,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#ff83da" />

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="OllaSuper" />
    <meta property="og:image" content="https://ollasuper.com/og-default.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://ollasuper.com/og-default.svg" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    {/* Preload Inter Variable Font */}
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />

    {/* Machine-Readable Agentic Discoverability Link */}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Agent Readability Spec" />

    {/* Structured Data: JSON-LD */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://ollasuper.com/#org",
          "name": "OllaSuper",
          "url": "https://ollasuper.com",
          "logo": "https://ollasuper.com/favicon.svg",
          "description": "AI Workforce Platform. Deploy intelligent AI employees that research, analyze, execute, and automate business workflows with full observability.",
          "knowsAbout": ["AI Employees", "Model Context Protocol", "Autonomous Agents", "Workflow Automation"]
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://ollasuper.com/#software",
          "name": "OllaSuper AI Workforce Platform",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web, Cloud VPC",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://ollasuper.com/#site",
          "url": "https://ollasuper.com",
          "name": "OllaSuper",
          "publisher": { "@id": "https://ollasuper.com/#org" }
        }
      ]
    })} />
  </head>
  <body>
    <a href="#main-content" class="os-skip-link">Skip to main content</a>
    {chrome && <Nav current={current} />}
    <main id="main-content">
      <slot />
    </main>
    {chrome && <Footer />}
  </body>
</html>
