---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '~/layouts/BlogBaseLayout.astro';
import { SITE } from '~/blog-config';

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: { depth: number; slug: string; text: string }[];
}
const { post } = Astro.props;
const { title, seoTitle, description, pubDate, updatedDate, author, tags, seoKeywords, cover } = post.data;

const canonical = new URL(`/blog/${post.slug}/`, Astro.site).href;

const leftPosts = [
  { slug: "rag-vs-fine-tuning-whats-the-difference", data: { title: "RAG vs Fine-Tuning: What's the Difference?" } },
  { slug: "ai-agent-frameworks-complete-guide", data: { title: "AI Agent Frameworks: The Complete Guide for Businesses (2026)" } },
  { slug: "ai-agents-vs-chatbots-whats-the-difference", data: { title: "AI Agents vs Chatbots: What's the Difference? A Clear 2026 Breakdown" } }
];

const rightPosts = [
  { slug: "how-to-build-an-ai-agent-for-your-business-step-by-step-guide", data: { title: "How to Build an AI Agent for Your Business: Step-by-Step Guide (2026)" } },
  { slug: "ai-agent-security-risks-threats-and-best-practices", data: { title: "AI Agent Security: Risks, Threats, and Best Practices" } },
  { slug: "ai-agent-use-cases-15-ways-businesses-are-using-ai-agents-in-2026", data: { title: "AI Agent Use Cases: 15 Ways Businesses Are Using AI Agents in 2026" } }
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: author ?? SITE.author },
  publisher: { '@type': 'Organization', name: SITE.brand },
  mainEntityOfPage: canonical,
  ...(cover ? { image: new URL(cover, Astro.site).href } : {}),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'OllaSuper',
      item: 'https://blogs.ollasuper.com/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: 'https://blogs.ollasuper.com/blog/'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: canonical
    }
  ]
};
---

<BaseLayout
  title={seoTitle || title}
  description={description}
  image={cover}
  className="article-container"
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: (updatedDate ?? pubDate).toISOString(),
    author: author ?? SITE.author,
    tags: seoKeywords ?? tags,
  }}
>
  <slot />
  
  <div id="left-sidebar-content" style="display: none;" aria-hidden="true">
    <nav style="margin-bottom: var(--spacing-32);">
      <span style="display: inline-block; padding: 4px 10px; font-size: 10px; font-weight: 800; color: #ffffff; background: var(--color-primary); border-radius: 9999px; margin-bottom: 16px; letter-spacing: 0.05em; text-transform: uppercase;">
        Essential Guides
      </span>
      <div style="display: flex; flex-direction: column; gap: 12px; width: 100%;">
        {leftPosts.map((p) => (
          <a href={`/blog/${p.slug}`} class="os-toc-link" style="display: block; padding: 12px 16px; border-radius: 8px; color: var(--color-body); text-decoration: none; font-size: 0.95rem; font-weight: 600; line-height: 1.4; transition: all 0.15s ease; border: 1px solid var(--color-border-light); background: #ffffff; box-shadow: var(--shadow-sm);">
            {p.data.title}
          </a>
        ))}
      </div>
    </nav>
  </div>

  <div id="right-sidebar-content" style="display: none;" aria-hidden="true">
    <aside class="blog-right-sidebar">
      <nav style="margin-bottom: var(--spacing-32);">
        <span style="display: inline-block; padding: 4px 10px; font-size: 10px; font-weight: 800; color: #ffffff; background: var(--color-primary); border-radius: 9999px; margin-bottom: 16px; letter-spacing: 0.05em; text-transform: uppercase;">
          Agent Workflows
        </span>
        <div style="display: flex; flex-direction: column; gap: 12px; width: 100%;">
          {rightPosts.map((p) => (
            <a href={`/blog/${p.slug}`} class="os-toc-link" style="display: block; padding: 12px 16px; border-radius: 8px; color: var(--color-body); text-decoration: none; font-size: 0.95rem; font-weight: 600; line-height: 1.4; transition: all 0.15s ease; border: 1px solid var(--color-border-light); background: #ffffff; box-shadow: var(--shadow-sm);">
              {p.data.title}
            </a>
          ))}
        </div>
      </nav>
    </aside>
  </div>

  <script is:inline defer>
    (function() {
      function injectSidebars() {
        const grid = document.querySelector('.blog-layout-grid');
        const rightContainer = document.getElementById('right-sidebar-content');
        const leftContainer = document.getElementById('left-sidebar-content');
        
        if (grid && rightContainer) {
          // Find the left sidebar by class (it's inside the markdown content)
          const leftSidebar = grid.querySelector('.blog-sidebar');
          
          if (leftSidebar && leftContainer) {
            // Forcefully inject left posts into the left sidebar
            leftSidebar.innerHTML = leftContainer.innerHTML;
          }
          
          // Inject the right sidebar if not already present
          if (!grid.querySelector('.blog-right-sidebar')) {
            const rightSidebar = rightContainer.firstElementChild.cloneNode(true);
            grid.appendChild(rightSidebar);
          }
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', injectSidebars);
      } else {
        injectSidebars();
      }
      document.addEventListener('astro:page-load', injectSidebars);
    })();
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BaseLayout>
