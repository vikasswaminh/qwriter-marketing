---
// One expressive square glyph per expert. Inline SVG — no network, no fonts,
// no JS. Each is drawn in the expert's department color over a soft tint;
// the visual metaphor is unique per persona.
//
// Usage:
//   <ExpertGlyph slug="hr" color="#ff6b4a" size={140} />
export interface Props {
  slug: string;
  color: string;
  size?: number;
  /** when true, draw on a transparent background (cards) */
  flat?: boolean;
}
const { slug, color, size = 140, flat = false } = Astro.props as Props;

// Soft tint = the color at ~10% alpha. Hex → rgba.
const hex = color.replace("#", "");
const r = parseInt(hex.substring(0, 2), 16);
const g = parseInt(hex.substring(2, 4), 16);
const b = parseInt(hex.substring(4, 6), 16);
const tint = `rgba(${r}, ${g}, ${b}, 0.08)`;
const tintStrong = `rgba(${r}, ${g}, ${b}, 0.18)`;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 140 140"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${slug} glyph`}
  style="flex-shrink: 0;"
>
  {!flat && <rect width="140" height="140" rx="14" fill={tint} />}

  {slug === "hr" && (
    <g>
      {/* Two figures shaking hands */}
      <circle cx="46" cy="50" r="12" fill={color} />
      <path d="M30 110 L30 82 Q30 70 46 70 Q62 70 62 82 L62 90" fill="none" stroke={color} stroke-width="6" stroke-linecap="round"/>
      <circle cx="94" cy="50" r="12" fill="none" stroke={color} stroke-width="5"/>
      <path d="M110 110 L110 82 Q110 70 94 70 Q78 70 78 82 L78 90" fill="none" stroke={color} stroke-width="6" stroke-linecap="round"/>
      <rect x="60" y="86" width="20" height="10" rx="2" fill={color}/>
    </g>
  )}

  {slug === "recruiter" && (
    <g>
      {/* Magnet attracting filings */}
      <path d="M40 40 L40 80 Q40 100 70 100 Q100 100 100 80 L100 40 L80 40 L80 80 Q80 86 70 86 Q60 86 60 80 L60 40 Z" fill={color}/>
      <rect x="40" y="40" width="20" height="14" fill="#fff"/>
      <rect x="80" y="40" width="20" height="14" fill="#fff"/>
      <circle cx="28" cy="30" r="3" fill={color}/>
      <circle cx="112" cy="30" r="3" fill={color}/>
      <circle cx="20" cy="50" r="3" fill={color}/>
      <circle cx="120" cy="50" r="3" fill={color}/>
    </g>
  )}

  {slug === "sales" && (
    <g>
      {/* Upward chart with arrow */}
      <path d="M22 110 L52 76 L74 96 L118 38" fill="none" stroke={color} stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M96 38 L118 38 L118 60" fill="none" stroke={color} stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="52" cy="76" r="5" fill={color}/>
      <circle cx="74" cy="96" r="5" fill={color}/>
      <line x1="22" y1="118" x2="118" y2="118" stroke={color} stroke-width="3" opacity="0.4"/>
    </g>
  )}

  {slug === "cs" && (
    <g>
      {/* Heart inside circle */}
      <circle cx="70" cy="70" r="46" fill="none" stroke={color} stroke-width="4"/>
      <path d="M70 92 C52 78 42 68 42 58 Q42 48 52 48 Q60 48 70 58 Q80 48 88 48 Q98 48 98 58 C98 68 88 78 70 92 Z" fill={color}/>
    </g>
  )}

  {slug === "support" && (
    <g>
      {/* Speech bubble with check */}
      <path d="M24 36 Q24 28 32 28 L108 28 Q116 28 116 36 L116 78 Q116 86 108 86 L60 86 L46 100 L46 86 L32 86 Q24 86 24 78 Z" fill={color}/>
      <path d="M52 56 L66 70 L92 44" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
  )}

  {slug === "marketing" && (
    <g>
      {/* Megaphone */}
      <path d="M30 60 L30 84 L60 84 L100 110 L100 36 L60 60 Z" fill={color}/>
      <path d="M108 50 Q120 60 120 70 Q120 80 108 90" fill="none" stroke={color} stroke-width="5" stroke-linecap="round"/>
      <path d="M114 38 Q132 56 132 70 Q132 84 114 102" fill="none" stroke={color} stroke-width="5" stroke-linecap="round" opacity="0.5"/>
    </g>
  )}

  {slug === "seo" && (
    <g>
      {/* Climbing bars + search lens */}
      <rect x="22" y="86" width="18" height="28" rx="2" fill={color} opacity="0.4"/>
      <rect x="48" y="68" width="18" height="46" rx="2" fill={color} opacity="0.7"/>
      <rect x="74" y="50" width="18" height="64" rx="2" fill={color}/>
      <circle cx="106" cy="42" r="14" fill="none" stroke={color} stroke-width="5"/>
      <line x1="116" y1="52" x2="126" y2="62" stroke={color} stroke-width="5" stroke-linecap="round"/>
    </g>
  )}

  {slug === "aeo" && (
    <g>
      {/* Brain / answer network */}
      <circle cx="70" cy="70" r="18" fill={color}/>
      <circle cx="32" cy="40" r="8" fill="none" stroke={color} stroke-width="3"/>
      <circle cx="108" cy="40" r="8" fill="none" stroke={color} stroke-width="3"/>
      <circle cx="32" cy="100" r="8" fill="none" stroke={color} stroke-width="3"/>
      <circle cx="108" cy="100" r="8" fill="none" stroke={color} stroke-width="3"/>
      <circle cx="70" cy="24" r="6" fill={color}/>
      <circle cx="70" cy="116" r="6" fill={color}/>
      <line x1="40" y1="45" x2="58" y2="62" stroke={color} stroke-width="2.5"/>
      <line x1="100" y1="45" x2="82" y2="62" stroke={color} stroke-width="2.5"/>
      <line x1="40" y1="95" x2="58" y2="78" stroke={color} stroke-width="2.5"/>
      <line x1="100" y1="95" x2="82" y2="78" stroke={color} stroke-width="2.5"/>
      <line x1="70" y1="32" x2="70" y2="52" stroke={color} stroke-width="2.5"/>
      <line x1="70" y1="88" x2="70" y2="108" stroke={color} stroke-width="2.5"/>
    </g>
  )}

  {slug === "operations" && (
    <g>
      {/* Interlocking gears */}
      <g transform="translate(48 50)">
        <circle r="22" fill={color}/>
        <circle r="9" fill="#fff"/>
        {Array.from({ length: 8 }, (_, i) => i).map(i => (
          <rect x="-3" y="-30" width="6" height="8" fill={color} transform={`rotate(${i * 45})`} />
        ))}
      </g>
      <g transform="translate(98 92)">
        <circle r="16" fill="none" stroke={color} stroke-width="4"/>
        <circle r="5" fill={color}/>
        {Array.from({ length: 6 }, (_, i) => i).map(i => (
          <rect x="-2.5" y="-22" width="5" height="6" fill={color} transform={`rotate(${i * 60})`} />
        ))}
      </g>
    </g>
  )}

  {slug === "finance" && (
    <g>
      {/* Rupee on stacked coins */}
      <ellipse cx="70" cy="98" rx="40" ry="8" fill={color} opacity="0.4"/>
      <ellipse cx="70" cy="86" rx="40" ry="8" fill={color} opacity="0.55"/>
      <ellipse cx="70" cy="74" rx="40" ry="8" fill={color} opacity="0.75"/>
      <ellipse cx="70" cy="62" rx="40" ry="8" fill={color}/>
      {/* ₹ */}
      <path d="M58 28 L82 28 M58 38 L82 38 M58 48 L66 48 Q78 48 78 38 Q78 28 66 28 L58 28 L58 56 L78 56" fill="none" stroke={color} stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
  )}

  {slug === "legal" && (
    <g>
      {/* Scales of justice */}
      <line x1="70" y1="28" x2="70" y2="110" stroke={color} stroke-width="6" stroke-linecap="round"/>
