  {slug === "founder" && (
    <g>
      {/* North star above mountain peak */}
      <path d="M70 22 L76 42 L96 42 L80 54 L86 74 L70 62 L54 74 L60 54 L44 42 L64 42 Z" fill={color}/>
      <path d="M22 118 L52 80 L70 100 L96 70 L118 118 Z" fill="none" stroke={color} stroke-width="5" stroke-linejoin="round"/>
      <path d="M52 80 L62 92 L70 100" fill={color} opacity="0.3"/>
    </g>
  )}

  {slug === "career" && (
    <g>
      {/* Compass with N arrow */}
      <circle cx="70" cy="70" r="44" fill="none" stroke={color} stroke-width="5"/>
      <circle cx="70" cy="70" r="6" fill={color}/>
      <path d="M70 30 L78 70 L70 66 L62 70 Z" fill={color}/>
      <path d="M70 110 L62 70 L70 74 L78 70 Z" fill="none" stroke={color} stroke-width="3"/>
      <text x="70" y="24" text-anchor="middle" font-family="Lato" font-weight="900" font-size="11" fill={color}>N</text>
    </g>
  )}

  {/* ──────────────────── 11 NEW US-FOCUSED AGENT GLYPHS ──────────────────── */}

  {slug === "sdr" && (
    <g>
      {/* Bullseye target with arrow */}
      <circle cx="70" cy="70" r="42" fill="none" stroke={color} stroke-width="4"/>
      <circle cx="70" cy="70" r="28" fill="none" stroke={color} stroke-width="3"/>
      <circle cx="70" cy="70" r="14" fill="none" stroke={color} stroke-width="3"/>
      <circle cx="70" cy="70" r="5" fill={color}/>
      {/* Arrow through center */}
      <line x1="22" y1="22" x2="62" y2="62" stroke={color} stroke-width="4" stroke-linecap="round"/>
      <path d="M62 62 L72 60 L70 70 Z" fill={color}/>
      <path d="M22 22 L34 18 L26 30 Z" fill={color}/>
    </g>
  )}

  {slug === "soc2" && (
    <g>
      {/* Shield with checkmark */}
      <path d="M70 18 L106 32 L106 68 Q106 94 70 116 Q34 94 34 68 L34 32 Z" fill={color}/>
      <path d="M50 70 L64 84 L92 54" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
