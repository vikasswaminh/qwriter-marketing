      <circle cx="42" cy="50" r="20" fill={color}/>
      <rect x="74" y="30" width="40" height="40" rx="4" fill="none" stroke={color} stroke-width="5"/>
      <path d="M70 110 L42 80 L98 80 Z" fill="none" stroke={color} stroke-width="5" stroke-linejoin="round"/>
    </g>
  )}

  {slug === "pm" && (
    <g>
      {/* Kanban board — 3 columns with cards */}
      <rect x="22" y="28" width="32" height="84" rx="3" fill="none" stroke={color} stroke-width="3"/>
      <rect x="54" y="28" width="32" height="84" rx="3" fill="none" stroke={color} stroke-width="3"/>
      <rect x="86" y="28" width="32" height="84" rx="3" fill="none" stroke={color} stroke-width="3"/>
      <rect x="26" y="36" width="24" height="12" rx="2" fill={color} opacity="0.4"/>
      <rect x="26" y="52" width="24" height="12" rx="2" fill={color} opacity="0.4"/>
      <rect x="58" y="36" width="24" height="12" rx="2" fill={color} opacity="0.7"/>
      <rect x="58" y="52" width="24" height="12" rx="2" fill={color} opacity="0.7"/>
      <rect x="58" y="68" width="24" height="12" rx="2" fill={color} opacity="0.7"/>
      <rect x="90" y="36" width="24" height="12" rx="2" fill={color}/>
    </g>
  )}

  {slug === "writer" && (
    <g>
