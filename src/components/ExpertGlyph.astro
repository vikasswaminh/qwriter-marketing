      <line x1="30" y1="42" x2="110" y2="42" stroke={color} stroke-width="4" stroke-linecap="round"/>
      <path d="M22 70 L30 42 L38 70 Z" fill={color}/>
      <path d="M102 70 L110 42 L118 70 Z" fill={color}/>
      <circle cx="70" cy="28" r="6" fill={color}/>
