  {slug === "ma" && (
    <g>
      {/* Two arrows merging into one */}
      <path d="M22 36 L56 56 L62 70" fill="none" stroke={color} stroke-width="5" stroke-linecap="round"/>
      <path d="M118 36 L84 56 L78 70" fill="none" stroke={color} stroke-width="5" stroke-linecap="round"/>
      <path d="M70 70 L70 110" stroke={color} stroke-width="6" stroke-linecap="round"/>
      <path d="M58 100 L70 116 L82 100" fill="none" stroke={color} stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="22" cy="36" r="6" fill={color}/>
      <circle cx="118" cy="36" r="6" fill={color}/>
