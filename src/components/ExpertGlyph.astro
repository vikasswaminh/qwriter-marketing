  {slug === "engineering" && (
    <g>
      {/* Code brackets */}
      <path d="M48 28 L20 70 L48 112" fill="none" stroke={color} stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M92 28 L120 70 L92 112" fill="none" stroke={color} stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
      <line x1="80" y1="38" x2="60" y2="102" stroke={color} stroke-width="6" stroke-linecap="round"/>
