---
import { AI_EMPLOYEES } from "~/data/employees";
---

<section id="employees" class="os-section os-reveal" style="padding: 24px 0 32px; background: var(--bg-soft);">
  <div class="os-container">
    
    {/* Section Header */}
    <div class="os-section-header" style="margin-bottom: 24px;">
      <div class="os-eyebrow">
        YOUR AI TEAM
      </div>
      <h2 class="os-h2">
        Meet Your AI Team.
      </h2>
      <p class="os-lead">
        Not chatbots. Specialists. Each one with their own role, voice, and tools — ready to ship real work from day one.
      </p>
    </div>

    {/* Filter Buttons */}
    <div class="os-filter-bar" style="display: flex; justify-content: center; gap: 8px; margin-bottom: 32px; flex-wrap: wrap;">
      <button class="os-filter-btn active" data-category="all">All Employees</button>
      <button class="os-filter-btn" data-category="research">Research</button>
      <button class="os-filter-btn" data-category="sales">Sales</button>
      <button class="os-filter-btn" data-category="marketing">Marketing</button>
      <button class="os-filter-btn" data-category="support">Support</button>
      <button class="os-filter-btn" data-category="operations">Operations</button>
      <button class="os-filter-btn" data-category="custom">Custom</button>
    </div>

    {/* Employee Grid */}
    <div class="os-employee-grid os-grid-3">
      {AI_EMPLOYEES.map((emp) => (
        <article 
          class="os-employee-card-static" 
          data-category={emp.category}
        >
          <div style="flex: 1;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
              <div>
                <h3 style="font-size: 20px; font-weight: 800; color: var(--text-primary); margin-bottom: 4px;">{emp.name}</h3>
                <div style="font-size: 13px; color: var(--text-muted); font-weight: 600;">{emp.role}</div>
              </div>
            </div>

            <p style="font-size: 15px; line-height: 1.6; color: var(--text-secondary); margin-bottom: 24px;">
              {emp.purpose}
            </p>
          </div>

          <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border-light); padding-top: 24px; margin-top: auto;">
            <div>
              <div class="os-caption" style="color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">Average Time Saved</div>
              <div class="os-small" style="font-weight: 700; color: var(--text-primary);">{emp.stats.avgTimeSaved}</div>
            </div>
            <a href={`/ai-employees/${emp.slug}`} class="os-btn os-btn-primary" style="padding: 8px 16px; font-size: 13px;">
              Deploy →
            </a>
          </div>
        </article>
      ))}
    </div>

    {/* Bottom Discovery Prompt */}
    <div style="text-align: center; margin-top: 32px;">
      <a href="/ai-employees" class="os-btn os-btn-dark os-magnetic" style="padding: 12px 28px; font-size: 14px;">
        Explore All AI Employee Specs & Capabilities →
      </a>
    </div>

  </div>
</section>

<style>
  .os-filter-bar {
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .os-filter-bar::-webkit-scrollbar {
    display: none;
  }

  .os-filter-btn {
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-medium);
    background: #ffffff;
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
    flex: 0 0 auto;
  }
  .os-filter-btn:hover {
    background: var(--bg-blue-tint);
    border-color: var(--text-primary);
    color: var(--text-primary);
  }
  .os-filter-btn.active {
    background: var(--text-primary) !important;
    color: #ffffff !important;
    border-color: var(--text-primary) !important;
  }
  
  .os-employee-card-static {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.5) 100%);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 2px solid #DC143C;
    border-left: 6px solid #DC143C;
    border-radius: 20px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.03), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    min-width: 0;
  }
  
  .os-employee-card-static::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border-radius: 18px;
    padding: 2px;
    background: linear-gradient(135deg, rgba(220, 20, 60, 0.4), rgba(0, 136, 204, 0.4));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .os-employee-card-static:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08), 0 0 20px rgba(220, 20, 60, 0.05);
  }

  .os-employee-card-static:hover::before {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .os-employee-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }

  @media (max-width: 640px) {
    .os-section {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }

    .os-filter-bar {
      justify-content: flex-start;
      padding-bottom: 4px;
    }

    .os-employee-grid {
      grid-template-columns: 1fr !important;
      gap: 16px !important;
    }

    .os-employee-card-static {
      padding: 20px !important;
      border-left-width: 5px !important;
      border-radius: 16px !important;
    }

    .os-employee-card-static > div:last-child {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 14px;
    }

    .os-employee-card-static .os-btn {
      width: 100%;
    }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll('.os-filter-btn');
  const cards = document.querySelectorAll('.os-employee-card-static');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const category = btn.getAttribute('data-category');
      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-category');
        if (category === 'all' || cardCat === category) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
