---
const stages = [
  {
    step: 1,
    title: "1. Understand Request",
    action: "Parse natural language goal, isolate constraints & geofence",
    tool: "Reasoning Core (NLP Engine)",
    detail: "Extracted intent: Identify commercial plumbing companies in Austin, TX with revenue > $2M. Extracted 4 strict filtering constraints.",
    status: "done",
    payload: `{\n  "industry": "Commercial Plumbing",\n  "location": "Austin, TX",\n  "min_revenue": 2000000,\n  "lead_count": 25\n}`
  },
  {
    step: 2,
    title: "2. Source & Query",
    action: "Execute federated searches across Maps, registries, and licensing boards",
    tool: "mcp_web_scrape & mcp_registry_search",
    detail: "Dispatched parallel headless workers across Texas State Board of Plumbing Examiners and Google Maps API. Collected 118 raw entities.",
    status: "done",
    payload: `{\n  "sources_scraped": 4,\n  "raw_entities_found": 118,\n  "proxy_mode": "residential_rotating"\n}`
  },
  {
    step: 3,
    title: "3. Collect & Enrich",
    action: "Extract phone, email, owner names, LinkedIn profiles, and license status",
    tool: "mcp_firmographic_enricher",
    detail: "Cross-referenced business registry filings against LinkedIn Company pages and domain MX records. Verified 94 active business domains.",
    status: "done",
    payload: `{\n  "emails_verified": 94,\n  "decision_makers_found": 88,\n  "smtp_check": "valid_mailbox"\n}`
  },
  {
    step: 4,
    title: "4. Score & Filter",
    action: "Run revenue estimation heuristic and eliminate residential-only operators",
    tool: "Internal Evaluation Filter",
    detail: "Eliminated 63 residential-only plumbers. Scored remaining 31 candidates on commercial fleet size, Yelp rating, and revenue confidence.",
    status: "done",
    payload: `{\n  "commercial_fit_rate": "98.2%",\n  "filtered_count": 25,\n  "confidence_score": 0.96\n}`
  },
  {
    step: 5,
    title: "5. Deliver & Sync",
    action: "Output structured dossier and two-way sync into CRM & Notion",
    tool: "mcp_salesforce_sync & mcp_notion_export",
    detail: "Created 25 enriched accounts in Salesforce under 'Austin-Commercial-Plumbing'. Generated executive Notion summary table.",
    status: "done",
    payload: `{\n  "status": "delivered",\n  "accounts_synced": 25,\n  "export_formats": ["Salesforce", "Notion", "CSV"],\n  "time_elapsed": "42.8s"\n}`
  }
];
---

<section class="os-section" style="padding: 100px 0; background: #0c0f17; color: #ffffff;">
  <div class="os-container">
    
    <div class="os-section-header" style="color: #ffffff;">
      <div class="os-eyebrow" style="color: var(--candy-pink);">
        <span class="os-live-dot"></span> LIVE INTERACTIVE WORKFLOW
      </div>
      <h2 class="os-h2" style="color: #ffffff;">
        See how an AI employee turns a goal into audited execution.
      </h2>
      <p class="os-lead" style="color: #94a3b8;">
        Watch the multi-stage autonomous reasoning chain execute in real-time. Click any stage to inspect the underlying tool payload.
      </p>
    </div>

    {/* Interactive Workflow Container */}
    <div style="background: #131926; border: 1px solid #1e293b; border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-xl);">
      
      {/* Target Prompt Banner */}
      <div style="background: #1a2336; padding: 20px 28px; border-bottom: 1px solid #1e293b; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 14px;">
          <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255, 131, 218, 0.15); border: 1px solid rgba(255, 131, 218, 0.3); display: flex; align-items: center; justify-content: center; font-size: 18px;">
            🔍
          </div>
          <div>
            <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--candy-pink);">Target Human Goal</div>
            <div style="font-size: 15px; font-weight: 600; color: #ffffff;">"Find 25 qualified commercial plumbing companies in Austin with > $2M revenue."</div>
          </div>
        </div>
        <div style="display: flex; align-items: center; gap: 10px;">
          <span class="os-badge os-badge-green" style="background: rgba(22, 163, 74, 0.2); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.3);">
            ✓ 25 Leads Verified
          </span>
          <span style="font-family: var(--font-mono); font-size: 12px; color: #64748b;">42.8s total</span>
        </div>
      </div>

      {/* Scrubber & Detail Split View */}
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0;">
        
        {/* Left: Step Nodes Scrubber */}
        <div style="padding: 32px; border-right: 1px solid #1e293b; display: flex; flex-direction: column; gap: 14px;">
          <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #64748b; margin-bottom: 8px;">
            Autonomous Execution Sequence (Click to inspect)
          </div>

          {stages.map((stage, i) => (
            <button class={`os-step-btn ${i === 0 ? 'active' : ''}`} data-step-index={i} style="text-align: left; background: #182030; border: 1px solid #26334d; border-radius: var(--radius-md); padding: 14px 18px; cursor: pointer; transition: all 0.15s ease; display: flex; justify-content: space-between; align-items: center;">
              <div>
                <div style="font-size: 14px; font-weight: 600; color: #ffffff; margin-bottom: 2px;">{stage.title}</div>
                <div style="font-size: 12px; color: #94a3b8;">{stage.action}</div>
              </div>
              <div style="font-size: 16px; color: #4ade80;">✓</div>
            </button>
          ))}
        </div>

        {/* Right: Live Step Inspector */}
        <div style="padding: 32px; background: #0c101a; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
              <span id="os-step-badge" class="os-badge os-badge-pink" style="font-size: 11px;">
                STAGE 1 / 5
              </span>
              <span id="os-tool-name" style="font-family: var(--font-mono); font-size: 12px; color: #38bdf8;">
                TOOL: Reasoning Core
              </span>
            </div>

            <h3 id="os-step-title" style="font-size: 18px; font-weight: 700; color: #ffffff; margin-bottom: 8px;">
              1. Understand Request
            </h3>
            <p id="os-step-detail" style="font-size: 14px; color: #cbd5e1; line-height: 1.6; margin-bottom: 20px;">
              Extracted intent: Identify commercial plumbing companies in Austin, TX with revenue > $2M. Extracted 4 strict filtering constraints.
            </p>

            {/* Code / Payload Viewer */}
            <div class="os-terminal">
              <div class="os-terminal-header">
                <span style="font-size: 11px; color: #64748b;">tool_input_output.json</span>
                <span style="font-size: 11px; color: #4ade80;">200 OK</span>
              </div>
              <pre class="os-terminal-body" id="os-step-payload" style="color: #38bdf8; font-size: 12px; margin: 0;">{stages[0].payload}</pre>
            </div>
          </div>

          <div style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #1e293b; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 12px; color: #64748b;">Deterministic Audit Trail Guaranteed</span>
            <a href="/platform#observe" style="font-size: 12px; font-weight: 600; color: var(--candy-pink); text-decoration: none;">
              Inspect Observability Suite →
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  .os-step-btn:hover {
    border-color: #475569;
    background: #1e293b;
  }
  .os-step-btn.active {
    border-color: var(--candy-pink) !important;
    background: #1f273b !important;
  }
  @media (max-width: 900px) {
    section div[style*="grid-template-columns: 1.1fr 1.3fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script define:vars={{ stages }}>
  const buttons = document.querySelectorAll('.os-step-btn');
  const badge = document.getElementById('os-step-badge');
  const toolName = document.getElementById('os-tool-name');
  const title = document.getElementById('os-step-title');
  const detail = document.getElementById('os-step-detail');
  const payload = document.getElementById('os-step-payload');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.getAttribute('data-step-index') || '0', 10);
      const stage = stages[idx];

      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      if (badge) badge.innerText = `STAGE ${stage.step} / 5`;
      if (toolName) toolName.innerText = `TOOL: ${stage.tool}`;
      if (title) title.innerText = stage.title;
      if (detail) detail.innerText = stage.detail;
      if (payload) payload.innerText = stage.payload;
    });
  });
</script>
