---
import Logo from "~/components/Logo.astro";
const year = 2026;
---
<footer style="border-top: 1px solid var(--rule); margin-top: 0; background: var(--bg-sunken);">
  <div class="qw-section" style="display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr; gap: 40px; padding: 64px 0;">
    <div>
      <Logo size={32} wordmark={true} />
      <p style="color: var(--ink-3); margin-top: 16px; max-width: 300px; font-size: 14px; line-height: 1.6;">
        The AI Workforce Platform. 80 chat-driven Experts that advise, plus 6 Agents that take
        scheduled actions with approval gates — all on infrastructure we own.
      </p>
    </div>
    <div>
      <div class="qw-eyebrow qw-eyebrow-caps" style="margin-bottom: 16px;">○ EXPERTS</div>
      <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
        <li><a href="/experts" style="color: var(--ink-2);">All 80 Experts</a></li>
        <li><a href="/experts/hr" style="color: var(--ink-2);">HR</a></li>
        <li><a href="/experts/sales" style="color: var(--ink-2);">Sales</a></li>
        <li><a href="/experts/seo" style="color: var(--ink-2);">SEO</a></li>
        <li><a href="/experts/aeo" style="color: var(--ink-2);">AEO</a></li>
      </ul>
    </div>
    <div>
      <div class="qw-eyebrow qw-eyebrow-caps" style="margin-bottom: 16px;">⚡ AGENTS</div>
      <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
        <li><a href="/agents" style="color: var(--ink-2);">All 6 Agents</a></li>
        <li><a href="/agents/outbound-sdr" style="color: var(--ink-2);">Outbound SDR</a></li>
        <li><a href="/agents/seo-auditor" style="color: var(--ink-2);">SEO Auditor</a></li>
        <li><a href="/agents/inbox-triage" style="color: var(--ink-2);">Inbox Triage</a></li>
        <li><a href="/agents/deep-research" style="color: var(--ink-2);">Deep Research</a></li>
      </ul>
    </div>
    <div>
      <div class="qw-eyebrow qw-eyebrow-caps" style="margin-bottom: 16px;">PRODUCT</div>
      <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
        <li><a href="/how-it-works" style="color: var(--ink-2);">How it works</a></li>
        <li><a href="/pricing" style="color: var(--ink-2);">Pricing</a></li>
        <li><a href="/changelog" style="color: var(--ink-2);">Changelog</a></li>
        <li><a href="https://app.ollasuper.com/auth" style="color: var(--ink-2);">Sign in</a></li>
      </ul>
    </div>
    <div>
      <div class="qw-eyebrow qw-eyebrow-caps" style="margin-bottom: 16px;">COMPANY</div>
      <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
        <li><a href="mailto:hello@ollasuper.com" style="color: var(--ink-2);">Contact</a></li>
        <li><a href="mailto:support@ollasuper.com" style="color: var(--ink-2);">Support</a></li>
      </ul>
    </div>
    <div>
      <div class="qw-eyebrow qw-eyebrow-caps" style="margin-bottom: 16px;">LEGAL</div>
      <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
        <li><a href="/legal/privacy" style="color: var(--ink-2);">Privacy</a></li>
        <li><a href="/legal/terms" style="color: var(--ink-2);">Terms</a></li>
        <li><a href="/legal/dpa" style="color: var(--ink-2);">DPDP / DPA</a></li>
      </ul>
    </div>
  </div>
  <div style="border-top: 1px solid var(--rule-soft);">
    <div class="qw-section" style="padding: 18px 0; display: flex; justify-content: space-between; font-size: 12px; color: var(--ink-3);">
      <span>© {year} OllaSuper · Made in India</span>
      <span>ollasuper.com</span>
    </div>
  </div>
</footer>
