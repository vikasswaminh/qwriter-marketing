---
import Logo from "~/components/Logo.astro";
import { AI_EMPLOYEES } from "~/data/employees";
import { PLATFORM_MODULES } from "~/data/platform";
import { SOLUTIONS } from "~/data/solutions";
---

<footer class="os-footer" style="background-color: #0b0d13; color: #94a3b8; padding: 80px 0 40px; border-top: 1px solid #1e293b; margin-top: auto;">
  <div class="os-container">
    {/* Main 5-Column Grid */}
    <div style="display: grid; grid-template-columns: 2fr repeat(4, 1fr); gap: 48px; margin-bottom: 64px;">
      
      {/* Brand Column */}
      <div style="display: flex; flex-direction: column; gap: 20px;">
        <a href="/" style="display: inline-flex; align-items: center; filter: invert(1) hue-rotate(180deg);">
          <Logo size={32} wordmark={true} />
        </a>
        <p style="font-size: 14px; line-height: 1.6; color: #94a3b8; max-width: 300px;">
          The enterprise AI Workforce Platform. Deploy specialized AI employees that research, analyze, execute, and automate business workflows with full human governance.
        </p>
        <div style="display: flex; align-items: center; gap: 12px;">
          <span class="os-badge os-badge-green" style="background: rgba(22, 163, 74, 0.15); color: #4ade80; border-color: rgba(74, 222, 128, 0.3);">
            <span class="os-live-dot"></span> All Systems Operational
          </span>
          <span style="font-size: 12px; color: #64748b;">SOC2 Type II</span>
        </div>
      </div>

      {/* Platform Column */}
      <div>
        <h4 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #ffffff; margin-bottom: 20px;">
          Platform
        </h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 14px;">
          {PLATFORM_MODULES.map((mod) => (
            <li>
              <a href={`/platform#${mod.slug}`} style="color: #cbd5e1; text-decoration: none; transition: color 0.15s ease;" class="os-footer-link">
                {mod.title}
              </a>
            </li>
          ))}
          <li>
            <a href="/platform" style="color: var(--candy-pink); font-weight: 600; text-decoration: none;" class="os-footer-link">
              MCP Architecture →
            </a>
          </li>
        </ul>
      </div>

      {/* AI Employees Column */}
      <div>
        <h4 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #ffffff; margin-bottom: 20px;">
          AI Employees
        </h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 14px;">
          {AI_EMPLOYEES.map((emp) => (
            <li>
              <a href={`/ai-employees/${emp.slug}`} style="color: #cbd5e1; text-decoration: none; transition: color 0.15s ease;" class="os-footer-link">
                {emp.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/ai-employees" style="color: var(--candy-pink); font-weight: 600; text-decoration: none;" class="os-footer-link">
              Explore All Employees →
            </a>
          </li>
        </ul>
      </div>

      {/* Solutions Column */}
      <div>
        <h4 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #ffffff; margin-bottom: 20px;">
          Solutions
        </h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 14px;">
          {SOLUTIONS.map((sol) => (
            <li>
              <a href={`/solutions#${sol.slug}`} style="color: #cbd5e1; text-decoration: none; transition: color 0.15s ease;" class="os-footer-link">
                {sol.department}
              </a>
            </li>
          ))}
          <li>
            <a href="/solutions#enterprise" style="color: #cbd5e1; text-decoration: none;" class="os-footer-link">
              Enterprise VPC
            </a>
          </li>
        </ul>
      </div>

      {/* Resources & Machine Agent Spec */}
      <div>
        <h4 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #ffffff; margin-bottom: 20px;">
          Resources & Agentic
        </h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 14px;">
          <li><a href="/resources" style="color: #cbd5e1; text-decoration: none;" class="os-footer-link">Knowledge Hub</a></li>
          <li><a href="/blog" style="color: #cbd5e1; text-decoration: none;" class="os-footer-link">Blog & Insights</a></li>
          <li><a href="/resources#guides" style="color: #cbd5e1; text-decoration: none;" class="os-footer-link">Deployment Guides</a></li>
          <li><a href="/pricing" style="color: #cbd5e1; text-decoration: none;" class="os-footer-link">Pricing & Plans</a></li>
          <li><a href="/demo" style="color: #cbd5e1; text-decoration: none;" class="os-footer-link">Book a Demo</a></li>
          <li style="padding-top: 8px; border-top: 1px solid #1e293b;">
            <a href="/llms.txt" style="color: #38bdf8; font-family: var(--font-mono); font-size: 12px; text-decoration: none;" class="os-footer-link" target="_blank" rel="noopener">
              📄 /llms.txt (Agent Spec)
            </a>
          </li>
        </ul>
      </div>

    </div>

    {/* Bottom Bar */}
    <div style="padding-top: 32px; border-top: 1px solid #1e293b; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; font-size: 13px; color: #64748b;">
      <div>
        © {new Date().getFullYear()} OllaSuper Technologies Inc. All rights reserved.
      </div>
      <div style="display: flex; gap: 24px;">
        <a href="/privacy" style="color: #64748b; text-decoration: none;">Privacy Policy</a>
        <a href="/terms" style="color: #64748b; text-decoration: none;">Terms of Service</a>
        <a href="/security" style="color: #64748b; text-decoration: none;">Security & Trust</a>
        <a href="/sitemap.xml" style="color: #64748b; text-decoration: none;">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .os-footer-link:hover {
    color: #ffffff !important;
  }
  @media (max-width: 900px) {
    footer div[style*="grid-template-columns"] {
      grid-template-columns: 1fr !important;
      gap: 36px !important;
    }
  }
</style>
