---
const year = new Date().getFullYear();
---
<footer style="border-top: 1px solid var(--rule); margin-top: 96px; background: var(--bone);">
  <div class="qw-section" style="display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 40px; padding: 64px 32px;">
    <div>
      <a href="/" style="font-size: 24px; font-weight: 600; letter-spacing: -0.025em; color: var(--ink);">qwriter</a>
      <p style="color: var(--ink-3); margin-top: 14px; max-width: 280px; font-size: 14px; line-height: 1.55;">
        AI copywriter built around your customer's site. Ground in real content, write less generic copy.
      </p>
    </div>
    <div>
      <div class="qw-eyebrow" style="margin-bottom: 14px;">PRODUCT</div>
      <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
        <li><a href="/features" style="color: var(--ink-2);">Features</a></li>
        <li><a href="/sources" style="color: var(--ink-2);">Sources</a></li>
        <li><a href="/pricing" style="color: var(--ink-2);">Pricing</a></li>
        <li><a href="/journal" style="color: var(--ink-2);">Journal</a></li>
      </ul>
    </div>
    <div>
      <div class="qw-eyebrow" style="margin-bottom: 14px;">COMPANY</div>
      <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
        <li><a href="mailto:hello@qwriter.com" style="color: var(--ink-2);">Contact</a></li>
        <li><a href="/journal" style="color: var(--ink-2);">Changelog</a></li>
      </ul>
    </div>
    <div>
      <div class="qw-eyebrow" style="margin-bottom: 14px;">LEGAL</div>
      <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
        <li><a href="/legal/privacy" style="color: var(--ink-2);">Privacy</a></li>
        <li><a href="/legal/terms" style="color: var(--ink-2);">Terms</a></li>
      </ul>
    </div>
  </div>
  <div style="border-top: 1px solid var(--rule);">
    <div class="qw-section" style="padding: 18px 32px; display: flex; justify-content: space-between; font-size: 12px; color: var(--ink-3);">
      <span class="qw-mono">© {year} QWRITER · MADE WITH WARMTH</span>
      <span class="qw-mono">QWRITER.COM</span>
    </div>
  </div>
</footer>
