---
---

<section id="platform" class="os-section" style="padding: 48px 0; background: var(--bg-soft);">
  <div class="os-container">
    
    <div class="os-section-header">
      <div class="os-eyebrow">
        <span class="os-live-dot"></span> AI WORKFORCE PLATFORM
      </div>
      <h2 class="os-h2">
        A complete operating system for autonomous enterprise work.
      </h2>
      <p class="os-lead">
        Beyond prompt engineering. Orchestrate, observe, evaluate, automate, and integrate your AI employee fleet from a single mission control.
      </p>
    </div>

    {/* Bento Grid */}
    <div class="os-bento-grid">
      
      {/* 1. Large Hero Bento: AI Workforce Dashboard (Span 8) */}
      <div class="os-card os-col-8 bento-gradient-card" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid transparent; background: rgba(30, 120, 255, 0.05); min-height: 380px;">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div>
              <span class="os-badge os-badge-pink" style="margin-bottom: 8px;">Core Platform</span>
              <h3 style="font-size: 22px; font-weight: 700; color: var(--text-primary); margin-bottom: 6px;">AI Workforce Hub</h3>
              <p style="font-size: 14px; color: var(--text-secondary); max-width: 500px;">
                Centrally assign business goals, manage team permissions, coordinate multi-agent handoffs, and monitor organizational productivity.
              </p>
            </div>
            <div style="text-align: right;">
              <div style="font-size: 24px; font-weight: 800; color: var(--text-primary);">10,000+</div>
              <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase;">Agent Capacity</div>
            </div>
          </div>

          {/* Interactive UI Mockup */}
          <div style="background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 18px; box-shadow: var(--shadow-sm); display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;">
            <div style="padding: 12px; border-radius: 8px; background: var(--bg-blue-tint); border: 1px solid var(--border-light);">
              <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 2px;">Active Squads</div>
              <div style="font-size: 18px; font-weight: 700; color: var(--text-primary);">12 Fleets</div>
              <div style="font-size: 11px; color: var(--status-green);">● 100% Online</div>
            </div>
            <div style="padding: 12px; border-radius: 8px; background: var(--bg-blue-tint); border: 1px solid var(--border-light);">
              <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 2px;">Today's Tasks</div>
              <div style="font-size: 18px; font-weight: 700; color: var(--text-primary);">1,429 Done</div>
              <div style="font-size: 11px; color: var(--text-muted);">Avg 38s / task</div>
            </div>
            <div style="padding: 12px; border-radius: 8px; background: var(--bg-blue-tint); border: 1px solid var(--border-light);">
              <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 2px;">Accuracy SLA</div>
              <div style="font-size: 18px; font-weight: 700; color: var(--text-primary);">99.2%</div>
              <div style="font-size: 11px; color: var(--status-green);">Deterministic</div>
            </div>
          </div>
        </div>

        <div style="margin-top: 20px; display: flex; justify-content: space-between; align-items: center;">
          <span style="font-size: 13px; font-weight: 600; color: var(--red-primary);">Role-Based Access Control (RBAC) & Team Workspaces</span>
          <a href="/platform#workforce" style="font-size: 13px; font-weight: 600; color: var(--text-primary);">Explore Hub →</a>
        </div>
      </div>

      {/* 2. Observe: Real-Time Tracing (Span 4) */}
      <div class="os-card os-col-4 os-card-dark" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid #262626;">
        <div>
          <span class="os-badge" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); margin-bottom: 12px;">
            Deep Tracing
          </span>
          <h3 style="font-size: 20px; font-weight: 700; color: #ffffff; margin-bottom: 6px;">Observe</h3>
          <p style="font-size: 13px; color: #94a3b8; margin-bottom: 16px;">
            Inspect LLM reasoning chains, tool latency, token consumption, and decisions with millisecond precision.
          </p>

          <div style="background: #141a29; border: 1px solid #1e293b; border-radius: 8px; padding: 12px; font-family: var(--font-mono); font-size: 11px; color: #cbd5e1; display: flex; flex-direction: column; gap: 6px;">
            <div style="color: #4ade80;">✓ trace_id: tr_992a (342ms)</div>
            <div style="color: #38bdf8;">→ tool: mcp_sql_query (12 rows)</div>
            <div style="color: #facc15;">● tokens: 1,420 ($0.002)</div>
          </div>
        </div>

        <div style="margin-top: 20px;">
          <a href="/platform#observe" style="font-size: 13px; font-weight: 600; color: var(--blue-primary); text-decoration: none;">
            Explore Observability →
          </a>
        </div>
      </div>

      {/* 3. Evaluate: Test Bench (Span 4) */}
      <div class="os-card os-col-4 bento-gradient-card" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid transparent; background: rgba(30, 120, 255, 0.05);">
        <div>
          <span class="os-badge os-badge-green" style="margin-bottom: 12px;">Quality Assurance</span>
          <h3 style="font-size: 20px; font-weight: 700; color: var(--text-primary); margin-bottom: 6px;">Evaluate</h3>
          <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 16px;">
            Run golden test datasets with 250+ assertions. Benchmark accuracy and cost before deploying updates to production.
          </p>

          <div style="border: 1px solid var(--border-light); border-radius: 8px; padding: 12px; background: var(--bg-blue-tint);">
            <div style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; margin-bottom: 6px;">
              <span>Golden Suite (48/48 passed)</span>
              <span style="color: var(--status-green);">100%</span>
            </div>
            <div style="height: 6px; width: 100%; background: #e2e8f0; border-radius: 999px; overflow: hidden;">
              <div style="height: 100%; width: 100%; background: var(--status-green);"></div>
            </div>
          </div>
        </div>

        <div style="margin-top: 20px;">
          <a href="/platform#evaluate" style="font-size: 13px; font-weight: 600; color: var(--text-primary);">
            Explore Evaluation →
          </a>
        </div>
      </div>

      {/* 4. Automate: Trigger Engine (Span 4) */}
      <div class="os-card os-col-4 bento-gradient-card" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid transparent; background: rgba(30, 120, 255, 0.05);">
        <div>
          <span class="os-badge os-badge-pink" style="margin-bottom: 12px;">Continuous Ops</span>
          <h3 style="font-size: 20px; font-weight: 700; color: var(--text-primary); margin-bottom: 6px;">Automate</h3>
          <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 16px;">
            Schedule recurring cron jobs, hook into Webhook payloads, or stream Kafka events directly into AI employee fleets.
          </p>

          <div style="border: 1px solid var(--border-light); border-radius: 8px; padding: 10px 14px; background: var(--bg-blue-tint); font-family: var(--font-mono); font-size: 11px; color: var(--text-primary);">
            <div>⏰ CRON: 0 4 * * 1-5 (Daily 04:00)</div>
            <div style="color: var(--text-muted); margin-top: 2px;">Trigger: Invoice Reconciliation</div>
          </div>
        </div>

        <div style="margin-top: 20px;">
          <a href="/platform#automate" style="font-size: 13px; font-weight: 600; color: var(--text-primary);">
            Explore Automation →
          </a>
        </div>
      </div>

      {/* 5. Integrations & Model Context Protocol (Span 4) */}
      <div class="os-card os-col-4 bento-gradient-card" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid transparent; background: rgba(30, 120, 255, 0.05);">
        <div>
          <span class="os-badge" style="background: rgba(124, 58, 237, 0.12); color: #7c3aed; border: 1px solid rgba(124, 58, 237, 0.25); margin-bottom: 12px;">
            Open Protocol
          </span>
          <h3 style="font-size: 20px; font-weight: 700; color: var(--text-primary); margin-bottom: 6px;">MCP Integrations</h3>
          <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 16px;">
            Built natively on Model Context Protocol. Connect to Slack, Salesforce, HubSpot, Stripe, GitHub, Postgres, and private APIs.
          </p>

          <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: var(--bg-blue-tint); border: 1px solid var(--border-light); font-weight: 600;">Salesforce</span>
            <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: var(--bg-blue-tint); border: 1px solid var(--border-light); font-weight: 600;">HubSpot</span>
            <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: var(--bg-blue-tint); border: 1px solid var(--border-light); font-weight: 600;">Stripe</span>
            <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: var(--bg-blue-tint); border: 1px solid var(--border-light); font-weight: 600;">PostgreSQL</span>
            <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: var(--bg-blue-tint); border: 1px solid var(--border-light); font-weight: 600;">Slack</span>
            <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: var(--bg-blue-tint); border: 1px solid var(--border-light); font-weight: 600;">GitHub</span>
          </div>
        </div>

        <div style="margin-top: 20px;">
          <a href="/platform#integrations" style="font-size: 13px; font-weight: 600; color: var(--text-primary);">
            View 100+ MCP Servers →
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .bento-gradient-card {
    position: relative;
  }
  .bento-gradient-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border-radius: 24px; /* os-card default radius */
    padding: 2px;
    background: linear-gradient(135deg, var(--blue-primary), rgba(118, 168, 255, 0.8));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .os-bento-grid {
      display: flex;
      flex-direction: row;
      gap: 12px;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 4px 2px 12px;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-gutter: stable;
    }

    .os-bento-grid::-webkit-scrollbar {
      height: 8px;
    }

    .os-bento-grid::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.06);
      border-radius: 999px;
    }

    .os-bento-grid::-webkit-scrollbar-thumb {
      background: rgba(37, 99, 235, 0.6);
      border-radius: 999px;
    }

    .os-bento-grid .os-card {
      flex: 0 0 82vw;
      min-width: 280px;
      max-width: 82vw;
      min-height: 0 !important;
      border-radius: 18px !important;
      padding: 16px !important;
      scroll-snap-align: start;
    }

    .os-bento-grid .os-card > div:first-child {
      gap: 12px;
    }

    .os-bento-grid .os-card h3 {
      font-size: 1.25rem !important;
      line-height: 1.2 !important;
    }

    .os-bento-grid .os-card p {
      font-size: 0.85rem !important;
      line-height: 1.5 !important;
    }

    .os-bento-grid .os-card > div:first-child > div:first-child {
      display: flex !important;
      flex-direction: column !important;
      gap: 10px !important;
    }

    .os-bento-grid .os-card > div:first-child > div:last-child {
      text-align: left !important;
      margin-top: 4px;
    }

    .os-bento-grid .os-card > div:first-child > div:last-child > div:first-child {
      font-size: 1.6rem !important;
    }

    .os-bento-grid .os-card > div:first-child > div:last-child > div:last-child {
      font-size: 0.7rem !important;
      letter-spacing: 0.08em !important;
    }

    .os-bento-grid .os-card > div:first-child > div[style*="display: grid; grid-template-columns: repeat(3, 1fr)"] {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 10px !important;
    }

    .os-bento-grid .os-card > div:first-child > div[style*="display: grid; grid-template-columns: repeat(3, 1fr)"] > div {
      min-width: 0;
      padding: 10px !important;
    }

    .os-bento-grid .os-card > div:first-child > div[style*="display: grid; grid-template-columns: repeat(3, 1fr)"] > div > div:first-child {
      font-size: 0.68rem !important;
    }

    .os-bento-grid .os-card > div:first-child > div[style*="display: grid; grid-template-columns: repeat(3, 1fr)"] > div > div:nth-child(2) {
      font-size: 1rem !important;
      line-height: 1.2 !important;
    }

    .os-bento-grid .os-card > div:last-child {
      margin-top: 12px !important;
      gap: 8px !important;
      align-items: flex-start !important;
      flex-direction: column !important;
    }

    .os-bento-grid .os-card > div:last-child > span,
    .os-bento-grid .os-card > div:last-child > a {
      font-size: 0.75rem !important;
      line-height: 1.35 !important;
    }
  }

  @media (max-width: 560px) {
    .os-bento-grid .os-card {
      flex-basis: 86vw;
      max-width: 86vw;
      padding: 14px !important;
    }

    .os-bento-grid .os-card > div:first-child > div[style*="display: grid; grid-template-columns: repeat(3, 1fr)"] {
      grid-template-columns: 1fr !important;
    }

    .os-bento-grid .os-card > div:first-child > div:first-child {
      gap: 8px !important;
    }

    .os-bento-grid .os-card > div:last-child {
      margin-top: 10px !important;
    }
  }
</style>
