---
---

<section id="platform" class="os-section" style="padding: 48px 0; background: var(--warm-cream);">
  <div class="os-container">
    
    <div class="os-section-header">
      <div class="os-eyebrow">
        <span class="os-live-dot"></span> AI WORKFORCE PLATFORM
      </div>
      <h2 class="os-h2">
        A complete operating system for autonomous enterprise work.
      </h2>
      <p class="os-lead">
        Beyond prompt engineering. Orchestrate, observe, evaluate, automate, and integrate your AI employee fleet from a single mission control.
      </p>
    </div>

    {/* Bento Grid */}
    <div class="os-bento-grid">
      
      {/* 1. Large Hero Bento: AI Workforce Dashboard (Span 8) */}
      <div class="os-card os-col-8 os-card-cream" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--border-medium); min-height: 380px;">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div>
              <span class="os-badge os-badge-pink" style="margin-bottom: 8px;">Core Platform</span>
              <h3 style="font-size: 22px; font-weight: 700; color: var(--ink-black); margin-bottom: 6px;">AI Workforce Hub</h3>
              <p style="font-size: 14px; color: var(--ink-secondary); max-width: 500px;">
                Centrally assign business goals, manage team permissions, coordinate multi-agent handoffs, and monitor organizational productivity.
              </p>
            </div>
            <div style="text-align: right;">
              <div style="font-size: 24px; font-weight: 800; color: var(--ink-black);">10,000+</div>
              <div style="font-size: 11px; color: var(--ink-muted); text-transform: uppercase;">Agent Capacity</div>
            </div>
          </div>

          {/* Interactive UI Mockup */}
          <div style="background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 18px; box-shadow: var(--shadow-sm); display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;">
            <div style="padding: 12px; border-radius: 8px; background: var(--bg-cream-alt); border: 1px solid var(--border-light);">
              <div style="font-size: 11px; color: var(--ink-muted); margin-bottom: 2px;">Active Squads</div>
              <div style="font-size: 18px; font-weight: 700; color: var(--ink-black);">12 Fleets</div>
              <div style="font-size: 11px; color: var(--status-green);">● 100% Online</div>
            </div>
            <div style="padding: 12px; border-radius: 8px; background: var(--bg-cream-alt); border: 1px solid var(--border-light);">
              <div style="font-size: 11px; color: var(--ink-muted); margin-bottom: 2px;">Today's Tasks</div>
              <div style="font-size: 18px; font-weight: 700; color: var(--ink-black);">1,429 Done</div>
              <div style="font-size: 11px; color: var(--ink-muted);">Avg 38s / task</div>
            </div>
            <div style="padding: 12px; border-radius: 8px; background: var(--bg-cream-alt); border: 1px solid var(--border-light);">
              <div style="font-size: 11px; color: var(--ink-muted); margin-bottom: 2px;">Accuracy SLA</div>
              <div style="font-size: 18px; font-weight: 700; color: var(--ink-black);">99.2%</div>
              <div style="font-size: 11px; color: var(--status-green);">Deterministic</div>
            </div>
          </div>
        </div>

        <div style="margin-top: 20px; display: flex; justify-content: space-between; align-items: center;">
          <span style="font-size: 13px; color: var(--ink-muted);">Role-Based Access Control (RBAC) & Team Workspaces</span>
          <a href="/platform#workforce" style="font-size: 13px; font-weight: 600; color: var(--ink-black);">Explore Hub →</a>
        </div>
      </div>

      {/* 2. Observe: Real-Time Tracing (Span 4) */}
      <div class="os-card os-col-4 os-card-dark" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid #262626;">
        <div>
          <span class="os-badge" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); margin-bottom: 12px;">
            Deep Tracing
          </span>
          <h3 style="font-size: 20px; font-weight: 700; color: #ffffff; margin-bottom: 6px;">Observe</h3>
          <p style="font-size: 13px; color: #94a3b8; margin-bottom: 16px;">
            Inspect LLM reasoning chains, tool latency, token consumption, and decisions with millisecond precision.
          </p>

          <div style="background: #141a29; border: 1px solid #1e293b; border-radius: 8px; padding: 12px; font-family: var(--font-mono); font-size: 11px; color: #cbd5e1; display: flex; flex-direction: column; gap: 6px;">
            <div style="color: #4ade80;">✓ trace_id: tr_992a (342ms)</div>
            <div style="color: #38bdf8;">→ tool: mcp_sql_query (12 rows)</div>
            <div style="color: #facc15;">● tokens: 1,420 ($0.002)</div>
          </div>
        </div>

        <div style="margin-top: 20px;">
          <a href="/platform#observe" style="font-size: 13px; font-weight: 600; color: var(--candy-pink); text-decoration: none;">
            Explore Observability →
          </a>
        </div>
      </div>

      {/* 3. Evaluate: Test Bench (Span 4) */}
      <div class="os-card os-col-4" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--border-medium); background: #ffffff;">
        <div>
          <span class="os-badge os-badge-green" style="margin-bottom: 12px;">Quality Assurance</span>
          <h3 style="font-size: 20px; font-weight: 700; color: var(--ink-black); margin-bottom: 6px;">Evaluate</h3>
          <p style="font-size: 13px; color: var(--ink-secondary); margin-bottom: 16px;">
            Run golden test datasets with 250+ assertions. Benchmark accuracy and cost before deploying updates to production.
          </p>

          <div style="border: 1px solid var(--border-light); border-radius: 8px; padding: 12px; background: var(--bg-cream-alt);">
            <div style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; margin-bottom: 6px;">
              <span>Golden Suite (48/48 passed)</span>
              <span style="color: var(--status-green);">100%</span>
            </div>
            <div style="height: 6px; width: 100%; background: #e2e8f0; border-radius: 999px; overflow: hidden;">
              <div style="height: 100%; width: 100%; background: var(--status-green);"></div>
            </div>
          </div>
        </div>

        <div style="margin-top: 20px;">
          <a href="/platform#evaluate" style="font-size: 13px; font-weight: 600; color: var(--ink-black);">
            Explore Evaluation →
          </a>
        </div>
      </div>

      {/* 4. Automate: Trigger Engine (Span 4) */}
      <div class="os-card os-col-4" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--border-medium); background: #ffffff;">
        <div>
          <span class="os-badge os-badge-pink" style="margin-bottom: 12px;">Continuous Ops</span>
          <h3 style="font-size: 20px; font-weight: 700; color: var(--ink-black); margin-bottom: 6px;">Automate</h3>
          <p style="font-size: 13px; color: var(--ink-secondary); margin-bottom: 16px;">
            Schedule recurring cron jobs, hook into Webhook payloads, or stream Kafka events directly into AI employee fleets.
          </p>

          <div style="border: 1px solid var(--border-light); border-radius: 8px; padding: 10px 14px; background: var(--bg-cream-alt); font-family: var(--font-mono); font-size: 11px; color: var(--ink-primary);">
            <div>⏰ CRON: 0 4 * * 1-5 (Daily 04:00)</div>
            <div style="color: var(--ink-muted); margin-top: 2px;">Trigger: Invoice Reconciliation</div>
          </div>
        </div>

        <div style="margin-top: 20px;">
          <a href="/platform#automate" style="font-size: 13px; font-weight: 600; color: var(--ink-black);">
            Explore Automation →
          </a>
        </div>
      </div>

      {/* 5. Integrations & Model Context Protocol (Span 4) */}
      <div class="os-card os-col-4" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--border-medium); background: #ffffff;">
        <div>
          <span class="os-badge" style="background: rgba(124, 58, 237, 0.12); color: #7c3aed; border: 1px solid rgba(124, 58, 237, 0.25); margin-bottom: 12px;">
            Open Protocol
          </span>
          <h3 style="font-size: 20px; font-weight: 700; color: var(--ink-black); margin-bottom: 6px;">MCP Integrations</h3>
          <p style="font-size: 13px; color: var(--ink-secondary); margin-bottom: 16px;">
            Built natively on Model Context Protocol. Connect to Slack, Salesforce, HubSpot, Stripe, GitHub, Postgres, and private APIs.
          </p>

          <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: var(--bg-cream-alt); border: 1px solid var(--border-light); font-weight: 600;">Salesforce</span>
            <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: var(--bg-cream-alt); border: 1px solid var(--border-light); font-weight: 600;">HubSpot</span>
            <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: var(--bg-cream-alt); border: 1px solid var(--border-light); font-weight: 600;">Stripe</span>
            <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: var(--bg-cream-alt); border: 1px solid var(--border-light); font-weight: 600;">PostgreSQL</span>
            <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: var(--bg-cream-alt); border: 1px solid var(--border-light); font-weight: 600;">Slack</span>
            <span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: var(--bg-cream-alt); border: 1px solid var(--border-light); font-weight: 600;">GitHub</span>
          </div>
        </div>

        <div style="margin-top: 20px;">
          <a href="/platform#integrations" style="font-size: 13px; font-weight: 600; color: var(--ink-black);">
            View 100+ MCP Servers →
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
