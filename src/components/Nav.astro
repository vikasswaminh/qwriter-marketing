---
import Logo from "~/components/Logo.astro";
import { AI_EMPLOYEES } from "~/data/employees";
import { PLATFORM_MODULES } from "~/data/platform";
import { SOLUTIONS } from "~/data/solutions";

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<header class="os-nav-blur" style="position: sticky; top: 0; z-index: 999; height: 72px; width: 100%;">
  <div class="os-container-wide" style="display: flex; align-items: center; justify-content: space-between; height: 100%;">
    {/* Brand Logo */}
    <div style="display: flex; align-items: center; gap: 36px;">
      <a href="/" aria-label="OllaSuper Home" style="display: inline-flex; align-items: center; text-decoration: none;">
        <Logo size={28} wordmark={true} />
      </a>

      {/* Desktop Mega-Navigation */}
      <nav aria-label="Main Navigation" class="os-nav-desktop" style="display: flex; align-items: center; gap: 6px;">
        
        {/* Platform Dropdown */}
        <div class="os-dropdown-parent" style="position: relative;">
          <button class={`os-nav-link ${current === 'platform' ? 'active' : ''}`} aria-haspopup="true" aria-expanded="false" style="display: flex; align-items: center; gap: 4px; background: none; border: none; padding: 8px 12px; font-size: 14px; font-weight: 500; color: var(--ink-secondary); cursor: pointer; border-radius: var(--radius-pill); transition: all 0.15s ease;">
            Platform
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="transition: transform 0.2s ease;">
              <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="os-dropdown-menu" style="width: 580px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
            {PLATFORM_MODULES.map((mod) => (
              <a href={`/platform#${mod.slug}`} class="os-dropdown-item" style="display: flex; gap: 12px; padding: 12px; border-radius: var(--radius-md); text-decoration: none; transition: background 0.15s ease;">
                <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--bg-cream-alt); border: 1px solid var(--border-light); display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0;">
                  {mod.slug === 'workforce' && '⚡'}
                  {mod.slug === 'observe' && '👁️'}
                  {mod.slug === 'evaluate' && '🎯'}
                  {mod.slug === 'automate' && '⚙️'}
                  {mod.slug === 'integrations' && '🔌'}
                </div>
                <div>
                  <div style="font-size: 14px; font-weight: 600; color: var(--ink-black); margin-bottom: 2px;">{mod.title}</div>
                  <div style="font-size: 12px; color: var(--ink-muted); line-height: 1.4;">{mod.tagline}</div>
                </div>
              </a>
            ))}
            <div style="grid-column: span 2; padding-top: 8px; border-top: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 12px; color: var(--ink-muted);">Built on Model Context Protocol (MCP)</span>
              <a href="/platform" style="font-size: 12px; font-weight: 600; color: var(--ink-black);">Explore full architecture →</a>
            </div>
          </div>
        </div>

        {/* AI Employees Dropdown */}
        <div class="os-dropdown-parent" style="position: relative;">
          <button class={`os-nav-link ${current === 'ai-employees' ? 'active' : ''}`} aria-haspopup="true" aria-expanded="false" style="display: flex; align-items: center; gap: 4px; background: none; border: none; padding: 8px 12px; font-size: 14px; font-weight: 500; color: var(--ink-secondary); cursor: pointer; border-radius: var(--radius-pill); transition: all 0.15s ease;">
            AI Employees
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="os-dropdown-menu" style="width: 620px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
            {AI_EMPLOYEES.map((emp) => (
              <a href={`/ai-employees/${emp.slug}`} class="os-dropdown-item" style="display: flex; gap: 12px; padding: 12px; border-radius: var(--radius-md); text-decoration: none; transition: background 0.15s ease;">
                <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--bg-cream-alt); border: 1px solid var(--border-light); display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0;">
                  {emp.avatarIcon}
                </div>
                <div>
                  <div style="font-size: 14px; font-weight: 600; color: var(--ink-black); margin-bottom: 2px; display: flex; align-items: center; gap: 6px;">
                    {emp.name}
                    {emp.badge && <span class="os-badge os-badge-pink" style="font-size: 10px; padding: 2px 6px;">{emp.badge}</span>}
                  </div>
                  <div style="font-size: 12px; color: var(--ink-muted); line-height: 1.4;">{emp.oneliner}</div>
                </div>
              </a>
            ))}
            <div style="grid-column: span 2; padding-top: 8px; border-top: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 12px; color: var(--ink-muted);">Ready to deploy in under 60 seconds</span>
              <a href="/ai-employees" style="font-size: 12px; font-weight: 600; color: var(--ink-black);">View all AI employees →</a>
            </div>
          </div>
        </div>

        {/* Solutions Dropdown */}
        <div class="os-dropdown-parent" style="position: relative;">
          <button class={`os-nav-link ${current === 'solutions' ? 'active' : ''}`} aria-haspopup="true" aria-expanded="false" style="display: flex; align-items: center; gap: 4px; background: none; border: none; padding: 8px 12px; font-size: 14px; font-weight: 500; color: var(--ink-secondary); cursor: pointer; border-radius: var(--radius-pill); transition: all 0.15s ease;">
            Solutions
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="os-dropdown-menu" style="width: 520px; display: grid; grid-template-columns: 1fr; gap: 8px;">
            {SOLUTIONS.map((sol) => (
              <a href={`/solutions#${sol.slug}`} class="os-dropdown-item" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; border-radius: var(--radius-md); text-decoration: none; transition: background 0.15s ease;">
                <div>
                  <div style="font-size: 14px; font-weight: 600; color: var(--ink-black);">{sol.title}</div>
                  <div style="font-size: 12px; color: var(--ink-muted);">{sol.tagline}</div>
                </div>
                <span class="os-badge os-badge-green" style="font-size: 11px;">{sol.badge}</span>
              </a>
            ))}
          </div>
        </div>

        {/* Resources Link */}
        <a href="/resources" class={`os-nav-link ${current === 'resources' ? 'active' : ''}`} style="padding: 8px 12px; font-size: 14px; font-weight: 500; color: var(--ink-secondary); text-decoration: none; border-radius: var(--radius-pill); transition: all 0.15s ease;">
          Resources
        </a>

        {/* Blog Link in Header */}
        <a href="/blog" class={`os-nav-link ${current === 'blog' ? 'active' : ''}`} style="padding: 8px 12px; font-size: 14px; font-weight: 500; color: var(--ink-secondary); text-decoration: none; border-radius: var(--radius-pill); transition: all 0.15s ease;">
          Blog
        </a>

        {/* Pricing Link */}
        <a href="/pricing" class={`os-nav-link ${current === 'pricing' ? 'active' : ''}`} style="padding: 8px 12px; font-size: 14px; font-weight: 500; color: var(--ink-secondary); text-decoration: none; border-radius: var(--radius-pill); transition: all 0.15s ease;">
          Pricing
        </a>
      </nav>
    </div>

    {/* Right Action Cluster */}
    <div style="display: flex; align-items: center; gap: 12px;">
      <a href="https://app.ollasuper.com/auth" class="os-nav-desktop-only" style="font-size: 14px; font-weight: 500; color: var(--ink-secondary); padding: 8px 10px; text-decoration: none; transition: color 0.15s ease;">
        Sign In
      </a>
      <a href="/demo" class="os-btn os-btn-secondary os-nav-desktop-only" style="padding: 9px 16px; font-size: 13px;">
        Book Demo
      </a>
      <a href="/signup" class="os-btn os-btn-primary" style="padding: 9px 18px; font-size: 13px;">
        Deploy Workforce →
      </a>
      
      {/* Mobile Menu Toggle Button */}
      <button id="os-mobile-menu-btn" class="os-mobile-toggle" aria-label="Toggle navigation menu" style="display: none; background: none; border: 1px solid var(--border-medium); border-radius: 8px; padding: 8px; cursor: pointer;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile Menu Drawer */}
  <div id="os-mobile-drawer" style="display: none; position: fixed; top: 72px; left: 0; width: 100%; height: calc(100vh - 72px); background: var(--warm-cream); border-top: 1px solid var(--border-light); padding: 24px; overflow-y: auto; z-index: 998;">
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <a href="/platform" style="font-size: 18px; font-weight: 700; color: var(--ink-black);">Platform</a>
      <div style="padding-left: 12px; display: flex; flex-direction: column; gap: 8px;">
        <a href="/platform#workforce" style="font-size: 14px; color: var(--ink-secondary);">AI Workforce Hub</a>
        <a href="/platform#observe" style="font-size: 14px; color: var(--ink-secondary);">Observability & Tracing</a>
        <a href="/platform#evaluate" style="font-size: 14px; color: var(--ink-secondary);">Deterministic Evaluation</a>
        <a href="/platform#automate" style="font-size: 14px; color: var(--ink-secondary);">Event Automation</a>
        <a href="/platform#integrations" style="font-size: 14px; color: var(--ink-secondary);">Model Context Protocol</a>
      </div>
      
      <a href="/ai-employees" style="font-size: 18px; font-weight: 700; color: var(--ink-black); margin-top: 8px;">AI Employees</a>
      <div style="padding-left: 12px; display: flex; flex-direction: column; gap: 8px;">
        <a href="/ai-employees/research" style="font-size: 14px; color: var(--ink-secondary);">🔍 Research Employee</a>
        <a href="/ai-employees/sales" style="font-size: 14px; color: var(--ink-secondary);">⚡ Sales Employee</a>
        <a href="/ai-employees/marketing" style="font-size: 14px; color: var(--ink-secondary);">🎯 Marketing Employee</a>
        <a href="/ai-employees/customer-support" style="font-size: 14px; color: var(--ink-secondary);">🛡️ Support Employee</a>
        <a href="/ai-employees/operations" style="font-size: 14px; color: var(--ink-secondary);">⚙️ Operations Employee</a>
      </div>

      <a href="/solutions" style="font-size: 18px; font-weight: 700; color: var(--ink-black); margin-top: 8px;">Solutions</a>
      <a href="/resources" style="font-size: 18px; font-weight: 700; color: var(--ink-black);">Resources</a>
      <a href="/blog" style="font-size: 18px; font-weight: 700; color: var(--ink-black);">Blog</a>
      <a href="/pricing" style="font-size: 18px; font-weight: 700; color: var(--ink-black);">Pricing</a>

      <div style="margin-top: 24px; display: flex; flex-direction: column; gap: 12px;">
        <a href="/demo" class="os-btn os-btn-secondary" style="width: 100%;">Book a Demo</a>
        <a href="/signup" class="os-btn os-btn-primary" style="width: 100%;">Build Your AI Workforce →</a>
      </div>
    </div>
  </div>
</header>

<style>
  .os-nav-link:hover, .os-nav-link.active {
    color: var(--ink-black) !important;
    background-color: rgba(0, 0, 0, 0.05);
  }
  .os-dropdown-item:hover {
    background-color: var(--candy-pink-soft);
  }
  @media (max-width: 900px) {
    .os-nav-desktop, .os-nav-desktop-only {
      display: none !important;
    }
    .os-mobile-toggle {
      display: inline-flex !important;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('os-mobile-menu-btn');
  const drawer = document.getElementById('os-mobile-drawer');
  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = drawer.style.display === 'none';
      drawer.style.display = isHidden ? 'block' : 'none';
      toggleBtn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
    });
  }
</script>
