---
// Cycling chat preview — shows 5 real expert exchanges from src/data/experts.ts.
// Each "scene" runs for ~6.5s before fading to the next. Total cycle ~32.5s.
// All prompts + responses are the actual sample.user / sample.assistant from
// our 30 experts — nothing faked.
//
// Animation: pure CSS @keyframes. Five scenes stacked absolutely; each gets
// its own keyframe that holds opacity 1 only inside its time window.
// Respects prefers-reduced-motion.

import { experts } from "~/data/experts";
import { marked } from "marked";

marked.setOptions({ gfm: true, breaks: false });

// Which 5 specialists to cycle through. Chosen for visual variety — table,
// audit list, JD copy, deal screen, postmortem. Real capability per scene.
const SCENE_SLUGS = ["sdr", "seo", "hr", "ma", "devops"] as const;

const scenes = SCENE_SLUGS.map(slug => {
  const e = experts.find(x => x.slug === slug)!;
  // Trim the user prompt so the chat surface stays balanced
  const user = e.sample.user.length > 140
    ? e.sample.user.slice(0, 140).replace(/\s+\S*$/, "") + "…"
    : e.sample.user;
  // Take the first ~10 meaningful lines of the response so the preview
  // shows real depth without overflowing the card.
  const lines = e.sample.assistant.split("\n");
  const cutoff = Math.min(lines.length, 11);
  const previewMd = lines.slice(0, cutoff).join("\n");
  return {
    slug: e.slug,
    name: e.name,
    short: e.short,
    color: e.color,
    user,
    assistantHtml: marked.parse(previewMd) as string,
  };
});

const SCENE_DURATION = 6.5; // seconds visible per scene (incl. fades)
const TOTAL = scenes.length * SCENE_DURATION;
const FADE = 0.4; // seconds for fade-in / fade-out

// Per-scene timing in percentage of the full loop
const timings = scenes.map((_, i) => {
  const start = (i * SCENE_DURATION) / TOTAL * 100;
  const end   = ((i + 1) * SCENE_DURATION) / TOTAL * 100;
  const fadeIn  = (FADE / TOTAL) * 100;
  return {
    pre:     start.toFixed(3),
    inDone:  (start + fadeIn).toFixed(3),
    outStart:(end - fadeIn).toFixed(3),
    end:     end.toFixed(3),
  };
});

// Generate the dynamic per-scene keyframe CSS in frontmatter — avoids the
// nested-template-literal parse issue inside `<style set:html={...}>`.
const sceneCss = scenes.map((_, i) => {
  const t = timings[i];
  return [
    `@keyframes scene-fade-${i} {`,
    `  0%, ${t.pre}% { opacity: 0; transform: translateY(8px); }`,
    `  ${t.inDone}% { opacity: 1; transform: translateY(0); }`,
    `  ${t.outStart}% { opacity: 1; transform: translateY(0); }`,
    `  ${t.end}%, 100% { opacity: 0; transform: translateY(-8px); }`,
    `}`,
    `.qw-chat-scene.scene-${i} { animation: scene-fade-${i} ${TOTAL}s linear infinite; }`,
    `@keyframes dot-active-${i} {`,
    `  0%, ${t.pre}% { background: var(--rule-2); }`,
    `  ${t.inDone}% { background: var(--accent); }`,
    `  ${t.outStart}% { background: var(--accent); }`,
    `  ${t.end}%, 100% { background: var(--rule-2); }`,
    `}`,
    `.qw-chat-dot.dot-${i} { animation: dot-active-${i} ${TOTAL}s linear infinite; }`,
  ].join("\n");
}).join("\n\n") + `

.qw-chat-scene.scene-0 { position: absolute !important; inset: 0; }

.qw-card-premium:hover .qw-chat-scene,
.qw-card-premium:hover .qw-chat-dot {
  animation-play-state: paused;
}

@media (prefers-reduced-motion: reduce) {
  .qw-chat-scene, .qw-chat-dot { animation: none !important; }
  .qw-chat-scene.scene-0 { opacity: 1 !important; position: relative !important; }
  .qw-chat-scene:not(.scene-0) { display: none !important; }
  .qw-chat-dot.dot-0 { background: var(--accent) !important; }
}
`;
---
<div style="position: relative; width: 100%; max-width: 540px;">

  {/* ━━━ Soft multi-color halo behind the card ━━━ */}
  <div style="
    position: absolute; inset: -50px;
    background:
      radial-gradient(50% 50% at 70% 25%, rgba(0,102,255,0.14), transparent 70%),
      radial-gradient(40% 40% at 30% 75%, rgba(124,58,237,0.10), transparent 70%);
    pointer-events: none;
    filter: blur(34px);
  "></div>

  {/* ━━━ Chat surface (premium card) ━━━ */}
  <div class="qw-card-premium" style="position: relative; overflow: hidden; min-height: 480px; padding: 0;">

    {/* ━━━ Stage — scenes stack here ━━━ */}
    <div style="position: relative; min-height: 480px;">
      {scenes.map((s, i) => (
        <div
          class={`qw-chat-scene scene-${i}`}
          style={`position: ${i === 0 ? 'relative' : 'absolute'}; inset: 0; opacity: ${i === 0 ? 1 : 0};`}
        >
          {/* Title bar */}
          <div style="display: flex; align-items: center; gap: 10px; padding: 11px 16px; border-bottom: 1px solid var(--rule-soft); background: var(--paper-warm);">
            <span style={`width: 8px; height: 8px; border-radius: 999px; background: ${s.color};`}></span>
            <span style="font-weight: 700; font-size: 13px; letter-spacing: -0.01em; color: var(--ink);">{s.name}</span>
            <span style="margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-size: 10.5px; color: var(--ink-3);">
              <span style="display: inline-block; width: 6px; height: 6px; border-radius: 999px; background: var(--sage);"></span>
              {i + 1} / {scenes.length}
            </span>
          </div>

          {/* User bubble */}
          <div style="display: flex; gap: 10px; padding: 16px 18px 8px;">
            <div style="flex: 0 0 26px; height: 26px; border-radius: 999px; background: var(--ink); color: var(--paper); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 10px;">You</div>
            <div style="flex: 1; min-width: 0; font-size: 12.5px; line-height: 1.55; color: var(--ink-2); padding-top: 5px;">{s.user}</div>
          </div>

          {/* Assistant bubble */}
          <div style="display: flex; gap: 10px; padding: 8px 18px 16px;">
            <div style={`flex: 0 0 26px; height: 26px; border-radius: 999px; background: ${s.color}; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 9.5px;`}>{s.short.slice(0,2)}</div>
            <div class="qw-chat-body qw-chat-mini" style="flex: 1; min-width: 0; padding-top: 4px;" set:html={s.assistantHtml} />
          </div>

          {/* Streaming indicator inside the scene */}
          <div style="display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px; background: var(--bg-elev); border-radius: 999px; font-size: 10.5px; color: var(--ink-3); margin: 0 18px 14px 54px;">
            <span class="qw-typing"><span></span><span></span><span></span></span>
            <span>generating</span>
          </div>
        </div>
      ))}
    </div>

    {/* ━━━ Footer attribution (no model name) ━━━ */}
    <div style="display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-top: 1px solid var(--rule-soft); background: var(--paper-warm); font-size: 10.5px; color: var(--ink-3);">
      <span style="color: var(--accent);">✦</span>
      <span>grounded · memory on · multi-agent</span>
      <span style="margin-left: auto; display: inline-flex; gap: 4px;">
        {scenes.map((s, i) => (
          <span class={`qw-chat-dot dot-${i}`} style={`width: 16px; height: 4px; border-radius: 2px; background: var(--rule-2); transition: background 240ms ease;`}></span>
        ))}
      </span>
    </div>

  </div>
</div>

<style>
  /* Hide overflow so the streaming indicator never extends outside */
  .qw-chat-scene { overflow: hidden; }

  /* Compact markdown body — smaller type for the cycling preview */
  .qw-chat-mini {
    font-size: 12px !important;
    line-height: 1.5 !important;
    max-height: 280px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 88%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 88%, transparent 100%);
  }
  .qw-chat-mini :where(p, ul, ol, h2, h3, h4, blockquote, pre, table) { margin: 0 0 8px !important; }
  .qw-chat-mini h2, .qw-chat-mini h3, .qw-chat-mini h4 { font-size: 12.5px !important; margin: 10px 0 6px !important; }
  .qw-chat-mini table { font-size: 11px !important; }
  .qw-chat-mini th, .qw-chat-mini td { padding: 5px 8px !important; }
  .qw-chat-mini ul, .qw-chat-mini ol { padding-left: 18px !important; }
  .qw-chat-mini li { margin-bottom: 2px !important; font-size: 12px !important; }
  .qw-chat-mini strong { font-weight: 700; }
</style>

{/* ━━━ Generated per-scene keyframes (built in frontmatter) ━━━ */}
<style is:global set:html={sceneCss} />
