</section>

<style>
  @media (max-width: 960px) {
    section > div > div > div[style*="grid-template-columns: 1fr 1fr 1fr"] {
      grid-template-columns: 1fr 1fr !important;
    }
    .os-container[style*="justify-content: space-between"] {
      flex-direction: column;
      align-items: flex-start !important;
    }
    .os-container[style*="justify-content: space-between"] > div:last-child {
      align-items: flex-start !important;
    }
  }

  /* Premium Trust Item Hover Physics */
  .os-trust-item {
    position: relative;
    display: flex;
    gap: 16px;
    padding: 16px;
    border-radius: 16px;
    margin: -16px; /* Offset padding to keep layout stable */
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: default;
  }
  .os-trust-item::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border-radius: 16px;
    padding: 2px;
    background: linear-gradient(135deg, #ff8da1, #66a3ff);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
    opacity: 0.8;
  }
  .os-trust-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-blue-tint);
    color: var(--blue-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }
  .os-trust-item h4 {
    color: var(--text-primary) !important;
  }
  .os-trust-item p {
    color: var(--text-secondary) !important;
  }
  .os-trust-item:hover {
    background: rgba(255, 131, 218, 0.05);
    transform: translateY(-4px);
  }
  .os-trust-item:hover .os-trust-icon {
    transform: scale(1.15) rotate(5deg);
    background: var(--blue-primary);
    color: #ffffff;
    box-shadow: 0 8px 16px rgba(255, 131, 218, 0.4);
  }
  .os-marquee-track {
    animation: scroll-left 25s linear infinite;
  }
  .os-trust-marquee:hover .os-marquee-track {
    animation-play-state: paused;
  }
  @keyframes scroll-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-50% - 24px)); }
  }
</style>
