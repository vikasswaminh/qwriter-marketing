---
// TrustFooter.astro
import RibbonBackground from "~/components/shared/RibbonBackground.astro";
---


  {/* Massive Pink Footer Banner */}
  <div style="background: linear-gradient(135deg, var(--blue-primary), #a81c85); color: #ffffff; padding: 32px 0;">
    <div class="os-container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 48px;">
      
      <div>
        <div style="font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 12px; opacity: 0.9;">
          GET STARTED TODAY
        </div>
        <h2 style="font-size: 2.5rem; font-weight: 800; color: #ffffff; margin-bottom: 24px; max-width: 500px; line-height: 1.1; letter-spacing: -0.02em;">
          Build your AI workforce in minutes, not months.
        </h2>
        
        <div style="display: flex; gap: 24px; align-items: center; font-size: 0.85rem; font-weight: 600; opacity: 0.9;">
          <div style="display: flex; align-items: center; gap: 6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"></path></svg>
            No credit card
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"></path></svg>
            14-day free trial
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"></path></svg>
            Cancel anytime
          </div>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 24px;">
        <div style="display: flex; gap: 16px;">
          <a href="https://app.ollasuper.com/login" style="background: #ffffff; color: var(--blue-primary); padding: 16px 28px; border-radius: var(--radius-pill); font-weight: 700; text-decoration: none; font-size: 1rem; transition: transform 0.2s ease;">
            Start Free Trial →
          </a>
          <a href="/demo" style="background: rgba(255,255,255,0.15); color: #ffffff; border: 1px solid rgba(255,255,255,0.3); padding: 16px 28px; border-radius: var(--radius-pill); font-weight: 700; text-decoration: none; font-size: 1rem; transition: background 0.2s ease;">
            Schedule Demo
          </a>
        </div>
        
        <div style="display: flex; align-items: center; gap: 12px;">
          {/* Avatar Stack */}
          <div style="display: flex; margin-right: 8px;">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #ddd; border: 2px solid #a81c85; margin-left: -10px; position: relative; z-index: 4; background-image: url('https://i.pravatar.cc/100?img=1'); background-size: cover;"></div>
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #ddd; border: 2px solid #a81c85; margin-left: -10px; position: relative; z-index: 3; background-image: url('https://i.pravatar.cc/100?img=2'); background-size: cover;"></div>
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #ddd; border: 2px solid #a81c85; margin-left: -10px; position: relative; z-index: 2; background-image: url('https://i.pravatar.cc/100?img=3'); background-size: cover;"></div>
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #ddd; border: 2px solid #a81c85; margin-left: -10px; position: relative; z-index: 1; background-image: url('https://i.pravatar.cc/100?img=4'); background-size: cover;"></div>
          </div>
          <div style="font-size: 0.85rem; font-weight: 500; opacity: 0.9;">
            Trusted by 10,000+ businesses worldwide
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @media (max-width: 960px) {
    section > div > div[style*="grid-template-columns: 2fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
    section > div > div > div[style*="grid-template-columns: 1fr 1fr 1fr"] {
      grid-template-columns: 1fr 1fr !important;
    }
    .os-container[style*="justify-content: space-between"] {
      flex-direction: column;
      align-items: flex-start !important;
    }
    .os-container[style*="justify-content: space-between"] > div:last-child {
      align-items: flex-start !important;
    }
  }

  @media (max-width: 640px) {
    .os-container[style*="justify-content: space-between"] {
      gap: 24px !important;
      padding-left: 16px !important;
      padding-right: 16px !important;
    }

    .os-container[style*="justify-content: space-between"] > div:first-child {
      width: 100%;
    }

    .os-container[style*="justify-content: space-between"] > div:first-child h2 {
      font-size: clamp(2rem, 9vw, 3rem) !important;
      margin-bottom: 16px !important;
      max-width: 100% !important;
    }

    .os-container[style*="justify-content: space-between"] > div:first-child > div:last-child {
      display: grid !important;
      grid-template-columns: 1fr;
      gap: 8px !important;
      font-size: 0.8rem !important;
    }

    .os-container[style*="justify-content: space-between"] > div:last-child {
      width: 100%;
      gap: 16px !important;
    }

    .os-container[style*="justify-content: space-between"] > div:last-child > div:first-child {
      display: grid !important;
      grid-template-columns: 1fr;
      width: 100%;
      gap: 12px;
    }

    .os-container[style*="justify-content: space-between"] > div:last-child > div:first-child > a {
      width: 100%;
      justify-content: center;
      padding: 14px 18px !important;
      font-size: 0.95rem !important;
    }

    .os-container[style*="justify-content: space-between"] > div:last-child > div:last-child {
      display: flex;
      align-items: center;
      width: 100%;
      justify-content: center;
      gap: 10px;
    }

    .os-container[style*="justify-content: space-between"] > div:last-child > div:last-child > div:first-child {
      transform: scale(0.9);
      margin-right: 0 !important;
    }

    .os-container[style*="justify-content: space-between"] > div:last-child > div:last-child > div:last-child {
      font-size: 0.78rem !important;
      line-height: 1.4;
      text-align: left;
    }
  }

  /* Premium Trust Item Hover Physics */
  .os-trust-item {
    display: flex;
    gap: 16px;
    padding: 16px;
    border-radius: 16px;
    margin: -16px; /* Offset padding to keep layout stable */
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: default;
  }
  .os-trust-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-blue-tint);
    color: var(--blue-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }
  .os-trust-item h4 {
    color: var(--text-primary) !important;
  }
  .os-trust-item p {
    color: var(--text-secondary) !important;
  }
  .os-trust-item:hover {
    background: rgba(255, 131, 218, 0.05);
    transform: translateY(-4px);
  }
  .os-trust-item:hover .os-trust-icon {
    transform: scale(1.15) rotate(5deg);
    background: var(--blue-primary);
    color: #ffffff;
    box-shadow: 0 8px 16px rgba(255, 131, 218, 0.4);
  }
  .os-marquee-track {
    animation: scroll-left 25s linear infinite;
  }
  .os-trust-marquee:hover .os-marquee-track {
    animation-play-state: paused;
  }
  @keyframes scroll-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-50% - 24px)); }
  }
</style>
