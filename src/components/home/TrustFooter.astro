---
// TrustFooter.astro
import RibbonBackground from "~/components/shared/RibbonBackground.astro";
---
<section class="os-section os-reveal" style="padding: 48px 0 0; background: #ffffff; position: relative; overflow: hidden;">
  
  {/* Stripe Ribbon Canvas */}
  <RibbonBackground id="stripe-ribbon-trust" />

  <div class="os-container" style="position: relative; z-index: 1;">
    
    <div style="text-align: center; margin-bottom: 48px;">
      <div class="os-eyebrow" style="margin-bottom: 8px; color: var(--ink-secondary); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.85rem;">
        AI YOU CAN TRUST
      </div>
    </div>

    {/* Trust Grid and CTA Split */}
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 64px; align-items: start; margin-bottom: 100px;">
      
      {/* 5-item Grid */}
      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 32px; row-gap: 48px;">
        
        <div class="os-trust-item os-reveal">
          <div class="os-trust-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="3"></circle></svg>
          </div>
          <div>
            <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--ink-black); margin-bottom: 4px;">Full observability</h4>
            <p style="font-size: 0.85rem; color: var(--ink-secondary); line-height: 1.5; margin: 0;">See everything your AI employees do</p>
          </div>
        </div>

        <div class="os-trust-item os-reveal os-reveal-delay-1">
          <div class="os-trust-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <div>
            <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--ink-black); margin-bottom: 4px;">Human in the loop</h4>
            <p style="font-size: 0.85rem; color: var(--ink-secondary); line-height: 1.5; margin: 0;">You stay in control, always</p>
          </div>
        </div>

        <div class="os-trust-item os-reveal os-reveal-delay-2">
          <div class="os-trust-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
          </div>
          <div>
            <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--ink-black); margin-bottom: 4px;">Enterprise security</h4>
            <p style="font-size: 0.85rem; color: var(--ink-secondary); line-height: 1.5; margin: 0;">SOC 2, GDPR compliant, end-to-end encryption</p>
          </div>
        </div>

        <div class="os-trust-item os-reveal os-reveal-delay-3">
          <div class="os-trust-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z"></path><path d="M14 2v6h6"></path><path d="M16 13H8"></path><path d="M16 17H8"></path><path d="M10 9H8"></path></svg>
          </div>
          <div>
            <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--ink-black); margin-bottom: 4px;">Audit logs</h4>
            <p style="font-size: 0.85rem; color: var(--ink-secondary); line-height: 1.5; margin: 0;">Complete logs of every action and decision</p>
          </div>
        </div>

        <div class="os-trust-item os-reveal os-reveal-delay-4">
          <div class="os-trust-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <div>
            <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--ink-black); margin-bottom: 4px;">Data privacy</h4>
            <p style="font-size: 0.85rem; color: var(--ink-secondary); line-height: 1.5; margin: 0;">Your data is private and never shared</p>
          </div>
        </div>

      </div>

      {/* Right side CTA block */}
      <div class="os-tilt os-reveal os-reveal-delay-3" style="background: var(--bg-cream-alt); border-radius: 16px; padding: 32px; border: 1px solid var(--border-medium); cursor: pointer; backdrop-filter: blur(10px);">
        <h3 style="font-size: 1.5rem; font-weight: 800; color: var(--ink-black); margin-bottom: 12px; line-height: 1.2;">
          Ready to transform your business?
        </h3>
        <p style="font-size: 0.95rem; color: var(--ink-secondary); margin-bottom: 24px; line-height: 1.5;">
          Join thousands of companies already working with AI employees.
        </p>
        <a href="/signup" class="os-btn os-btn-primary os-magnetic" style="width: 100%; justify-content: center; padding: 14px 20px;">
          Build Your AI Workforce →
        </a>
      </div>

    </div>
  </div>

  {/* Massive Pink Footer Banner */}
  <div style="background: linear-gradient(135deg, var(--candy-pink), #a81c85); color: #ffffff; padding: 32px 0;">
    <div class="os-container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 48px;">
      
      <div>
        <div style="font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 12px; opacity: 0.9;">
          GET STARTED TODAY
        </div>
        <h2 style="font-size: 2.5rem; font-weight: 800; color: #ffffff; margin-bottom: 24px; max-width: 500px; line-height: 1.1; letter-spacing: -0.02em;">
          Build your AI workforce in minutes, not months.
        </h2>
        
        <div style="display: flex; gap: 24px; align-items: center; font-size: 0.85rem; font-weight: 600; opacity: 0.9;">
          <div style="display: flex; align-items: center; gap: 6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"></path></svg>
            No credit card
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"></path></svg>
            14-day free trial
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"></path></svg>
            Cancel anytime
          </div>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 24px;">
        <div style="display: flex; gap: 16px;">
          <a href="/signup" style="background: #ffffff; color: var(--candy-pink); padding: 16px 28px; border-radius: var(--radius-pill); font-weight: 700; text-decoration: none; font-size: 1rem; transition: transform 0.2s ease;">
            Start Free Trial →
          </a>
          <a href="/demo" style="background: rgba(255,255,255,0.15); color: #ffffff; border: 1px solid rgba(255,255,255,0.3); padding: 16px 28px; border-radius: var(--radius-pill); font-weight: 700; text-decoration: none; font-size: 1rem; transition: background 0.2s ease;">
            Schedule Demo
          </a>
        </div>
        
        <div style="display: flex; align-items: center; gap: 12px;">
          {/* Avatar Stack */}
          <div style="display: flex; margin-right: 8px;">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #ddd; border: 2px solid #a81c85; margin-left: -10px; position: relative; z-index: 4; background-image: url('https://i.pravatar.cc/100?img=1'); background-size: cover;"></div>
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #ddd; border: 2px solid #a81c85; margin-left: -10px; position: relative; z-index: 3; background-image: url('https://i.pravatar.cc/100?img=2'); background-size: cover;"></div>
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #ddd; border: 2px solid #a81c85; margin-left: -10px; position: relative; z-index: 2; background-image: url('https://i.pravatar.cc/100?img=3'); background-size: cover;"></div>
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #ddd; border: 2px solid #a81c85; margin-left: -10px; position: relative; z-index: 1; background-image: url('https://i.pravatar.cc/100?img=4'); background-size: cover;"></div>
          </div>
          <div style="font-size: 0.85rem; font-weight: 500; opacity: 0.9;">
            Trusted by 10,000+ businesses worldwide
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @media (max-width: 960px) {
    section > div > div[style*="grid-template-columns: 2fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
    section > div > div > div[style*="grid-template-columns: 1fr 1fr 1fr"] {
      grid-template-columns: 1fr 1fr !important;
    }
    .os-container[style*="justify-content: space-between"] {
      flex-direction: column;
      align-items: flex-start !important;
    }
    .os-container[style*="justify-content: space-between"] > div:last-child {
      align-items: flex-start !important;
    }
  }

  /* Premium Trust Item Hover Physics */
  .os-trust-item {
    display: flex;
    gap: 16px;
    padding: 16px;
    border-radius: 16px;
    margin: -16px; /* Offset padding to keep layout stable */
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: default;
  }
  .os-trust-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--candy-pink-soft);
    color: var(--candy-pink);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }
  .os-trust-item h4 {
    color: var(--ink-black) !important;
  }
  .os-trust-item p {
    color: var(--ink-secondary) !important;
  }
  .os-trust-item:hover {
    background: rgba(255, 131, 218, 0.05);
    transform: translateY(-4px);
  }
  .os-trust-item:hover .os-trust-icon {
    transform: scale(1.15) rotate(5deg);
    background: var(--candy-pink);
    color: #ffffff;
    box-shadow: 0 8px 16px rgba(255, 131, 218, 0.4);
  }
</style>
