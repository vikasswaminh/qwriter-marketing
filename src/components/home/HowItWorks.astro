---
// HowItWorks.astro
---
<section class="os-section os-reveal" style="padding: 64px 0 24px; background: #ffffff;">
  <div class="os-container" style="max-width: 1200px; margin: 0 auto; padding: 0 24px;">
    
    <div class="hiw-grid">
      
      {/* Left Column */}
      <div class="hiw-left">
        <div class="os-eyebrow" style="margin-bottom: 12px; color: #e04f33; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.65rem;">
          HOW AN AI EMPLOYEE WORKS
        </div>
        <h2 style="font-size: 2.4rem; font-weight: 800; color: var(--text-primary); line-height: 1.1; margin-bottom: 16px; letter-spacing: -0.02em;">
          How an AI<br/>employee<br/>works.
        </h2>
        <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 24px; max-width: 360px; line-height: 1.5;">
          See how an AI employee turns a goal into audited execution.
        </p>
        <a href="/ai-employees" style="background: #ffffff; color: var(--text-primary); font-size: 0.85rem; font-weight: 700; padding: 10px 16px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s ease; border: 1px solid var(--border-medium);">
          Explore AI Employees <span>&rarr;</span>
        </a>
      </div>

      {/* Center Column: Robot Image */}
      <div class="hiw-center" style="display: flex; align-items: center; justify-content: center;">
        <img src="/images/how-it-works-center.jpg" alt="AI Robot" style="width: 100%; max-width: 480px; display: block; mix-blend-mode: multiply;" />
      </div>

      {/* Right Column */}
      <div class="hiw-right">
        
        {/* Step 1 */}
        <div class="hiw-card active">
          <div class="hiw-card-header">
            <span class="hiw-num">01.</span>
            <h3 class="hiw-title">Understand</h3>
          </div>
          <div class="hiw-card-body">
            <p>Your goal and requirements</p>
          </div>
        </div>

        {/* Step 2 */}
        <div class="hiw-card">
          <div class="hiw-card-header">
            <span class="hiw-num">02.</span>
            <h3 class="hiw-title">Plan</h3>
          </div>
          <div class="hiw-card-body">
            <p>Creates a plan and chooses the best tools</p>
          </div>
        </div>

        {/* Step 3 */}
        <div class="hiw-card">
          <div class="hiw-card-header">
            <span class="hiw-num">03.</span>
            <h3 class="hiw-title">Execute</h3>
          </div>
          <div class="hiw-card-body">
            <p>Takes action using trusted tools</p>
          </div>
        </div>

        {/* Step 4 */}
        <div class="hiw-card">
          <div class="hiw-card-header">
            <span class="hiw-num">04.</span>
            <h3 class="hiw-title">Deliver</h3>
          </div>
          <div class="hiw-card-body">
            <p>Delivers results with full transparency</p>
          </div>
        </div>

        {/* Step 5 */}
        <div class="hiw-card">
          <div class="hiw-card-header">
            <span class="hiw-num">05.</span>
            <h3 class="hiw-title">Improve</h3>
          </div>
          <div class="hiw-card-body">
            <p>Learns and improves over time</p>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style is:global>
  .hiw-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr;
    gap: 32px;
    align-items: flex-start;
  }

  .hiw-left {
    padding-right: 16px;
    position: sticky;
    top: 60px;
  }

  .hiw-right {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hiw-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 16px 20px;
    border: 1px solid var(--border-light);
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
  }

  .hiw-card.active {
    border-color: #3b82f6;
  }

  .hiw-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
  }

  .hiw-num {
    font-family: monospace;
    font-size: 0.9rem;
    font-weight: 700;
    color: #999;
    letter-spacing: 0.05em;
  }

  .hiw-card.active .hiw-num {
    color: #e04f33;
  }

  .hiw-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    line-height: 1;
  }

  .hiw-card-body {
    display: none;
    margin-top: 0;
    padding-left: 12px;
  }
  
  .hiw-card-body p {
    font-size: 0.85rem;
    color: #6b6a65;
    line-height: 1.5;
    margin: 0;
  }

  .hiw-card.active .hiw-card-body {
    display: block;
    animation: fadeIn 0.3s ease forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 900px) {
    .hiw-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .hiw-left {
      padding-right: 0;
      position: static;
      text-align: center;
    }
    .hiw-left p {
      margin: 0 auto 24px;
    }
    .hiw-left h2 {
      font-size: 2rem;
    }
  }
</style>

<script>
  const cards = document.querySelectorAll('.hiw-card');
  
  cards.forEach(card => {
    card.addEventListener('mouseenter', () => {
      // Remove active class from all
      cards.forEach(c => {
        c.classList.remove('active');
      });
      
      // Add active class to hovered card
      card.classList.add('active');
    });
  });
</script>
