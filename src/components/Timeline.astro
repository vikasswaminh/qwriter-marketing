---
// Vertical numbered timeline with a 2px accent rail and pill nodes.
// Used in /how-it-works and any "5 step" sections that used to be wide rows.
export interface Step { n: string; t: string; d: string; }
export interface Props { steps: Step[]; accent?: string; }
const { steps, accent = "var(--accent)" } = Astro.props as Props;
---
<ol style="list-style: none; padding: 0; margin: 0; position: relative;">
  {/* the accent rail */}
  <div style={`position: absolute; left: 11px; top: 8px; bottom: 8px; width: 2px; background: ${accent}; opacity: 0.18;`}></div>

  {steps.map(s => (
    <li style="position: relative; padding: 14px 0 14px 40px; border-bottom: 1px solid var(--rule);">
      {/* node */}
      <div style={`position: absolute; left: 0; top: 14px; width: 24px; height: 24px; border-radius: 999px; background: ${accent}; color: #fff; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-weight: 700; font-size: 10.5px;`}>{s.n}</div>
      <div style="font-weight: 900; font-size: 16px; letter-spacing: -0.015em; line-height: 1.25;">{s.t}</div>
      <div style="margin-top: 4px; font-size: 13px; line-height: 1.5; color: var(--ink-3); max-width: 580px;">{s.d}</div>
    </li>
  ))}
</ol>
