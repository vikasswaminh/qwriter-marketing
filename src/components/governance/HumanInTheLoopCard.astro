---
---

<section class="os-section os-reveal" style="padding: 48px 0; background: var(--bg-soft);">
  <div class="os-container">
    <div style="display: grid; grid-template-columns: 1fr 1.1fr; gap: 48px; align-items: center;">
      
      {/* Left Text */}
      <div>
        <div class="os-eyebrow">
          <span class="os-live-dot amber"></span> HUMAN-IN-THE-LOOP GOVERNANCE
        </div>
        <h2 class="os-h2" style="margin: 12px 0 20px;">
          You stay in control of every high-impact action.
        </h2>
        <p class="os-lead" style="margin-bottom: 24px;">
          Eliminate AI risk. Configure granular permission gates so AI employees can autonomously research and draft, while requiring human 1-click approval before sending emails, publishing content, or executing financial transactions.
        </p>

        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="display: flex; gap: 12px; align-items: flex-start;">
            <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--status-green-bg); color: var(--status-green); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; flex-shrink: 0;">✓</div>
            <div>
              <div style="font-weight: 600; color: var(--text-primary); font-size: 14px;">Read-Only Autonomy</div>
              <div style="font-size: 13px; color: var(--text-muted);">Audits, scraping, and log diagnostics run 24/7 without interruption.</div>
            </div>
          </div>

          <div style="display: flex; gap: 12px; align-items: flex-start;">
            <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--bg-blue-tint); color: #a81c85; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; flex-shrink: 0;">⚡</div>
            <div>
              <div style="font-weight: 600; color: var(--text-primary); font-size: 14px;">Interactive Sign-Off Cards</div>
              <div style="font-size: 13px; color: var(--text-muted);">Approve or reject queued actions directly inside Slack, Email, or the OllaSuper Dashboard.</div>
            </div>
          </div>

          <div style="display: flex; gap: 12px; align-items: flex-start;">
            <div style="width: 24px; height: 24px; border-radius: 50%; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; flex-shrink: 0;">🔒</div>
            <div>
              <div style="font-weight: 600; color: var(--text-primary); font-size: 14px;">Cryptographic Audit Trail</div>
              <div style="font-size: 13px; color: var(--text-muted);">Every approval and rejection is immutably timestamped for enterprise compliance.</div>
            </div>
          </div>
        </div>
      </div>

      {/* Right: Interactive Human in the Loop Card Mockup */}
      <div style="background: #ffffff; border: 1px solid var(--border-medium); border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); padding: 28px;">
        <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 16px; border-bottom: 1px solid var(--border-light); margin-bottom: 20px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--status-amber);"></div>
            <span style="font-size: 13px; font-weight: 700; color: var(--text-primary);">Awaiting Human Sign-Off</span>
          </div>
          <span class="os-badge os-badge-pink" style="font-size: 11px;">Slack #revenue-ops</span>
        </div>

        {/* Action Details */}
        <div style="background: var(--bg-blue-tint); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 18px; margin-bottom: 20px;">
          <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">Requested Action</div>
          <div style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">
            Send outbound email sequence to 450 verified VP Engineering leads?
          </div>
          <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 12px;">
            Generated by <strong>Sales Employee</strong>. Verified with 100% brand voice compliance. All prospects matched ICP criteria (US-based, 50-200 employees, series B+).
          </p>
          
          <div style="display: flex; gap: 16px; font-size: 12px; color: var(--text-muted); border-top: 1px solid var(--border-light); padding-top: 10px;">
            <span>Target: <strong>Salesforce / Outreach</strong></span>
            <span>Risk Tier: <strong>Medium (Outreach Write)</strong></span>
          </div>
        </div>

        {/* Interactive Approve / Reject Simulation */}
        <div id="os-approval-actions" style="display: flex; gap: 12px;">
          <button id="os-btn-approve" class="os-btn os-btn-primary" style="flex: 1; padding: 12px;">
            ✓ Approve & Execute (450)
          </button>
          <button id="os-btn-reject" class="os-btn os-btn-secondary" style="flex: 1; padding: 12px; color: var(--status-red); border-color: rgba(220, 38, 38, 0.3);">
            ✕ Reject Action
          </button>
        </div>

        {/* Interactive Feedback State */}
        <div id="os-approval-feedback" style="display: none; padding: 14px; border-radius: var(--radius-md); font-size: 13px; text-align: center; font-weight: 600;">
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  @media (max-width: 900px) {
    section div[style*="grid-template-columns: 1fr 1.1fr"] {
      grid-template-columns: 1fr !important;
    }

    .os-section {
      padding-top: 32px !important;
      padding-bottom: 32px !important;
    }

    .os-section .os-container {
      padding-left: 14px !important;
      padding-right: 14px !important;
    }

    .os-section h2.os-h2 {
      font-size: clamp(2rem, 8vw, 2.8rem) !important;
      line-height: 1.12 !important;
      margin-bottom: 16px !important;
    }

    .os-section .os-lead {
      font-size: 0.98rem !important;
      line-height: 1.55 !important;
    }

    .os-section .os-container > div[style*="display: grid; grid-template-columns: 1fr 1.1fr"] {
      display: flex !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      gap: 16px !important;
      padding-bottom: 8px;
      scrollbar-width: auto;
      -ms-overflow-style: auto;
    }

    .os-section .os-container > div[style*="display: grid; grid-template-columns: 1fr 1.1fr"]::-webkit-scrollbar {
      height: 8px;
      background: rgba(148, 163, 184, 0.12);
      border-radius: 999px;
    }

    .os-section .os-container > div[style*="display: grid; grid-template-columns: 1fr 1.1fr"]::-webkit-scrollbar-thumb {
      background: rgba(59, 130, 246, 0.7);
      border-radius: 999px;
    }

    .os-section .os-container > div[style*="display: grid; grid-template-columns: 1fr 1.1fr"] > div {
      flex: 0 0 86vw !important;
      min-width: 280px !important;
      scroll-snap-align: start;
    }

    .os-section .os-container > div[style*="display: grid; grid-template-columns: 1fr 1.1fr"] > div:first-child {
      padding-right: 4px;
    }

    .os-section .os-container > div[style*="display: grid; grid-template-columns: 1fr 1.1fr"] > div:last-child {
      padding: 18px !important;
    }

    .os-section .os-container > div[style*="display: grid; grid-template-columns: 1fr 1.1fr"] > div:last-child > div:first-child {
      gap: 8px !important;
    }

    .os-section .os-container > div[style*="display: grid; grid-template-columns: 1fr 1.1fr"] > div:last-child > div:first-child > div:first-child {
      width: 9px !important;
      height: 9px !important;
    }

    .os-section .os-container > div[style*="display: grid; grid-template-columns: 1fr 1.1fr"] > div:last-child > div#os-approval-actions {
      flex-direction: column !important;
      gap: 10px !important;
    }

    .os-section .os-container > div[style*="display: grid; grid-template-columns: 1fr 1.1fr"] > div:last-child .os-btn {
      width: 100%;
      min-width: 0;
    }
  }
</style>

<script>
  const btnApprove = document.getElementById('os-btn-approve');
  const btnReject = document.getElementById('os-btn-reject');
  const actionContainer = document.getElementById('os-approval-actions');
  const feedback = document.getElementById('os-approval-feedback');

  if (btnApprove && btnReject && actionContainer && feedback) {
    btnApprove.addEventListener('click', () => {
      actionContainer.style.display = 'none';
      feedback.style.display = 'block';
      feedback.style.background = 'var(--status-green-bg)';
      feedback.style.color = 'var(--status-green)';
      feedback.style.border = '1px solid rgba(22, 163, 74, 0.3)';
      feedback.innerHTML = '✓ Approved by User! 450 emails dispatched to Salesforce queue. Trace ID: tr_8491.';
    });

    btnReject.addEventListener('click', () => {
      actionContainer.style.display = 'none';
      feedback.style.display = 'block';
      feedback.style.background = 'var(--status-red-bg)';
      feedback.style.color = 'var(--status-red)';
      feedback.style.border = '1px solid rgba(220, 38, 38, 0.3)';
      feedback.innerHTML = '✕ Action Rejected. The AI employee was instructed to revise parameters and re-queue.';
    });
  }
</script>
